#!/usr/bin/env bash
# status — the dashboard's panels as plain text: what make status prints.
#
# This is mrk-status --plain, run from this checkout. Until 2026-09-30 it was a
# second implementation of the same checks in bash, and the two kept drifting
# apart: each had fixes the other lacked (f1477a9 is one of the times they were
# reconciled). There is now one set of checks, in tools/mrk-status.
#
# Not linked into ~/bin: ~/bin/status is the dashboard itself, which make
# mrk-status links there, and setup skips this file for that reason.
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
REPO_ROOT="$(cd "$(dirname "$_self")/.." && pwd)"

case "${1:-}" in
  -h|--help)
    cat <<'EOF'
status — print mrk-status's panels as plain text

Usage:
  status [--help | -h]

Runs this checkout's bin/mrk-status --plain, reporting on this checkout
unless MRK_ROOT names another. Unrecorded, Upkeep, Time Machine Backups and
Installation, each line with its fix. The dashboard itself is `status` on the
PATH, or `mrk-status`.
EOF
    exit 0 ;;
  ?*) printf 'status: unknown argument: %s\n' "$1" >&2; exit 2 ;;
esac

bin="$REPO_ROOT/bin/mrk-status"
if [[ ! -x "$bin" ]]; then
  printf 'status: %s is not built. Build it with: make -C %s build-tools\n' "$bin" "$REPO_ROOT" >&2
  exit 1
fi
MRK_ROOT="${MRK_ROOT:-$REPO_ROOT}" exec "$bin" --plain
