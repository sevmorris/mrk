#!/usr/bin/env bash
set -euo pipefail

# mrk installer — unified macOS bootstrap
#
# Usage:
#   scripts/install              # Phase 1 only (setup: dotfiles, tools, defaults)
#   scripts/install --brew       # Phase 2 (Homebrew packages)
#   scripts/install --post       # Phase 3 (app config, login items)
#   scripts/install --all        # make all: fix-exec, all three phases, the TUIs
#
# All other flags are passed through to the relevant phase script.

# Resolve symlinks so this works when called via ~/bin
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source shared helpers
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

check_macos

# Parse top-level flag
PHASE=""
PASSTHROUGH=()

for arg in "$@"; do
  case "$arg" in
    --brew)  PHASE="brew" ;;
    --post)  PHASE="post" ;;
    --all)   PHASE="all" ;;
    -h|--help)
      cat <<'USAGE'
mrk installer — unified macOS bootstrap

Usage: scripts/install [phase] [options]

Phases:
  (default)     Phase 1: setup (dotfiles, tools, defaults, shell)
  --brew        Phase 2: Homebrew packages
  --post        Phase 3: app config, login items
  --all         Everything make all does: fix-exec, the three phases,
                the TUI tools, and the closing notes

All other flags are passed through to the relevant phase script, and with
--all to all three.
Run scripts/setup --help or scripts/brew --help for phase-specific options.
USAGE
      exit 0
      ;;
    *)  PASSTHROUGH+=("$arg") ;;
  esac
done

case "${PHASE:-setup}" in
  setup)
    exec "$SCRIPT_DIR/setup" "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"
    ;;
  brew)
    exec "$SCRIPT_DIR/brew" "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"
    ;;
  post)
    exec "$SCRIPT_DIR/post-install" "${PASSTHROUGH[@]+"${PASSTHROUGH[@]}"}"
    ;;
  all)
    # One route to a full install, not two. This arm used to run setup, brew and
    # post-install itself, and so did less than `make all`: no fix-exec first, no
    # TUI build after, and none of the closing notes (exec zsh, the mrk-prefs
    # hint, the App Store apps). Found on 2026-09-18 by putting the two side by
    # side. It now runs make all, so a full install has one definition, in the
    # Makefile.
    #
    # make needs the Command Line Tools, and /usr/bin/make is a stub that offers
    # to install them rather than failing. Phase 1 is what installs them, so
    # without them this points there instead.
    if ! xcode-select -p >/dev/null 2>&1; then
      err "A full install runs make all, and make needs the Xcode Command Line Tools."
      info "Run mrk-install on its own first: Phase 1 installs them. Then run mrk-install --all."
      exit 1
    fi
    make_args=(--no-print-directory -C "$REPO_ROOT" all)
    if (( ${#PASSTHROUGH[@]} > 0 )); then
      make_args+=("ARGS=${PASSTHROUGH[*]}")
    fi
    exec make "${make_args[@]}"
    ;;
esac
