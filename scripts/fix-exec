#!/usr/bin/env bash
# fix-exec — set executable bits on repo scripts and ~/bin (idempotent)

set -euo pipefail

# Resolve repo paths, following symlinks (works when called via ~/bin)
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
BASE_DIR="$(cd "$(dirname "$_self")" && pwd)"
PROJECT_ROOT="$(dirname "$BASE_DIR")"

echo "🔧 Ensuring executable bits on mrk scripts…"

# Fix repo scripts and bin directories directly.
# lib.sh is excluded: it is a sourced library, it says so in its own header, and
# it has no shebang-driven entry point. bin/lib/common.sh is already outside the
# -maxdepth 1 scan and is tracked 644; this keeps the two libraries consistent.
for dir in "$PROJECT_ROOT/scripts" "$PROJECT_ROOT/bin"; do
  if [ -d "$dir" ]; then
    find "$dir" -maxdepth 1 -type f ! -name 'lib.sh' -print0 2>/dev/null \
      | xargs -0 chmod +x 2>/dev/null || true
    echo "✓ Fixed executables in: $dir"
  fi
done

# In ~/bin, only touch symlinks that point back into this repo.
#
# Two jobs. Set the executable bit on the live ones, and delete the dead ones:
# nothing else prunes them, so every script removed from the repo left a
# dangling link in ~/bin forever. Removing adventure mode is what surfaced it —
# ~/bin/adventure-prologue outlived scripts/adventure-prologue.
#
# The delete is deliberately narrow. A link is removed only when it points
# INSIDE this repo and its target is gone, so a link to anywhere else, and a
# real file of the same name, are both left alone.
if [ -d "$HOME/bin" ]; then
  fixed=0
  pruned=0
  while IFS= read -r -d '' link; do
    target="$(readlink "$link" 2>/dev/null || true)"
    case "$target" in
      "$PROJECT_ROOT"/*) ;;
      *) continue ;;
    esac
    if [ -e "$target" ]; then
      chmod +x "$link" 2>/dev/null || true
      fixed=$((fixed + 1))
    else
      rm -f "$link"
      echo "  ✂ pruned dead link: $(basename "$link") -> ${target#"$PROJECT_ROOT"/}"
      pruned=$((pruned + 1))
    fi
  done < <(find "$HOME/bin" -maxdepth 1 -type l -print0 2>/dev/null || true)
  echo "✓ Fixed $fixed mrk symlink(s) in: $HOME/bin"
  [ "$pruned" -gt 0 ] && echo "✓ Pruned $pruned dead link(s)"
fi

echo "✅ Done."
