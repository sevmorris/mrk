#!/usr/bin/env bash

# Re-exec with Homebrew bash if running under bash < 4 (macOS ships bash 3.2)
if (( BASH_VERSINFO[0] < 4 )); then
  for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_brew_bash" ]] && exec "$_brew_bash" "$0" "$@"
  done
  echo "error: bash 4+ required (system bash is ${BASH_VERSION}; install via 'brew install bash')" >&2
  exit 1
fi

set -euo pipefail

# mrk sync-login-items — diff system login items against config/login-items.txt
# and update repo

# Resolve symlinks so this works when called via ~/bin
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

check_macos

DRY_RUN=0
COMMIT=0
CHECK=0
MANUAL=0   # --manual: only bring the manual's sentence in step (section 1c)

# One decision made on the command line in place of gum and the y/N prompts,
# for a program with no terminal to show them on (the Settings app). DECIDE is
# add, ignore or remove. Each decision fills the variables the selection would
# have filled, and the same code as an interactive run then writes
# config/login-items.txt, the manual and the ignore list, so the two cannot
# write or refuse an item differently. Modelled on sync's --add, --ignore and
# --prune.
DECIDE=""
DECIDE_NAME=""

usage_error() { err "$*"; info "Run sync-login-items --help for the options."; exit 2; }

decide() {
  [[ -z "$DECIDE" ]] || usage_error "Give one decision per run: --add, --ignore or --remove with a name, once."
  DECIDE=$1
  DECIDE_NAME=$2
}

while (("$#")); do
  case "$1" in
    --dry-run|-n) DRY_RUN=1 ;;
    --commit|-c)  COMMIT=1 ;;
    --check)      CHECK=1 ;;
    --manual)     MANUAL=1 ;;
    --add|--ignore|--remove)
      # An app name does not start with a dash, so the next option is never
      # taken for one.
      (( $# > 1 )) && [[ "$2" != -* ]] || usage_error "$1 needs a login-item name."
      decide "${1#--}" "$2"; shift
      ;;
    -h|--help)
      cat <<'USAGE'
mrk sync-login-items — diff system login items against config/login-items.txt and update repo

Usage: scripts/sync-login-items [options]
  --dry-run, -n   Show what would change without modifying files
  --commit, -c    Auto-commit changes after updating
  --check         Print what an interactive run would offer, one line each,
                  tab-separated: add or remove, the name, the path, and why
                  (new, stale or ignored). Nothing else on stdout, nothing
                  changed, no prompt. Exits 0 when it could tell, 1 when
                  System Events gave no login items. Takes precedence over
                  the other options.
  --manual        Only make the login-items sentence in docs/manual.md list
                  the apps in config/login-items.txt, for a program that
                  changed the file. Reads no login items: no System Events,
                  no gum, no prompt. With -n it shows the change; with -c it
                  commits docs/manual.md alone. Exits 0 when the sentence
                  lists the apps, 1 when the file has a bad line or the
                  manual has no such sentence, 2 for a bad option.

A run that leaves config/login-items.txt as it is still makes the login-items
sentence in docs/manual.md list the tracked apps, so a hand edit of the file
leaves no stale sentence. -n and -c apply to it too. --check and a refused
decision write nothing.

One decision, made without gum or a prompt (for a program, such as the
Settings app). Each takes one item that --check lists, and refuses any other.
With -n it shows what it would do; with -c it commits what it changed.
  --add NAME      Track NAME, a login item on this Mac: add its path to
                  config/login-items.txt.
  --ignore NAME   Add NAME to ~/.mrk/login-items-ignore, so sync-login-items
                  stops offering it.
  --remove NAME   Stop tracking NAME: delete its line from
                  config/login-items.txt. NAME must not be a login item on
                  this Mac, or must be in the ignore list.
Exits 0 when done, 1 when sync-login-items refuses or System Events fails,
2 for a bad option.
USAGE
      exit 0
      ;;
    *) usage_error "Unknown option: $1" ;;
  esac
  shift
done

if [[ -n "$DECIDE" ]]; then
  # A name that could not come from System Events, or that would break a line
  # of the list or of the ignore file.
  [[ -n "${DECIDE_NAME//[[:space:]]/}" && "$DECIDE_NAME" != *[[:cntrl:]]* ]] \
    || usage_error "Not a login-item name: '$DECIDE_NAME'."
  (( ! MANUAL )) || usage_error "--manual makes no decision. Give it alone, or with -n and -c."
fi

REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly LOGIN_ITEMS="$REPO_ROOT/config/login-items.txt"
readonly MANUAL_MD="$REPO_ROOT/docs/manual.md"

# Temp files
TEMP_ADD=""
TEMP_REMOVE=""
TMP_LIST=""
TMP_MD=""
TMP_OSA_ERR=""
cleanup() {
  for _f in "$TEMP_ADD" "$TEMP_REMOVE" "$TMP_LIST" "$TMP_MD" "$TMP_OSA_ERR"; do
    [[ -n "$_f" && -f "$_f" ]] && rm -f "$_f" || true
  done
}
trap cleanup EXIT INT TERM

# ─── 1. Read tracked login items from config/login-items.txt ─────────────────

declare -A tracked_items=()  # name -> path, the path exactly as its line

# The list is plain lines: no quoting, so nothing to escape or unescape. Until
# 2026-10-19 it was add_login_item lines in post-install, and this read them
# back through a regex that had to undo the writer's shell escaping. The same
# reader as post-install's (mrk_config_entries), so the two cannot disagree
# about what the file tracks. A line that is not an app path, or a name listed
# twice, stops the run: the write below would keep the line, and every later
# run would offer the app again.
if [[ ! -r "$LOGIN_ITEMS" ]]; then
  err "Cannot read $LOGIN_ITEMS"
  exit 1
fi
tracked_rc=0
tracked_raw=$(mrk_config_entries "$LOGIN_ITEMS" | python3 -c '
import sys, unicodedata
seen, bad = set(), []
for path in sys.stdin.read().split("\n"):
    if not path:
        continue
    base = path.rsplit("/", 1)[-1]
    if not (path.startswith("/") and base.endswith(".app") and len(base) > 4) \
            or any(ord(c) < 32 for c in path):
        bad.append("Not an app path: " + path)
        continue
    name = unicodedata.normalize("NFC", base[:-4])
    if name in seen:
        bad.append(name + " is listed twice")
        continue
    seen.add(name)
    print(name + "\t" + path)
for b in bad:
    print(b, file=sys.stderr)
sys.exit(1 if bad else 0)
') || tracked_rc=$?
if (( tracked_rc != 0 )); then
  err "config/login-items.txt has a line that sync-login-items cannot use (see above)."
  info "Each line is the full path of one app, ending in .app, and each app is listed once."
  exit 1
fi
while IFS=$'\t' read -r app_name app_path; do
  [[ -n "$app_name" ]] && tracked_items["$app_name"]="$app_path"
done <<< "$tracked_raw"

# ─── 1b. The manual's sentence ───────────────────────────────────────────────
#
# Phase 3 in docs/manual.md names the tracked apps in one sentence, and
# tests/sync-login-items.sh fails when the two differ. A run that changes the
# list rewrites the sentence in section 9. A run that leaves the list as it is
# brings the sentence back in step (manual_in_step), so a hand edit of
# config/login-items.txt, or one by the Settings app, has a command that
# repairs the manual: --manual (section 1c), or any such run. Both go through
# write_manual.

# manual_items NAME... — the names sorted and joined with ", ", as the sentence
# lists them. `IFS=', '` would join on the first IFS character only, which
# produced an unreadable "A,B,C" run-on in the manual.
manual_items() {
  local sorted=() out=""
  if (( $# > 0 )); then
    mapfile -t sorted < <(printf '%s\n' "$@" | sort)
    out=$(printf '%s, ' "${sorted[@]}")
  fi
  printf '%s' "${out%, }"
}

# write_manual ITEMS — docs/manual.md with its sentence listing ITEMS, written
# to $TMP_MD. Sets MANUAL_STALE to 1 when that changes the sentence, else 0,
# and MANUAL_WAS to what the sentence lists now. Stops the run when the manual
# has no such sentence.
write_manual() {
  local out
  [[ -n "$TMP_MD" ]] || TMP_MD=$(mrk_mktemp)
  out=$(python3 - "$MANUAL_MD" "$1" "$TMP_MD" <<'PYEOF'
import sys, re
path, items, out_path = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    content = f.read()
# Must stay in step with the sentence in docs/manual.md. The prefix is the
# anchor and the list runs to the end of the line. If the manual is reworded,
# change it here too — the n_subs check below turns any drift into a hard error.
pattern = r'(- \*\*Login items:\*\* post-install adds these apps to the login items: )([^\n]*)'
new_content, n_subs = re.subn(pattern, lambda m: m.group(1) + items, content)
if n_subs == 0:
    print('Warning: could not locate login-items line in manual.md.', file=sys.stderr)
    sys.exit(1)
with open(out_path, 'w') as f:
    f.write(new_content)
was = re.search(pattern, content).group(2)
print(('1' if new_content != content else '0') + '\t' + was, end='')
PYEOF
) || exit 1
  MANUAL_STALE=${out%%$'\t'*}
  MANUAL_WAS=${out#*$'\t'}
}

# manual_in_step — at an exit that leaves config/login-items.txt as it is, make
# the sentence list the tracked apps, and say so. Silent when it already does.
# With -n it says what it would change; with -c it commits docs/manual.md
# alone, and nothing else that is staged.
manual_in_step() {
  local items msg="login-items: list the tracked apps in the manual"
  items=$(manual_items "${!tracked_items[@]}")
  write_manual "$items"
  (( MANUAL_STALE )) || return 0

  if (( DRY_RUN )); then
    dry "docs/manual.md lists these login items: $MANUAL_WAS"
    dry "Would change it to list the tracked apps: $items"
    return 0
  fi
  # mktemp creates 0600, so restore the expected mode before the swap.
  chmod 644 "$TMP_MD"
  mv "$TMP_MD" "$MANUAL_MD"
  log "Updated docs/manual.md to list the tracked apps: $items"

  (( COMMIT )) || return 0
  cd "$REPO_ROOT"
  if git diff --quiet HEAD -- "$MANUAL_MD" 2>/dev/null; then
    log "No changes to commit."
    return 0
  fi
  git commit -m "$msg" -- "$MANUAL_MD"
  log "Committed: $msg"
}

# ─── 1c. --manual ────────────────────────────────────────────────────────────
#
# The sentence depends on config/login-items.txt alone, so --manual stops here,
# before the ignore list and System Events. A program that has just changed
# the file repairs the manual with it, with no decision to make: a plain run
# starts gum or a y/N prompt whenever System Events has an item to offer, and
# a decision repairs the sentence only as a side effect. --check still takes
# precedence, as it does over every other option.

if (( MANUAL && ! CHECK )); then
  manual_in_step
  (( MANUAL_STALE )) || log "docs/manual.md already lists the tracked apps."
  exit 0
fi

# ─── Load persistent ignore list ─────────────────────────────────────────────
#
# Format of ~/.mrk/login-items-ignore:
#   one login-item name per line (the app name, without the .app suffix)
#   lines starting with # are ignored
#   example:
#     NordPass
#     Chrono Plus
#
# The file is created when the user accepts the offer to ignore a declined
# item (section 5b), or by --ignore NAME, and can also be written by hand.
#
# This mirrors ~/.mrk/sync-ignore ("Load persistent ignore list" in
# scripts/sync) in format, load and match, with one deliberate difference: sync
# strips *all* whitespace from a rule, which is right for Brewfile tokens but
# would turn "Chrono Plus" into "ChronoPlus" and never match. Login-item names
# are app names and contain interior spaces, so only leading and trailing
# whitespace is stripped here.

_LOGIN_ITEM_IGNORE=()
if [[ -f "${STATE_DIR}/login-items-ignore" ]]; then
  while IFS= read -r _line || [[ -n "$_line" ]]; do
    _line="${_line%%#*}"                           # strip inline comments
    _line="${_line#"${_line%%[![:space:]]*}"}"     # strip leading whitespace
    _line="${_line%"${_line##*[![:space:]]}"}"     # strip trailing whitespace
    [[ -n "$_line" ]] && _LOGIN_ITEM_IGNORE+=("$_line")
  done < "${STATE_DIR}/login-items-ignore"
  if (( ${#_LOGIN_ITEM_IGNORE[@]} > 0 )); then
    log "Loaded ${#_LOGIN_ITEM_IGNORE[@]} ignore rule(s) from ~/.mrk/login-items-ignore"
  fi
fi

_login_item_ignored() {
  local _name="$1"
  local _item
  for _item in "${_LOGIN_ITEM_IGNORE[@]}"; do
    [[ "$_item" == "$_name" ]] && return 0
  done
  return 1
}

# Append one name to the ignore file, and create the file if it is absent.
# Append-only: existing lines are never rewritten or reordered. The name goes
# in verbatim, interior spaces intact, because the loader trims only the ends.
_append_login_item_ignore() {
  local _name="$1"
  local _f="${STATE_DIR}/login-items-ignore"

  if [[ ! -f "$_f" ]]; then
    mkdir -p "$STATE_DIR"
    cat > "$_f" <<'IGNOREHEADER'
# mrk login-items ignore list
#
# One login-item name per line: the app name, without the .app suffix.
# A # character starts a comment. Leading and trailing spaces are trimmed,
# so a name with interior spaces (for example: Chrono Plus) works as written.
#
# sync-login-items drops these names, so it never offers them as new items.
IGNOREHEADER
  fi

  # A file whose last line has no newline would otherwise absorb the append.
  # The loader tolerates a missing final newline, so this state is reachable.
  if [[ -s "$_f" && -n "$(tail -c 1 "$_f")" ]]; then
    printf '\n' >> "$_f"
  fi

  printf '%s\n' "$_name" >> "$_f"
  _LOGIN_ITEM_IGNORE+=("$_name")   # keep the in-memory list authoritative
}

# ─── 2. Get system login items (name -> path) ────────────────────────────────

log "Reading system login items..."

declare -A system_items=()

# Single System Events query returning "name<TAB>path" pairs, one per line.
# The old comma-split name list broke on names containing commas, and the
# per-name path lookup guessed /Applications/$name.app when it failed.
TMP_OSA_ERR="$(mrk_mktemp)"
osa_rc=0
raw_items=$(
  osascript 2>"$TMP_OSA_ERR" <<'OSASCRIPT'
tell application "System Events"
  set output to ""
  repeat with li in login items
    try
      set output to output & (name of li) & tab & (path of li) & linefeed
    end try
  end repeat
  return output
end tell
OSASCRIPT
) || osa_rc=$?

# A failed or empty read must never reach the diff. Every tracked item would
# be absent from an empty system_items, so section 3 would mark all of them
# stale and offer to delete every line of config/login-items.txt. A decision
# stops here too, so --remove cannot delete one on a failed read either.
# `scripts/sync` aborts on the equivalent brew-list failure; do the same here.
if (( osa_rc != 0 )); then
  err "Could not read system login items — osascript exited $osa_rc."
  [[ -s "$TMP_OSA_ERR" ]] && info "$(head -3 "$TMP_OSA_ERR")"
  info "System Events may be unavailable, or Automation access may be denied"
  info "(System Settings → Privacy & Security → Automation)."
  exit 1
fi

if [[ -z "${raw_items//[[:space:]]/}" ]]; then
  err "System Events returned no login items."
  info "'You have zero login items' and 'the read failed' are indistinguishable"
  info "here, so this aborts rather than offering to delete every tracked item."
  info "If the list really is empty, edit config/login-items.txt by hand."
  exit 1
fi

# Names are compared in Unicode NFC, here and on the tracked side below. System
# Events and the file system need not spell an accented name the same way —
# one composed (é), one decomposed (e + combining accent) — and until
# 2026-09-18 such an app was listed as new and as stale on every run, under
# what looks like the same name twice. The path is kept exactly as given.
raw_items=$(printf '%s' "$raw_items" | python3 -c '
import sys, unicodedata
for line in sys.stdin.read().splitlines():
    name, tab, path = line.partition("\t")
    if tab:
        print(unicodedata.normalize("NFC", name) + "\t" + path)
')

while IFS=$'\t' read -r name app_path; do
  [[ -n "$name" && -n "$app_path" ]] && system_items["$name"]="$app_path"
done <<< "$raw_items"

# ─── 3. Compute diff ─────────────────────────────────────────────────────────

new_items_arr=()
stale_items_arr=()
ignored_arr=()
conflict_items_arr=()
not_wanted_arr=()
not_app_arr=()

# An app that MRK_NOT_AT_LOGIN (lib.sh) names must not open at login, so it is
# never offered for tracking. It is on the system only because it added itself
# again, and run_topgrade and post-install delete it.
_login_item_not_wanted() {
  local _item
  for _item in "${MRK_NOT_AT_LOGIN[@]}"; do
    [[ "$_item" == "$1" ]] && return 0
  done
  return 1
}

# The ignore list drops the ADD candidates only. A tracked item that is also
# ignored still counts as tracked, so the stale set below is untouched: an
# already-tracked item stays tracked until you delete it.
#
# config/login-items.txt holds only apps, so a login item whose path is not an
# app (a script, a folder) is not offered: its line would stop the next run.
for name in "${!system_items[@]}"; do
  [[ -z "${tracked_items[$name]+x}" ]] || continue
  if _login_item_not_wanted "$name"; then
    not_wanted_arr+=("$name")
    continue
  fi
  if _login_item_ignored "$name"; then
    ignored_arr+=("$name")
    continue
  fi
  if [[ "${system_items[$name]}" != /*.app ]]; then
    not_app_arr+=("$name")
    continue
  fi
  new_items_arr+=("$name")
done

for name in "${!tracked_items[@]}"; do
  [[ -z "${system_items[$name]+x}" ]] && stale_items_arr+=("$name")
done

# A name that is BOTH tracked and ignored is a contradiction: post-install
# still adds the app at install time, so the ignore rule does nothing for it.
# Surface it as its own set, because it is not stale — the app IS on the
# system — and reporting it under "not on system" would be false.
for name in "${!tracked_items[@]}"; do
  [[ -n "${system_items[$name]+x}" ]] || continue
  _login_item_ignored "$name" && conflict_items_arr+=("$name")
done

# Report the skips by name so it is transparent why an item is not offered.
# Sorted, because the loop above walks an associative array in hash order.
if (( ${#ignored_arr[@]} > 0 )); then
  while IFS= read -r name; do
    log "Ignoring $name per ~/.mrk/login-items-ignore"
  done < <(printf '%s\n' "${ignored_arr[@]}" | sort)
fi
if (( ${#not_wanted_arr[@]} > 0 )); then
  while IFS= read -r name; do
    log "Not offering $name: it must not open at login. make update and post-install delete it."
  done < <(printf '%s\n' "${not_wanted_arr[@]}" | sort)
fi
if (( ${#not_app_arr[@]} > 0 )); then
  while IFS= read -r name; do
    log "Not offering $name: its login item is not an app (${system_items[$name]})."
  done < <(printf '%s\n' "${not_app_arr[@]}" | sort)
fi

if (( ${#new_items_arr[@]} > 0 )); then
  mapfile -t new_items_arr < <(printf '%s\n' "${new_items_arr[@]}" | sort)
fi
if (( ${#stale_items_arr[@]} > 0 )); then
  mapfile -t stale_items_arr < <(printf '%s\n' "${stale_items_arr[@]}" | sort)
fi
if (( ${#conflict_items_arr[@]} > 0 )); then
  mapfile -t conflict_items_arr < <(printf '%s\n' "${conflict_items_arr[@]}" | sort)
fi

# ─── 3b. --check ─────────────────────────────────────────────────────────────
#
# What an interactive run would offer, from the same comparison, so a program
# and the selection cannot disagree. Four fields on every line, so a reader can
# split on tabs without counting: the action, the name, the path, and why.
#   add     NAME  PATH  new       a login item on this Mac, not tracked
#   remove  NAME  PATH  stale     tracked, not a login item on this Mac
#   remove  NAME  PATH  ignored   tracked, and in the ignore list
# For an add the path is the login item's; for a remove, the tracked line.

# check_line FIELD... — one --check line. A tab or a newline inside a field
# would split it, so each becomes a space.
check_line() {
  local out="" f sep=""
  for f in "$@"; do
    f="${f//$'\t'/ }"
    out+="$sep${f//$'\n'/ }"
    sep=$'\t'
  done
  printf '%s\n' "$out"
}

if (( CHECK )); then
  for name in ${new_items_arr[@]+"${new_items_arr[@]}"}; do
    check_line add "$name" "${system_items[$name]}" new
  done
  for name in ${stale_items_arr[@]+"${stale_items_arr[@]}"}; do
    check_line remove "$name" "${tracked_items[$name]}" stale
  done
  for name in ${conflict_items_arr[@]+"${conflict_items_arr[@]}"}; do
    check_line remove "$name" "${tracked_items[$name]}" ignored
  done
  exit 0
fi

# ─── 3c. Check a decision made on the command line ──────────────────────────
#
# A decision takes exactly what the selection would have offered: an add or an
# ignore, an item --check lists as add; a remove, one it lists as remove. So
# --add cannot track an app that must not open at login or one the ignore list
# names, and --remove cannot stop tracking an app that is still a login item
# here. Each refusal says why and changes nothing.

declare -A add_items=()
declare -A remove_items=()

_listed() {  # _listed NAME WORD... — whether NAME is one of the WORDs
  local want=$1 w
  shift
  for w in "$@"; do [[ "$w" == "$want" ]] && return 0; done
  return 1
}

refuse() { err "$*"; exit 1; }

if [[ -n "$DECIDE" ]]; then
  # The names above are in NFC; a program may pass the other spelling.
  n=$(python3 -c 'import sys, unicodedata; print(unicodedata.normalize("NFC", sys.argv[1]), end="")' "$DECIDE_NAME")

  case "$DECIDE" in
    add|ignore)
      # Ignoring a name the list already has is done, not refused: the run
      # that follows would not offer it either way.
      if [[ "$DECIDE" == ignore ]] && _login_item_ignored "$n"; then
        log "$n is already in ~/.mrk/login-items-ignore"
        manual_in_step
        exit 0
      fi
      if ! _listed "$n" ${new_items_arr[@]+"${new_items_arr[@]}"}; then
        # Why the selection would not have offered it, most telling reason first.
        if [[ -n "${tracked_items[$n]+x}" ]]; then
          refuse "config/login-items.txt already tracks $n."
        elif _login_item_not_wanted "$n"; then
          refuse "$n must not open at login, so sync-login-items never offers it. make update and post-install delete its login item."
        elif _login_item_ignored "$n"; then
          refuse "$n is in ~/.mrk/login-items-ignore, so sync-login-items does not offer it. Delete it from that file first."
        elif [[ -n "${system_items[$n]+x}" ]]; then
          refuse "The login item $n is not an app (${system_items[$n]}). config/login-items.txt holds only apps."
        else
          refuse "System Events does not list $n as a login item. Add it in System Settings → General → Login Items first."
        fi
      fi
      if [[ "$DECIDE" == ignore ]]; then
        if (( DRY_RUN )); then
          dry "Would add $n to ~/.mrk/login-items-ignore"
        else
          _append_login_item_ignore "$n"
          log "Added $n to ~/.mrk/login-items-ignore"
        fi
        manual_in_step
        exit 0
      fi
      add_items["$n"]=1
      ;;
    remove)
      if ! _listed "$n" ${stale_items_arr[@]+"${stale_items_arr[@]}"} \
                        ${conflict_items_arr[@]+"${conflict_items_arr[@]}"}; then
        if [[ -z "${tracked_items[$n]+x}" ]]; then
          refuse "config/login-items.txt does not track $n."
        fi
        refuse "$n is a login item on this Mac, so sync-login-items does not stop tracking it. Delete it in System Settings → General → Login Items first, or delete its line from config/login-items.txt by hand."
      fi
      remove_items["$n"]=1
      ;;
  esac
fi

# ─── 4. Display diff ─────────────────────────────────────────────────────────
#
# A decision shows only the change it makes, in section 6.

if [[ -z "$DECIDE" ]]; then
  if (( ${#new_items_arr[@]} == 0 && ${#stale_items_arr[@]} == 0 \
        && ${#conflict_items_arr[@]} == 0 )); then
    log "Login items are up to date."
    manual_in_step
    exit 0
  fi

  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Sync Login Items"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  if (( ${#new_items_arr[@]} > 0 )); then
    echo ""
    echo "  New (on system, not tracked):"
    for name in "${new_items_arr[@]}"; do printf "    + %s\n" "$name"; done
  fi

  if (( ${#stale_items_arr[@]} > 0 )); then
    echo ""
    echo "  Stale (tracked, not on system):"
    for name in "${stale_items_arr[@]}"; do printf "    - %s\n" "$name"; done
  fi

  if (( ${#conflict_items_arr[@]} > 0 )); then
    echo ""
    echo "  Ignored, but still tracked (post-install keeps adding these):"
    for name in "${conflict_items_arr[@]}"; do printf "    - %s\n" "$name"; done
  fi

  echo ""
fi

# ─── 5. Selection UI ─────────────────────────────────────────────────────────

if [[ -n "$DECIDE" ]]; then
  :  # The decision is the selection: one item, checked in section 3c.
elif command -v gum >/dev/null 2>&1; then
  if (( ${#new_items_arr[@]} > 0 )); then
    # gum renders its own help footer with the live keybindings, so these headers
    # deliberately do not name any key. They used to say "space to toggle"; gum 2.0
    # moved the multi-select toggle to `x`, and the stale hint told people to press
    # a key that selects nothing — enter then confirmed an empty set, silently.
    # Let gum be the only thing that describes gum's keys.
    gum_out=$(gum choose --no-limit \
      --cursor.foreground=212 \
      --selected.foreground=212 \
      --header="Select login items to ADD to tracking:" \
      "${new_items_arr[@]}" < /dev/tty 2>/dev/tty) || true
    while IFS= read -r name; do
      [[ -n "$name" ]] && add_items["$name"]=1
    done <<< "$gum_out"
  fi
  if (( ${#stale_items_arr[@]} > 0 )); then
    gum_out=$(gum choose --no-limit \
      --cursor.foreground=196 \
      --selected.foreground=196 \
      --header="Select login items to REMOVE from tracking:" \
      "${stale_items_arr[@]}" < /dev/tty 2>/dev/tty) || true
    while IFS= read -r name; do
      [[ -n "$name" ]] && remove_items["$name"]=1
    done <<< "$gum_out"
  fi
  if (( ${#conflict_items_arr[@]} > 0 )); then
    gum_out=$(gum choose --no-limit \
      --cursor.foreground=196 \
      --selected.foreground=196 \
      --header="These are in the ignore list but post-install still adds them. Select the items to REMOVE from tracking:" \
      "${conflict_items_arr[@]}" < /dev/tty 2>/dev/tty) || true
    while IFS= read -r name; do
      [[ -n "$name" ]] && remove_items["$name"]=1
    done <<< "$gum_out"
  fi
else
  if (( ${#new_items_arr[@]} > 0 )); then
    printf "Add all %d new item(s)? [y/N] " "${#new_items_arr[@]}"
    read -r answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      for name in "${new_items_arr[@]}"; do add_items["$name"]=1; done
    fi
  fi
  if (( ${#stale_items_arr[@]} > 0 )); then
    printf "Remove all %d stale item(s)? [y/N] " "${#stale_items_arr[@]}"
    read -r answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      for name in "${stale_items_arr[@]}"; do remove_items["$name"]=1; done
    fi
  fi
  if (( ${#conflict_items_arr[@]} > 0 )); then
    printf "Remove all %d ignored-but-tracked item(s) from tracking? [y/N] " \
      "${#conflict_items_arr[@]}"
    read -r answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      for name in "${conflict_items_arr[@]}"; do remove_items["$name"]=1; done
    fi
  fi
fi

# ─── 5b. Offer to ignore the declined items ──────────────────────────────────
#
# The candidates the user did not select come back every run. Offer to write
# them to the ignore file, so the file populates itself instead of needing a
# hand edit. This stage touches ONLY the ignore file: it never adds, deletes
# or retracks anything in config/login-items.txt or docs/manual.md.
#
# It must run before the "nothing selected" exit below, because declining
# every candidate is exactly the case this is for. A decision skips it, as
# sync's do: it decides one item and says nothing about the others.

declined_arr=()
for name in "${new_items_arr[@]}"; do
  [[ -z "${add_items[$name]+x}" ]] && declined_arr+=("$name")
done

if [[ -z "$DECIDE" ]] && (( ${#declined_arr[@]} > 0 )); then
  declare -A ignore_selected=()

  if command -v gum >/dev/null 2>&1; then
    gum_out=$(gum choose --no-limit \
      --cursor.foreground=214 \
      --selected.foreground=214 \
      --header="Select declined items to add to the ignore list, so they stop reappearing:" \
      "${declined_arr[@]}" < /dev/tty 2>/dev/tty) || true
    while IFS= read -r name; do
      [[ -n "$name" ]] && ignore_selected["$name"]=1
    done <<< "$gum_out"
  else
    printf "Add all %d declined item(s) to ~/.mrk/login-items-ignore? [y/N] " "${#declined_arr[@]}"
    read -r answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      for name in "${declined_arr[@]}"; do ignore_selected["$name"]=1; done
    fi
  fi

  if (( ${#ignore_selected[@]} > 0 )); then
    while IFS= read -r name; do
      # Defensive: a selected name cannot already be in the list, because the
      # drop stage removed those before the candidates were shown.
      if _login_item_ignored "$name"; then
        log "$name is already in ~/.mrk/login-items-ignore"
        continue
      fi
      if (( DRY_RUN )); then
        dry "Would add $name to ~/.mrk/login-items-ignore"
        continue
      fi
      _append_login_item_ignore "$name"
      log "Added $name to ~/.mrk/login-items-ignore"
    done < <(printf '%s\n' "${!ignore_selected[@]}" | sort)
  fi
fi

n_add=${#add_items[@]}
n_remove=${#remove_items[@]}

if (( n_add == 0 && n_remove == 0 )); then
  log "No changes selected."
  manual_in_step
  exit 0
fi

# ─── 6. Show summary ─────────────────────────────────────────────────────────

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Sync Login Items — Changes"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if (( n_add > 0 )); then
  echo ""
  echo "  Adding:"
  while IFS= read -r name; do printf "    + %s\n" "$name"; done \
    < <(printf '%s\n' "${!add_items[@]}" | sort)
fi
if (( n_remove > 0 )); then
  echo ""
  echo "  Removing:"
  while IFS= read -r name; do printf "    - %s\n" "$name"; done \
    < <(printf '%s\n' "${!remove_items[@]}" | sort)
fi
echo ""

if (( DRY_RUN )); then
  echo "  [dry run] No files modified."
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 0
fi

# ─── 7. Update config/login-items.txt ────────────────────────────────────────
#
# Line by line, as a program writing the file would: a new path goes before
# the first path that sorts after it in byte order, or at the end, and a path
# leaves by its exact line. Comments, empty lines and the order of the rest
# stay as they are. Bytes, not text, so the order is byte order whatever the
# locale, and a path is written back exactly as it was read.

TEMP_ADD=$(mrk_mktemp)
TEMP_REMOVE=$(mrk_mktemp)
TMP_LIST=$(mrk_mktemp)

for name in "${!add_items[@]}"; do
  printf '%s\n' "${system_items[$name]}" >> "$TEMP_ADD"
done

for name in "${!remove_items[@]}"; do
  printf '%s\n' "${tracked_items[$name]}" >> "$TEMP_REMOVE"
done

python3 - "$LOGIN_ITEMS" "$TEMP_ADD" "$TEMP_REMOVE" "$TMP_LIST" <<'PYEOF'
import sys

src, add_file, remove_file, out_path = sys.argv[1:5]

def lines_of(path):
    with open(path, 'rb') as f:
        lines = f.read().split(b'\n')
    if lines and lines[-1] == b'':
        lines.pop()
    return lines

# The same test as mrk_config_entries in lib.sh.
def is_entry(line):
    return not line.startswith(b'#') and line.strip() != b''

lines   = lines_of(src)
present = {l for l in lines if is_entry(l)}
adds    = sorted({l for l in lines_of(add_file) if l} - present)
removes = {l for l in lines_of(remove_file) if l}

missing = removes - present
if missing:
    for m in sorted(missing):
        print('Warning: config/login-items.txt has no line ' + m.decode('utf-8', 'replace'), file=sys.stderr)
    sys.exit(1)

out, i = [], 0
for line in lines:
    if is_entry(line):
        if line in removes:
            continue
        while i < len(adds) and adds[i] < line:
            out.append(adds[i])
            i += 1
    out.append(line)
out.extend(adds[i:])

with open(out_path, 'wb') as f:
    f.write(b''.join(l + b'\n' for l in out))
total = sum(1 for l in out if is_entry(l))
print(f'Updated config/login-items.txt: {len(adds)} added, {len(removes)} removed, {total} total.')
PYEOF

# ─── 8. Build final items list for docs ──────────────────────────────────────

declare -A final_items=()
for name in "${!tracked_items[@]}"; do
  [[ -z "${remove_items[$name]+x}" ]] && final_items["$name"]=1 || true
done
for name in "${!add_items[@]}"; do
  final_items["$name"]=1
done

items_list=$(manual_items "${!final_items[@]}")

# ─── 9. Update docs ──────────────────────────────────────────────────────────

write_manual "$items_list"

# Both outputs succeeded — atomically replace the real files.
# mktemp creates 0600, so restore the expected modes before the swap.
chmod 644 "$TMP_LIST"
chmod 644 "$TMP_MD"
mv "$TMP_LIST" "$LOGIN_ITEMS"
mv "$TMP_MD" "$MANUAL_MD"

log "config/login-items.txt and docs updated."

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

# ─── 10. Optional commit ─────────────────────────────────────────────────────

if (( COMMIT )); then
  cd "$REPO_ROOT"

  changed_files=()
  git diff --quiet "$LOGIN_ITEMS" 2>/dev/null || changed_files+=("config/login-items.txt")
  git diff --quiet "$MANUAL_MD"   2>/dev/null || changed_files+=("docs/manual.md")

  if (( ${#changed_files[@]} == 0 )); then
    log "No changes to commit."
  else
    added_names=()
    removed_names=()
    for name in "${!add_items[@]}"; do added_names+=("$name"); done
    for name in "${!remove_items[@]}"; do removed_names+=("$name"); done

    commit_parts=()
    if (( ${#added_names[@]} > 0 )); then
      mapfile -t added_names < <(printf '%s\n' "${added_names[@]}" | sort)
      commit_parts+=("add $(IFS=', '; echo "${added_names[*]}")")
    fi
    if (( ${#removed_names[@]} > 0 )); then
      mapfile -t removed_names < <(printf '%s\n' "${removed_names[@]}" | sort)
      commit_parts+=("remove $(IFS=', '; echo "${removed_names[*]}")")
    fi

    commit_msg="login-items: $(IFS='; '; echo "${commit_parts[*]}")"
    git add "${changed_files[@]}"
    git commit -m "$commit_msg"
    log "Committed: $commit_msg"
  fi
fi
