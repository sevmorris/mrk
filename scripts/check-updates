#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

# mrk update checker, run from .zshrc at every interactive shell start.
# Silent unless origin has commits this checkout has not seen asked about.
# Zero blocking network I/O on shell startup: it compares against the last
# fetched remote, then refreshes origin in a disowned background fetch, at most
# once a day.
#
# Until 2026-09-30 the whole check ran at most once every 7 days: a commit
# pushed the day after a check waited up to a week to be offered, and a "no"
# was forgotten a week later only because the interval had passed. Now the
# compare runs at every shell start, which costs a few local git calls; the
# fetch is what is rate-limited, and the prompt is asked once per remote head.

# Configuration
CACHE_DIR="${HOME}/.cache/mrk"
# When the last background fetch started, in epoch seconds. The name is the one
# the weekly check used for its timestamp, which marked a fetch too, so a Mac
# that ran the weekly check carries straight on.
TIMESTAMP_FILE="${CACHE_DIR}/last-update-check"
FETCH_INTERVAL=86400  # one day
# asked-<sha>: the remote head check-updates last asked about.
ASKED_PREFIX="${CACHE_DIR}/asked-"

# Inline rather than sourced from scripts/lib.sh: this runs on every
# interactive shell start, and the header above promises zero blocking work
# there — sourcing a 250-line library on every new shell would spend exactly
# what this script exists to avoid.
#
# It sits above the first side effect. check-updates is not inert: before it
# reaches its prompt it may write the fetch timestamp and disown a background
# git fetch, and answering that prompt runs `make pull`. Until 2026-09-10 the
# flag was discarded and `check-updates --help` did all of that.
usage() {
  cat <<'EOF'
check-updates — tell me when mrk has upstream commits

Usage:
  check-updates [--help | -h]

check-updates takes no options other than --help, and is meant to run from
shell startup. At every start it compares the checkout with the last fetched
origin, and when the checkout is behind it offers to run `make pull`, once for
each new remote head: answer no and it stays quiet until origin moves again.
Answer yes, and if the pull fails, the next shell asks again.
It exits silently when the shell is not interactive, when the checkout is not
on the default branch, or when there is nothing new. It never blocks on the
network: it refreshes origin in a disowned background fetch, at most once a
day.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  ?*)        usage >&2; printf '\nunknown argument: %s\n' "$1" >&2; exit 2 ;;
esac

# Resolve symlinks so this works when called via ~/bin symlink
_resolve_self() {
  local target="$1"
  while [[ -L "$target" ]]; do
    local dir; dir="$(cd "$(dirname "$target")" && pwd)"
    target="$(readlink "$target")"
    [[ "$target" != /* ]] && target="$dir/$target"
  done
  cd "$(dirname "$target")" && pwd
}
REPO_DIR="${REPO_DIR:-$(_resolve_self "${BASH_SOURCE[0]}")/..}"
REPO_DIR="$(cd "$REPO_DIR" && pwd)"

# Exit silently if not in an interactive shell
[[ -t 0 ]] || exit 0

# Verify repo directory exists and is a git repo
if [[ ! -d "$REPO_DIR/.git" ]]; then
  exit 0
fi

[[ -d "$CACHE_DIR" ]] || mkdir -p "$CACHE_DIR"

# fetch_if_due — refresh origin in a disowned background fetch, unless one
# started less than a day ago. The timestamp is written first, so the shells
# that start while the fetch runs do not start their own.
fetch_if_due() {
  local now last=0
  # EPOCHSECONDS is bash 5; under the 3.2 a new Mac has, date.
  now=${EPOCHSECONDS:-$(date +%s)}
  [[ -f "$TIMESTAMP_FILE" ]] && last=$(<"$TIMESTAMP_FILE")
  [[ "$last" =~ ^[0-9]+$ ]] || last=0
  # A timestamp in the future, from a clock set back, counts as due.
  if (( now - last < FETCH_INTERVAL && last <= now )); then
    return 0
  fi
  printf '%s\n' "$now" > "$TIMESTAMP_FILE"
  { git -C "$REPO_DIR" fetch --quiet 2>/dev/null || true; } & disown
}

# offer_pull — ask to run make pull when the checkout is behind a remote head it
# has not asked about. Returns 0 whenever there is nothing to ask.
offer_pull() {
  local default_branch branch local_head remote_head marker f n what rc

  # Detect default branch name. symbolic-ref, and `|| true`: this used to be
  # `rev-parse --abbrev-ref origin/HEAD | cut`, and with pipefail a missing
  # origin/HEAD failed the assignment, so set -e ended the script silently —
  # every week, after the timestamp, before any fetch that could restore the
  # ref. The fallback below was unreachable. (rev-parse also prints
  # "origin/HEAD" when it fails, so it cannot simply be made to succeed.)
  default_branch=$(git -C "$REPO_DIR" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null || true)
  default_branch="${default_branch#origin/}"
  default_branch="${default_branch:-main}"

  # Only on the default branch. make pull fast-forwards the branch that is
  # checked out, so on any other one "yes" would pull that branch's upstream,
  # not the commits the prompt was about.
  branch=$(git -C "$REPO_DIR" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  [[ "$branch" == "$default_branch" ]] || return 0

  # Compare local HEAD with last fetched remote (no blocking fetch)
  local_head=$(git -C "$REPO_DIR" rev-parse HEAD 2>/dev/null) || return 0
  remote_head=$(git -C "$REPO_DIR" rev-parse --verify --quiet "origin/$default_branch^{commit}" 2>/dev/null) || return 0
  [[ "$local_head" != "$remote_head" ]] || return 0

  # Local has diverged or is ahead; don't prompt
  git -C "$REPO_DIR" merge-base --is-ancestor "$local_head" "$remote_head" 2>/dev/null || return 0

  # Once per remote head. noclobber makes creating the marker the test: of the
  # shells a restored terminal session starts at once, one creates it and asks,
  # and the rest find it there. It is written before the prompt, so a Ctrl-C
  # there counts as the answer.
  marker="${ASKED_PREFIX}${remote_head}"
  ( set -o noclobber; : > "$marker" ) 2>/dev/null || return 0
  for f in "$ASKED_PREFIX"*; do
    [[ "$f" == "$marker" ]] || rm -f -- "$f"
  done

  n=$(git -C "$REPO_DIR" rev-list --count "$local_head..$remote_head" 2>/dev/null || echo '')
  case "$n" in
    '') what="new commits" ;;
    1)  what="1 new commit" ;;
    *)  what="$n new commits" ;;
  esac
  printf '\033[33mmrk: %s on origin/%s.\033[0m Update now? [y/N] ' "$what" "$default_branch"
  local response=""
  read -r response </dev/tty || response=""
  # Spelt out: bash 3.2 and 5 disagree on a ~ in ${REPO_DIR/#$HOME/~}.
  local shown="$REPO_DIR"
  [[ "$REPO_DIR" == "$HOME"/* ]] && shown="~${REPO_DIR#"$HOME"}"
  case "$response" in
    [yY]|[yY][eE][sS])
      # A pull that fails is not an answer. The marker is written above, before
      # the prompt, and until 2026-10-01 it stayed after a failed pull: the
      # checkout was still behind, and nothing asked again until origin moved
      # (audit 20, X-5). Without the marker the next shell asks again. The
      # status is make's, as before.
      rc=0
      make -C "$REPO_DIR" pull || rc=$?
      if (( rc != 0 )); then
        rm -f -- "$marker"
        printf '  The pull failed. The next shell asks again. To update: make -C %s pull\n' "$shown"
        return "$rc"
      fi
      ;;
    *)
      printf '  Not asking again until origin/%s moves. To update: make -C %s pull\n' \
        "$default_branch" "$shown"
      ;;
  esac
}

offer_pull

# After the prompt, not before: a fetch still running when "yes" starts make
# pull would contend with the pull's own fetch for the same refs.
fetch_if_due
