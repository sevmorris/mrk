#!/usr/bin/env bash
set -euo pipefail

# check-defaults-desc — verify the defaults reference documents every key
# defaults.sh writes.
#
# The MRK-1 page reads config/defaults.tsv at load time and looks each key up
# in docs/defaults/descriptions.tsv, which it reads too. A key with no line
# there renders with no description, and a line with no key is dead weight.
# Both have happened before: audit finding N-12 deleted 24 dead entries and
# wrote 18 missing ones. Nothing gated it, so this does.
#
# The descriptions were a JavaScript object in docs/defaults/script.js until
# 2026-10-21, and this script found its keys with a regular expression. They
# moved to a file of lines, which this script reads whole and checks as
# defaults.sh checks its own, so another program can read them too.
#
# The text MRK-1 shows under each section heading stayed in script.js until
# 2026-10-22, where nothing checked it: two entries described sections that
# were gone, and eight sections had none. It is docs/defaults/sections.tsv
# now, and this script holds it to the sections of config/defaults.tsv too.

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF'
check-defaults-desc — verify every key defaults.sh writes is documented

Usage:
  check-defaults-desc

Options:
  -h, --help      Show this help

check-defaults-desc takes no options other than --help. It compares the keys
in config/defaults.tsv against the descriptions in
docs/defaults/descriptions.tsv, which the MRK-1 page reads at load time, and
fails when either side has a key the other does not. It also fails on a line
of config/defaults.tsv that defaults.sh would refuse, and on a line of
descriptions.tsv that is not one description. The same key, type and value in
two domains of one section is one setting, as MRK-1 shows it: it wants one
description, for the first of the domains.

It compares the sections of config/defaults.tsv with
docs/defaults/sections.tsv in the same way. Each section needs one line
there, and each line needs a section.

It fails on a line of config/defaults-skip.tsv that defaults.sh would refuse:
a line that is not a domain and a key, that names no key of
config/defaults.tsv, or that names a key a second time.
EOF
}
mrk_help_guard "$(usage)" "$@"

DEFAULTS_TSV="$REPO_ROOT/config/defaults.tsv"
DESCRIPTIONS_TSV="$REPO_ROOT/docs/defaults/descriptions.tsv"
SECTIONS_TSV="$REPO_ROOT/docs/defaults/sections.tsv"

if ! defaults_table "$DEFAULTS_TSV"; then
  echo "check-defaults-desc: config/defaults.tsv has a line defaults.sh would refuse (see above)" >&2
  exit 1
fi
if ! defaults_skips "$REPO_ROOT/config/defaults-skip.tsv"; then
  echo "check-defaults-desc: config/defaults-skip.tsv has a line defaults.sh would refuse (see above)" >&2
  exit 1
fi
if ! defaults_desc_table "$DESCRIPTIONS_TSV"; then
  echo "check-defaults-desc: docs/defaults/descriptions.tsv has a line that is not one description (see above)" >&2
  exit 1
fi
if ! defaults_sections_table "$SECTIONS_TSV"; then
  echo "check-defaults-desc: docs/defaults/sections.tsv has a line that is not one section (see above)" >&2
  exit 1
fi

# One id, domain.key, for each setting. A line whose section, key, type and
# value are those of an earlier line is that setting in a second domain: MRK-1
# shows it as the earlier line's entry, with this domain beside the first, so
# it needs no description of its own. The trackpad keys are written so, to
# com.apple.AppleMultitouchTrackpad and its Bluetooth twin.
# Each id is the domain and the key, with a space between them, as
# `defaults read` takes them.
script_keys=()
settings=$'\n'
for i in "${!DT_DOMAIN[@]}"; do
  setting="${DT_SECTION[i]}"$'\t'"${DT_KEY[i]}"$'\t'"${DT_TYPE[i]}"$'\t'"${DT_VALUE[i]}"
  case "$settings" in *$'\n'"$setting"$'\n'*) continue ;; esac
  settings+="$setting"$'\n'
  script_keys+=("${DT_DOMAIN[i]} ${DT_KEY[i]}")
done

desc_keys=()
for i in ${DD_DOMAIN[@]+"${!DD_DOMAIN[@]}"}; do
  desc_keys+=("${DD_DOMAIN[i]} ${DD_KEY[i]}")
done

# Bash-3.2-safe membership test, for the reason recorded in check-picker-desc:
# `printf | grep -Fxq` races against pipefail when grep matches early.
in_array() {
  local target=$1; shift
  for item in "$@"; do [[ $item == "$target" ]] && return 0; done
  return 1
}

missing=()
orphan=()
for id in "${script_keys[@]}"; do
  in_array "$id" ${desc_keys[@]+"${desc_keys[@]}"} || missing+=("$id")
done
for id in ${desc_keys[@]+"${desc_keys[@]}"}; do
  in_array "$id" "${script_keys[@]}" || orphan+=("$id")
done

# The sections, in the order they first appear in config/defaults.tsv.
script_sections=()
for s in "${DT_SECTION[@]}"; do
  in_array "$s" ${script_sections[@]+"${script_sections[@]}"} || script_sections+=("$s")
done
missing_sections=()
orphan_sections=()
for s in "${script_sections[@]}"; do
  in_array "$s" ${DS_SECTION[@]+"${DS_SECTION[@]}"} || missing_sections+=("$s")
done
for s in ${DS_SECTION[@]+"${DS_SECTION[@]}"}; do
  in_array "$s" "${script_sections[@]}" || orphan_sections+=("$s")
done

if (( ${#missing[@]} + ${#orphan[@]} + ${#missing_sections[@]} + ${#orphan_sections[@]} == 0 )); then
  echo "check-defaults-desc: OK (${#script_keys[@]} keys, ${#script_sections[@]} sections, descriptions in sync)"
  exit 0
fi

if (( ${#missing[@]} > 0 )); then
  echo "check-defaults-desc: in config/defaults.tsv, with no line in docs/defaults/descriptions.tsv (${#missing[@]}):" >&2
  printf '  %s\n' "${missing[@]}" >&2
fi
if (( ${#orphan[@]} > 0 )); then
  echo "check-defaults-desc: in docs/defaults/descriptions.tsv, not in config/defaults.tsv (${#orphan[@]}):" >&2
  printf '  %s\n' "${orphan[@]}" >&2
fi
if (( ${#missing_sections[@]} > 0 )); then
  echo "check-defaults-desc: a section of config/defaults.tsv, with no line in docs/defaults/sections.tsv (${#missing_sections[@]}):" >&2
  printf '  %s\n' "${missing_sections[@]}" >&2
fi
if (( ${#orphan_sections[@]} > 0 )); then
  echo "check-defaults-desc: in docs/defaults/sections.tsv, not a section of config/defaults.tsv (${#orphan_sections[@]}):" >&2
  printf '  %s\n' "${orphan_sections[@]}" >&2
fi
exit 1
