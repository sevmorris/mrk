#!/usr/bin/env bash
set -euo pipefail

# check-defaults-desc — verify the defaults reference documents every key
# defaults.sh writes.
#
# The MRK-1 page reads config/defaults.tsv at load time and looks each key up
# in the DEFAULT_DESCRIPTIONS map in docs/defaults/script.js. A key with no
# entry renders with no description, and an entry with no key is dead weight.
# Both have happened before: audit finding N-12 deleted 24 dead entries and
# wrote 18 missing ones. Nothing gated it, so this does.

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF'
check-defaults-desc — verify every key defaults.sh writes is documented

Usage:
  check-defaults-desc

Options:
  -h, --help      Show this help

check-defaults-desc takes no options other than --help. It compares the keys
in config/defaults.tsv against the descriptions in docs/defaults/script.js,
which the MRK-1 page reads at load time, and fails when either side has a key
the other does not. It also fails on a line of config/defaults.tsv that
defaults.sh would refuse. The same key, type and value in two domains of one
section is one setting, as MRK-1 shows it: it wants one description, for the
first of the domains.
EOF
}
mrk_help_guard "$(usage)" "$@"

DEFAULTS_TSV="$REPO_ROOT/config/defaults.tsv"
SCRIPT_JS="$REPO_ROOT/docs/defaults/script.js"

if ! defaults_table "$DEFAULTS_TSV"; then
  echo "check-defaults-desc: config/defaults.tsv has a line defaults.sh would refuse (see above)" >&2
  exit 1
fi
if [[ ! -f "$SCRIPT_JS" ]]; then
  echo "check-defaults-desc: script.js not found: $SCRIPT_JS" >&2
  exit 1
fi

# One id, domain.key, for each setting. A line whose section, key, type and
# value are those of an earlier line is that setting in a second domain: MRK-1
# shows it as the earlier line's entry, with this domain beside the first, so
# it needs no description of its own. The trackpad keys are written so, to
# com.apple.AppleMultitouchTrackpad and its Bluetooth twin.
script_keys=()
settings=$'\n'
for i in "${!DT_DOMAIN[@]}"; do
  setting="${DT_SECTION[i]}"$'\t'"${DT_KEY[i]}"$'\t'"${DT_TYPE[i]}"$'\t'"${DT_VALUE[i]}"
  case "$settings" in *$'\n'"$setting"$'\n'*) continue ;; esac
  settings+="$setting"$'\n'
  script_keys+=("${DT_DOMAIN[i]}.${DT_KEY[i]}")
done

desc_keys=()
while IFS= read -r id; do
  [[ -n "$id" ]] && desc_keys+=("$id")
done < <(
  sed -nE "s/^[[:space:]]{4}['\"]([^'\"]+)['\"][[:space:]]*:[[:space:]]*\{.*/\1/p" "$SCRIPT_JS" | sort -u
)

# Bash-3.2-safe membership test, for the reason recorded in check-picker-desc:
# `printf | grep -Fxq` races against pipefail when grep matches early.
in_array() {
  local target=$1; shift
  for item in "$@"; do [[ $item == "$target" ]] && return 0; done
  return 1
}

missing=()
orphan=()
for id in "${script_keys[@]}"; do
  in_array "$id" "${desc_keys[@]}" || missing+=("$id")
done
for id in "${desc_keys[@]}"; do
  in_array "$id" "${script_keys[@]}" || orphan+=("$id")
done

if (( ${#missing[@]} == 0 && ${#orphan[@]} == 0 )); then
  echo "check-defaults-desc: OK (${#script_keys[@]} keys, descriptions in sync)"
  exit 0
fi

if (( ${#missing[@]} > 0 )); then
  echo "check-defaults-desc: in config/defaults.tsv, undocumented in script.js (${#missing[@]}):" >&2
  printf '  %s\n' "${missing[@]}" >&2
fi
if (( ${#orphan[@]} > 0 )); then
  echo "check-defaults-desc: documented in script.js, not in config/defaults.tsv (${#orphan[@]}):" >&2
  printf '  %s\n' "${orphan[@]}" >&2
fi
exit 1
