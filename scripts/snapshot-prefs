#!/usr/bin/env bash

# mrk snapshot-prefs — export current app preferences to ~/.mrk/preferences/
# and push to the private mrk-prefs repo.

# Re-exec with Homebrew bash if running under bash < 4 (macOS ships bash 3.2).
# This script uses mapfile, which bash 3.2 does not have. The failure was a
# runtime one, so neither `bash -n` nor shellcheck caught it.
if (( BASH_VERSINFO[0] < 4 )); then
  for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_brew_bash" ]] && exec "$_brew_bash" "$0" "$@"
  done
  echo "error: bash 4+ required (system bash is ${BASH_VERSION}; install via 'brew install bash')" >&2
  exit 1
fi

set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF'
snapshot-prefs — export app preferences to ~/.mrk/preferences and push them

Usage:
  snapshot-prefs [--dry-run]

Options:
  -n, --dry-run   Export into a scratch copy of ~/.mrk/preferences and report
                  what would be committed, with each plist's changed keys.
                  ~/.mrk/preferences is left as it was; nothing is committed
                  or pushed. The secret scan still runs.
  -h, --help      Show this help

snapshot-prefs exports each app's preferences into ~/.mrk/preferences, and
commits and pushes that tree to the private mrk-prefs repo. It does not quit
any app: defaults export asks the preferences system, which has an open app's
changes as soon as it makes them. An app with no preferences yet is skipped,
and its saved copy kept.

A plist that differs from the last commit only in keys that change on their
own (update-check times, window and menu bar positions, launch counters, the
versions that have run) is left out of the commit, and when nothing else
changed there is no commit. The export itself is whole: those keys are saved
whenever something else in the file changes.

A commit that an earlier run made and could not push is pushed by the next
run, also when that run finds nothing new to commit. "No changes to push."
means the remote has the last commit.
EOF
}

DRY_RUN=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=1 ;;
    -h|--help)    usage; exit 0 ;;
    *)            usage >&2; printf '\nunknown argument: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

: "${PREFS_REPO:=git@github.com:sevmorris/mrk-prefs.git}"
LOCAL_PREFS_DIR="$HOME/.mrk/preferences"
APP_SUPPORT="$HOME/Library/Application Support"

# Apps whose export failed or timed out — reported at exit, never fatal.
SNAPSHOT_SKIPPED=()
DRY_SCRATCH=""
on_exit(){
  if (( ${#SNAPSHOT_SKIPPED[@]} > 0 )); then
    warn "Skipped ${#SNAPSHOT_SKIPPED[@]} app(s) — export failed or timed out: ${SNAPSHOT_SKIPPED[*]}"
  fi
  if [[ -n "$DRY_SCRATCH" ]]; then rm -rf "$DRY_SCRATCH"; fi
}
trap on_exit EXIT

# Run `defaults ARGS...` with a timeout so a hung or sandboxed domain can't
# stall the whole run. Prefers timeout/gtimeout (coreutils); else background-kill.
defaults_timeout(){
  local secs=15
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" defaults "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" defaults "$@"
  else
    defaults "$@" &
    local pid=$! rc=0
    # The watchdog's output goes nowhere: its sleep would otherwise hold open
    # the pipe of a caller capturing `defaults domains`, and the capture would
    # wait out the full timeout after defaults had long finished.
    ( sleep "$secs"; kill "$pid" 2>/dev/null ) >/dev/null 2>&1 &
    local killer=$!
    wait "$pid" 2>/dev/null || rc=$?
    kill "$killer" 2>/dev/null || true
    return "$rc"
  fi
}

# unpushed_count DIR — print how many commits DIR's branch holds that its
# upstream lacks, as of the last fetch or push: nothing asks the network. When
# the branch has no upstream yet, every commit counts; that is how a new clone
# is left when its first push fails. 0 when DIR is no repository, or holds no
# commit.
unpushed_count() {
  local dir=$1 n
  if [[ ! -d "$dir/.git" ]] || ! git -C "$dir" rev-parse --verify --quiet HEAD >/dev/null; then
    echo 0
    return 0
  fi
  n=$(git -C "$dir" rev-list --count '@{upstream}..HEAD' 2>/dev/null) \
    || n=$(git -C "$dir" rev-list --count HEAD 2>/dev/null) || n=0
  echo "$n"
}

# The real ~/.mrk/preferences, kept for unpushed_count: a dry run points
# LOCAL_PREFS_DIR at a scratch clone, whose upstream is this directory and not
# mrk-prefs.
REAL_PREFS_DIR="$LOCAL_PREFS_DIR"

# A dry run exports into a clone of ~/.mrk/preferences instead, so the staging,
# the comparison with HEAD and the secret scan below all run as they would for
# real, against the same last commit, and the real tree is never written.
# Refused, as the real run is, while a merge or rebase there is unfinished.
if (( DRY_RUN )); then
  if [[ -d "$LOCAL_PREFS_DIR/.git" ]] && busy=$(git_in_progress "$LOCAL_PREFS_DIR"); then
    err "$busy in $LOCAL_PREFS_DIR — resolve it first. Nothing was exported."
    exit 1
  fi
  DRY_SCRATCH=$(mrk_mktemp_d) || { err "could not create a scratch directory for the dry run"; exit 1; }
  if [[ -d "$LOCAL_PREFS_DIR/.git" ]]; then
    git clone -q "$LOCAL_PREFS_DIR" "$DRY_SCRATCH/preferences" 2>/dev/null \
      || { err "could not copy $LOCAL_PREFS_DIR for the dry run"; exit 1; }
  else
    git init -q "$DRY_SCRATCH/preferences"
  fi
  log "Dry run: exporting into a scratch copy of $LOCAL_PREFS_DIR. Nothing there changes, and nothing is committed or pushed."
  LOCAL_PREFS_DIR="$DRY_SCRATCH/preferences"
fi

# Ensure the local prefs dir is a git repo pointing at mrk-prefs
if [[ ! -d "$LOCAL_PREFS_DIR/.git" ]]; then
  if [[ -d "$LOCAL_PREFS_DIR" ]]; then
    log "Initialising git repo in existing directory: $LOCAL_PREFS_DIR"
    git -C "$LOCAL_PREFS_DIR" init
    git -C "$LOCAL_PREFS_DIR" remote add origin "$PREFS_REPO"
  else
    log "Cloning $PREFS_REPO → $LOCAL_PREFS_DIR"
    git clone "$PREFS_REPO" "$LOCAL_PREFS_DIR"
  fi
fi

# Before any file is exported into the tree. In a repository
# stopped mid-merge, the `git add -A` below would mark the conflicted files
# resolved, conflict markers and all, and the commit would conclude the merge.
# pull-prefs pulls with --ff-only, so only a git command run by hand can leave
# the tree like that.
if busy=$(git_in_progress "$LOCAL_PREFS_DIR"); then
  err "$busy in $LOCAL_PREFS_DIR — resolve it first. Nothing was exported or pushed."
  exit 1
fi

# ── Plist exports (defaults export) ──────────────────────────────────────────

snapshot_plist(){
  local bundle_id="$1" filename="$2" app_path="$3" name="$4" src
  if [[ ! -d "$app_path" ]]; then
    log "Skipping $name (not installed)"
    return 0
  fi
  src=$(prefs_source "$bundle_id")
  # An installed app that has never been set up has no domain, and `defaults
  # export` does not fail on one: it writes an empty dict, which would replace
  # the copy saved from the last machine and be pushed. BetterSnapTool comes
  # from the App Store, which is installed by hand after post-install has run,
  # so on a new Mac it sits in exactly that state until post-install runs
  # again. `defaults read` exits 1 for an absent or empty domain alike.
  if ! defaults_timeout read "$src" >/dev/null 2>&1; then
    log "Skipping $name (no preferences here yet — the saved copy is kept)"
    return 0
  fi
  if ! defaults_timeout export "$src" "$LOCAL_PREFS_DIR/$filename"; then
    warn "failed to export $name — skipped"
    SNAPSHOT_SKIPPED+=("$name")
    return 0
  fi
  # Convert to xml1 (as bin/snapshot does) so the secret scan reads text,
  # not binary plist data.
  if ! plutil -convert xml1 "$LOCAL_PREFS_DIR/$filename" 2>/dev/null; then
    warn "failed to convert $name export to xml1 — skipped"
    SNAPSHOT_SKIPPED+=("$name")
    return 0
  fi
  if ! scan_for_secrets "$LOCAL_PREFS_DIR/$filename"; then
    warn "$name export may contain secrets — review before pushing"
  fi
  log "Saved $name → $LOCAL_PREFS_DIR/$filename"
}

# Previously captured
snapshot_plist "com.hegenberg.BetterSnapTool"           "BetterSnapTool.plist"    "/Applications/BetterSnapTool.app"   "BetterSnapTool"
snapshot_plist "com.stonerl.Thaw"                       "Thaw.plist"              "/Applications/Thaw.app"             "Thaw"
snapshot_plist "com.googlecode.iterm2"                  "iTerm2.plist"            "/Applications/iTerm.app"            "iTerm2"

# Newly added
snapshot_plist "com.raycast.macos"                      "Raycast.plist"           "/Applications/Raycast.app"          "Raycast"
snapshot_plist "eu.exelban.Stats"                       "Stats.plist"             "/Applications/Stats.app"            "Stats"
snapshot_plist "com.rogueamoeba.Loopback"               "Loopback.plist"          "/Applications/Loopback.app"         "Loopback"
snapshot_plist "com.rogueamoeba.soundsource"            "SoundSource.plist"       "/Applications/SoundSource.app"      "SoundSource"
snapshot_plist "com.rogueamoeba.audiohijack"            "AudioHijack.plist"       "/Applications/Audio Hijack.app"     "Audio Hijack"
snapshot_plist "com.rogueamoeba.farrago"                "Farrago.plist"           "/Applications/Farrago.app"          "Farrago"
snapshot_plist "com.rogueamoeba.Piezo"                  "Piezo.plist"             "/Applications/Piezo.app"            "Piezo"
snapshot_plist "abnerworks.Typora"                      "Typora.plist"            "/Applications/Typora.app"           "Typora"
snapshot_plist "com.aone.keka"                          "Keka.plist"              "/Applications/Keka.app"             "Keka"
snapshot_plist "com.tclementdev.timemachineeditor.application" "TimeMachineEditor.plist" "/Applications/TimeMachineEditor.app" "TimeMachineEditor"
snapshot_plist "com.goodsnooze.MacWhisper"              "MacWhisper.plist"        "/Applications/MacWhisper.app"       "MacWhisper"

# Migrated out of Magic Backup Machine, 2026-09-02. MBM carried these inside an
# rsync mirror, which keeps the current state and no history. They are settings,
# they are tiny, and a regression in one is worth being able to diff.
snapshot_plist "net.imput.helium"                       "Helium.plist"            "/Applications/Helium.app"           "Helium"
snapshot_plist "com.WavesAudio.central"                 "WavesCentral.plist"      "/Applications/Waves Central.app"    "Waves Central"
snapshot_plist "org.musicbrainz.Picard"                 "Picard.plist"            "/Applications/MusicBrainz Picard.app" "MusicBrainz Picard"

# KeyVault (io.github.sevmorris.KeyVault) is deliberately absent, and must stay
# absent. It is a secrets manager. Its API keys and notes are self-describing
# Keychain items, not UserDefaults, so a plist export would carry no secret —
# but it would put a manifest of what the vault holds into mrk-prefs. Its SSH
# and GPG keys are not in the Keychain at all: KeyVault indexes ~/.ssh and
# ~/.gnupg, so those never had anything to do with a defaults export either.
# Nothing here can back up a KeyVault vault, and nothing here should try.
# The key files have their own script — snapshot-keys — which writes one
# encrypted archive to a path outside every directory a wipe deletes, and
# pushes nowhere. Same call already made for Bitwarden, NordPass and 1Password.
#
# Leaving it out of the named list was not enough. The group export below takes
# every io.github.sevmorris.* domain, and from the 2026-09-02 migration until
# 2026-09-30 it took KeyVault's with the rest: seven snapshots pushed its note
# categories, its last folder and its window state to mrk-prefs. So the group
# names what it leaves out, and removes a copy it finds saved.
OWN_APPS_EXCLUDED=(io.github.sevmorris.KeyVault)

# ── My own applications ───────────────────────────────────────────────────────

# Every io.github.sevmorris.* domain, taken as a group rather than named one at
# a time. The list changes whenever I ship something new, and a hand-maintained
# list would go stale the first time that happened — check-picker-desc exists
# because that kind of list always does.
#
# Also migrated out of Magic Backup Machine. These are the preferences of
# software I wrote: a settings regression after a release is precisely what
# version history is for, and an rsync mirror cannot answer "what changed".
#
# Listed by `defaults domains`, not by a glob of ~/Library/Preferences: a
# sandboxed app's domain exists only inside its container, and
# defaults lists it without this script reaching into another app's container
# itself. prefs_source then decides which copy to read, which matters for the
# five apps that kept a container from a sandboxed build. Empty domains are not
# worth a file — ClipHack's tests leave one behind per test process, and ten of
# them had been saved. OWN_APPS_EXCLUDED, above, is never read, and a copy of
# one found in the tree is deleted, so the commit removes it from mrk-prefs.
snapshot_own_apps(){
  local dest="$LOCAL_PREFS_DIR/sevmorris-apps"
  local list domain src x found=0
  mkdir -p "$dest"
  for x in "${OWN_APPS_EXCLUDED[@]}"; do
    if [[ -e "$dest/$x.plist" ]]; then
      rm -f "$dest/$x.plist"
      if (( DRY_RUN )); then
        warn "$x.plist is in the saved preferences, and must not be: the real run removes it"
      else
        warn "$x.plist was in the saved preferences, and must not be: removed"
      fi
    fi
  done
  if ! list=$(defaults_timeout domains); then
    warn "could not list the defaults domains — my own apps skipped"
    SNAPSHOT_SKIPPED+=("my own apps")
    return 0
  fi
  while IFS= read -r domain; do
    [[ "$domain" == io.github.sevmorris.* && "$domain" != */* ]] || continue
    for x in "${OWN_APPS_EXCLUDED[@]}"; do
      [[ "$domain" == "$x" ]] && continue 2
    done
    src=$(prefs_source "$domain")
    defaults_timeout read "$src" >/dev/null 2>&1 || continue
    if ! defaults_timeout export "$src" "$dest/$domain.plist"; then
      warn "failed to export $domain — skipped"
      SNAPSHOT_SKIPPED+=("$domain")
      continue
    fi
    if ! plutil -convert xml1 "$dest/$domain.plist" 2>/dev/null; then
      warn "failed to convert $domain export to xml1 — skipped"
      SNAPSHOT_SKIPPED+=("$domain")
      rm -f "$dest/$domain.plist"
      continue
    fi
    found=$(( found + 1 ))
  done < <(printf '%s\n' "$list" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
  if (( found > 0 )); then
    log "Saved $found of my own apps' preferences → $dest"
  else
    log "Skipping my own apps (no io.github.sevmorris.* domains found)"
  fi
}
snapshot_own_apps

# ── Application Support files ─────────────────────────────────────────────────

snapshot_app_support(){
  local app_name="$1" dest_subdir="$2"
  shift 2
  local files=("$@")
  local src_dir="$APP_SUPPORT/$app_name"
  local dest_dir="$LOCAL_PREFS_DIR/app-support/$dest_subdir"

  if [[ ! -d "$src_dir" ]]; then
    log "Skipping $app_name app support (directory not found)"
    return 0
  fi

  mkdir -p "$dest_dir"
  local saved=0
  for file in "${files[@]}"; do
    if [[ -f "$src_dir/$file" ]]; then
      cp "$src_dir/$file" "$dest_dir/$file"
      if ! scan_for_secrets "$dest_dir/$file"; then
        warn "$app_name/$file may contain secrets — review before pushing"
      fi
      saved=$(( saved + 1 ))
    fi
  done
  log "Saved $app_name app support ($saved file(s)) → $dest_dir"
}

# Loopback routing configurations
snapshot_app_support "Loopback" "Loopback" \
  "Devices.plist" "RecentApps.plist"

# SoundSource device presets and routing
snapshot_app_support "SoundSource" "SoundSource" \
  "Presets.plist" "CustomPresets.plist" "Sources.plist" "Models.plist"

# ── Preference directories (file trees, not defaults domains) ─────────────────

# Some apps store configuration as a tree of files under ~/Library/Preferences/
# rather than as a defaults domain, so `defaults export` captures nothing useful.
# Copy selected top-level globs and/or subdirectories verbatim into config/, then
# secret-scan each copied file. The dest is cleared first so files removed from
# the source (e.g. uninstalled plugins) don't linger in the backup.
snapshot_pref_dir(){
  local src_dir="$1" dest_subdir="$2" name="$3"
  shift 3
  local includes=("$@")

  [[ -n "$dest_subdir" ]] || { warn "snapshot_pref_dir: empty dest_subdir for $name"; return 0; }
  if [[ ! -d "$src_dir" ]]; then
    log "Skipping $name (config dir not found: $src_dir)"
    return 0
  fi

  local dest_dir="$LOCAL_PREFS_DIR/config/$dest_subdir"
  rm -rf "$dest_dir"
  mkdir -p "$dest_dir"

  local item path rel saved=0
  for item in "${includes[@]}"; do
    shopt -s nullglob
    # Intentional glob: $item is a pattern (e.g. *.json) or a literal subdir name.
    # shellcheck disable=SC2206
    local matches=( "$src_dir"/$item )
    shopt -u nullglob
    for path in "${matches[@]}"; do
      [[ -e "$path" ]] || continue
      rel="${path#"$src_dir"/}"
      mkdir -p "$dest_dir/$(dirname "$rel")"
      cp -R "$path" "$dest_dir/$rel"
      saved=$(( saved + 1 ))
    done
  done

  # Plugin/config files may carry tokens — scan everything that was copied.
  local f
  while IFS= read -r -d '' f; do
    if ! scan_for_secrets "$f"; then
      warn "$name/${f#"$dest_dir"/} may contain secrets — review before pushing"
    fi
  done < <(find "$dest_dir" -type f -print0 2>/dev/null)

  log "Saved $name config ($saved item(s)) → $dest_dir"
}

# Calibre stores settings as JSON/plist files plus conversion presets under
# ~/Library/Preferences/calibre/ (not a defaults domain).
#
# The plugins/ directory is deliberately NOT taken wholesale. It is ~5 MB of
# which ~8 KB is settings: the rest is plugin .zip files and vendored
# third-party source (DeACSM ships copies of asn1crypto and oscrypto). All of
# that reinstalls from Calibre's plugin manager, and scanning it produced a
# dozen false "possible secret" hits in the vendored crypto libraries — ordinary
# lines that assign one password variable from another — plus null-byte warnings
# from grepping the .zips.
#
# That sentence used to carry the offending line verbatim as an example, which
# made this file trip the scanner on every push that staged it. A permanent
# false positive on a tracked file is the exact failure scan_for_secrets is
# written to avoid: it says so itself, about Keka's ExportPassword. Describe the
# shape; do not paste the literal back.
#
# Two things under plugins/ are worth keeping:
#   plugins/*.json      — per-plugin settings (deacsm.json, dedrm.json)
#   plugins/*/account   — DeACSM's activation state. Real key material: it
#                         cannot be regenerated without a re-authorization.
#
# That directory is kept on purpose: losing it costs a re-authorization. It is
# why sevmorris/mrk-prefs must stay private. The secret scanner does not flag
# it — its XML element names match none of the scanner's patterns — so this
# comment is the only thing recording that key material lives in that repo.
snapshot_pref_dir "$HOME/Library/Preferences/calibre" "calibre" "Calibre" \
  "*.json" "*.plist" "conversion" "plugins/*.json" "plugins/*/account"

# MusicBrainz Picard keeps its settings in ~/.config/MusicBrainz/Picard.ini and
# writes oauth_access_token and oauth_refresh_token into the same file. The
# secret scan caught all three INIs the first time the directory was copied, so
# it was left to Magic Backup Machine, whose mirror keeps no history. On
# 2026-09-24 that cost something: the Cover Art Archive had been switched off
# somewhere between Picard 3.0.0b1 and 3.0.0b7, and nothing could say when.
#
# So the settings are kept, and the credentials are not. picard_settings
# (lib.sh) keeps the settings sections and replaces each credential with
# <redacted>; tests/picard-settings.sh holds it to that. The copy is history to
# diff, not a restore — a rewritten INI does not restore cleanly, and the
# tokens are worth nothing to carry, since re-authorising Picard is a login —
# so post-install never reads config/picard. Magic Backup Machine still keeps
# the real file.
#
# The org.musicbrainz.Picard plist above holds none of this. It is three keys
# of macOS file-panel state: the panel's size, its last folder, its frame.
snapshot_picard(){
  local src="$HOME/.config/MusicBrainz/Picard.ini"
  local dest_dir="$LOCAL_PREFS_DIR/config/picard" tmp
  if [[ ! -f "$src" ]]; then
    log "Skipping MusicBrainz Picard settings (not found: $src)"
    return 0
  fi
  mkdir -p "$dest_dir"
  # Written aside and moved into place, so a failed read keeps the saved copy
  # rather than committing an empty one.
  tmp="$(mrk_mktemp)"
  if ! picard_settings "$src" > "$tmp"; then
    rm -f "$tmp"
    warn "failed to read MusicBrainz Picard settings — skipped"
    SNAPSHOT_SKIPPED+=("MusicBrainz Picard settings")
    return 0
  fi
  mv "$tmp" "$dest_dir/settings.ini"
  if ! scan_for_secrets "$dest_dir/settings.ini"; then
    warn "MusicBrainz Picard settings may contain secrets — review before pushing"
  fi
  log "Saved MusicBrainz Picard settings → $dest_dir/settings.ini"
}

snapshot_picard

# ── Fonts ─────────────────────────────────────────────────────────────────────

# Hand-installed fonts. None of these come from a cask, so `make brew` cannot
# put them back — without this they are simply gone after a wipe. Small enough
# (a few MB) to keep verbatim, and no font here is a secret, so no scan.
snapshot_fonts(){
  local src="$HOME/Library/Fonts"
  local dest="$LOCAL_PREFS_DIR/fonts"

  if [[ ! -d "$src" ]]; then
    log "Skipping fonts (directory not found)"
    return 0
  fi

  # Cleared first, so a font deleted on this machine also leaves the backup.
  rm -rf "$dest"
  mkdir -p "$dest"

  local count=0 f
  while IFS= read -r -d '' f; do
    if cp "$f" "$dest/"; then
      # ~/Library/Fonts has a mix of 644 and 755; the 755 ones were landing in
      # git as mode 100755. A font is data, not a program.
      chmod 644 "$dest/$(basename "$f")"
      count=$(( count + 1 ))
    fi
  done < <(find "$src" -maxdepth 1 -type f \( -iname '*.otf' -o -iname '*.ttf' \
    -o -iname '*.ttc' -o -iname '*.otc' -o -iname '*.dfont' \) -print0 2>/dev/null)

  if (( count == 0 )); then
    rmdir "$dest" 2>/dev/null || true
    log "Skipping fonts (none found)"
    return 0
  fi
  log "Saved fonts ($count file(s)) → $dest"
}

snapshot_fonts

# ── Repository manifest ───────────────────────────────────────────────────────

# Which repositories this machine has, and where they came from.
#
# pushall pushes ~/Projects, but nothing recorded what is *in* it, so a wipe
# left you reconstructing the list from memory. Two details make a manifest
# worth more than `ls`: a directory name is not always the repo name
# (PasswordGen's origin is sevmorris/ppg), and DoublEnder's private Cloud
# overlay lives in a bare repo at ~/Projects/DoublEnder-cloud.git that nothing
# else on disk points to.
#
# Remotes only. No credentials, and no repository contents.
snapshot_repos(){
  local out="$LOCAL_PREFS_DIR/repos.tsv"
  local count=0 d name remote rel
  local -a repos=() not_repos=()

  {
    printf '# Generated by snapshot-prefs. One repository per line.\n'
    printf '# name\tremote\tpath-under-HOME\tkind\n'
  } > "$out"

  # The same list pushall sweeps (project_repos in lib.sh): a repo directly in
  # ~/Projects, or one level down in a folder that is not a repo. The nested
  # ones are named by their path, "FloppyLetters/FloppyLetter2601", and
  # restore-repos creates the enclosing folder before it clones. Folders that
  # hold no repo are said out loud below rather than skipped: the manifest
  # cannot carry them, and nothing else in mrk does.
  project_repos "$HOME/Projects" repos not_repos
  for rel in ${repos[@]+"${repos[@]}"}; do
    d="$HOME/Projects/$rel"
    name="$rel"
    remote="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
    [[ -n "$remote" ]] || { warn "No origin remote for $name — not recorded"; continue; }
    printf '%s\t%s\tProjects/%s\twork\n' "$name" "$remote" "$rel" >> "$out"
    count=$(( count + 1 ))
  done

  # Bare repos sitting directly in ~/Projects, which project_repos passes
  # over. DoublEnder's overlay is the reason this loop exists; it is recorded,
  # but restore-repos deliberately will not clone it, because its working tree
  # is interleaved with the public repo.
  for d in "$HOME"/Projects/*.git; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    remote="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
    [[ -n "$remote" ]] || continue
    printf '%s\t%s\tProjects/%s\tbare\n' "${name%.git}" "$remote" "$name" >> "$out"
    count=$(( count + 1 ))
  done

  log "Saved repository manifest ($count repo(s)) → $out"
  if (( ${#not_repos[@]} > 0 )); then
    info "Not recorded, because they are not git repositories: $(printf '%s, ' "${not_repos[@]}" | sed 's/, $//')"
  fi
  return 0
}

snapshot_repos

# ── Commit and push ───────────────────────────────────────────────────────────

cd "$LOCAL_PREFS_DIR"

# Stage only snapshot outputs — never `git add .`
#
# Pathspecs, not a list of existing files: `git add -A` over a pathspec also
# stages DELETIONS. Listing found files could only ever stage adds and
# modifications, so a file dropped from the source (an uninstalled Calibre
# plugin, say) stayed in HEAD and kept being pushed, even though
# snapshot_pref_dir had already cleared it from the working tree.
#
# `:(glob)` keeps *.plist to the top level, matching the old shell glob.
add_specs=()
if compgen -G '*.plist' >/dev/null 2>&1 || \
   git ls-files --error-unmatch -- ':(glob)*.plist' >/dev/null 2>&1; then
  add_specs+=(':(glob)*.plist')
fi
if [[ -f repos.tsv ]] || git ls-files --error-unmatch -- repos.tsv >/dev/null 2>&1; then
  add_specs+=('repos.tsv')
fi
# sevmorris-apps was added in the 2026-09-02 migration and omitted here, so the
# 22 plists were exported to disk, never staged, and the commit reported success
# without them. Any new destination directory has to be added to this list —
# that is the cost of staging by pathspec rather than `git add .`, which is
# still the right trade (finding N-5).
for tree in app-support config fonts sevmorris-apps; do
  if [[ -d "$tree" ]] || git ls-files --error-unmatch -- "$tree" >/dev/null 2>&1; then
    add_specs+=("$tree")
  fi
done

if (( ${#add_specs[@]} == 0 )); then
  log "No preference files to stage."
  exit 0
fi

git add -A -- "${add_specs[@]}"

# ── Keys that change on their own ────────────────────────────────────────────

# Until 2026-09-30 any difference from the last commit made a commit, and most
# differences were apps writing their own bookkeeping: over the sixty snapshots
# before then, a plist changed in nothing but the keys below 274 times, and 12
# of the sixty commits held nothing else. A plist whose only differences are in
# these keys is left out of the commit and put back as HEAD has it. The export
# is not filtered: a plist with any other change is committed whole, these keys
# included, so post-install restores what the app wrote.
#
# FILE|KEY, both globs. FILE is the path in mrk-prefs; KEY matches a key at any
# depth, so one rule covers a uuid in every SoundSource model. Taken from what
# changed in those sixty commits, not from guesses. A key earns a place by
# changing without anyone changing a setting; a value someone moves while using
# the app (Farrago's masterVolume) or a table an app keeps of what it has seen
# with settings inside it (BetterSnapTool's BSTAppSettings) still counts.
PREFS_NOISE=(
  # Sparkle's update checks
  '*|SU*Time' '*|SU*Date' '*|SUUpdateGroupIdentifier' '*|SUUpdateRelaunchingMarker'
  # Where macOS put a window, a split view, a menu bar item or the file panel
  '*|NSWindow Frame *' '*|NSSplitView Subview Frames *' '*|NSStatusItem Preferred Position *'
  '*|NSNav*' '*|NSOSP*' '*|*[wW]indowFrame'
  # Launch counters, and Rogue Amoeba's record of the versions that have run
  '*|launchCount' '*|*LaunchCount' '*|*RunCount'
  '*|versionHighestLaunched' '*|versionLastLaunched'
  # iTerm2 marks its machine-local state NoSync itself
  'iTerm2.plist|NoSync*' 'iTerm2.plist|iTerm Version'
  'Raycast.plist|raycast-updates-lastAppUpdateCheckDate' 'Raycast.plist|raycast-updates-whatsNewItemDisplayDate'
  'Raycast.plist|raycast-updates-lastTargetCommitishInstalled' 'Raycast.plist|database_lastValidAppVersion'
  'Raycast.plist|calculator_currenciesRefresh' 'Raycast.plist|amplitudePulseAnalyticsTracker_nextHeartbeatDate'
  'Stats.plist|updater_check_ts' 'Stats.plist|support_*' 'Stats.plist|version'
  'BetterSnapTool.plist|BSTDidLaunchTime' 'BetterSnapTool.plist|BSTDidSucceedLaunchTime'
  'BetterSnapTool.plist|savedWindowInformation'
  # SoundSource gives its hotkeys and popover a new uuid and identifier at every
  # save; nothing else in them changes. An alias or bookmark is re-encoded on
  # its own too, and always sits beside the path it points at, which still counts.
  'SoundSource.plist|uuid' 'SoundSource.plist|identifier' 'SoundSource.plist|mainPopoverState'
  'SoundSource.plist|lastKnownUpdateVersion' 'SoundSource.plist|bluetoothDevicesSeen'
  'app-support/SoundSource/*|uuid' 'app-support/SoundSource/*|popoverState' 'app-support/SoundSource/*|alias'
  'app-support/Loopback/*|alias' 'app-support/Loopback/*|bookmark'
  'Farrago.plist|BoardViewSplitPositionsV2' 'Farrago.plist|boardWindow'
  'AudioHijack.plist|homeWindowState' 'AudioHijack.plist|homeWindowShown' 'AudioHijack.plist|AULastKnownViewSize'
  'Typora.plist|savedLastOpen' 'Typora.plist|initialize_ver' 'Typora.plist|verInitTime'
  'MacWhisper.plist|knownRanVersions' 'MacWhisper.plist|*Cache'
  'Thaw.plist|StaleIdentifierMissCounts' 'Thaw.plist|MenuBarItemManager.knownItemIdentifiers'
  'sevmorris-apps/io.github.sevmorris.BackupRestore.plist|MBM_lastUpdateCheckDate'
)

# plist_changes PATH... — compare each plist as staged with HEAD's copy. Prints
# "noise<TAB>PATH" for one that differs only in PREFS_NOISE keys, and
# "real<TAB>PATH<TAB>KEYS" otherwise, KEYS being the top-level keys that changed.
#
# Values are compared as what they hold, not as bytes: a value that is itself a
# plist, an NSKeyedArchiver archive or JSON is decoded first. Ice wrote the same
# JSON with its keys in a new order twelve times, and BetterSnapTool archives
# the same objects in a new order. A plist either copy of which cannot be read
# counts as changed.
plist_changes() {
  python3 - "$(printf '%s\n' "${PREFS_NOISE[@]}")" "$@" <<'PYEOF'
import fnmatch, json, plistlib, subprocess, sys

rules = [tuple(r.split("|", 1)) for r in sys.argv[1].splitlines() if "|" in r]
MISSING = object()

# An NSKeyedArchiver archive, its references resolved. An archived dictionary
# is two parallel lists, NS.keys and NS.objects, and a set is one list, in
# whatever order the app wrote them; both become order-free here, and a
# dictionary's keys become keys the rules can match.
def unarchive(d):
    objs = d["$objects"]
    def res(v, depth):
        if depth > 100:
            raise ValueError("archive too deep, or a cycle")
        if isinstance(v, plistlib.UID):
            return res(objs[v.data], depth + 1)
        if isinstance(v, list):
            return [res(x, depth + 1) for x in v]
        if not isinstance(v, dict):
            return v
        r = {k: res(x, depth + 1) for k, x in v.items()}
        ks, vs = r.get("NS.keys"), r.get("NS.objects")
        cls = r.get("$class")
        name = cls.get("$classname") if isinstance(cls, dict) else None
        if isinstance(ks, list) and isinstance(vs, list) and len(ks) == len(vs):
            if all(isinstance(k, str) for k in ks):
                return {"$class": cls, "NS.dict": dict(zip(ks, vs))}
            return {"$class": cls, "NS.pairs": sorted(([k, x] for k, x in zip(ks, vs)), key=repr)}
        if name in ("NSSet", "NSMutableSet") and isinstance(vs, list):
            r["NS.objects"] = sorted(vs, key=repr)
        return r
    return res(d.get("$top", {}), 0)

def noisy(key, pats):
    return any(fnmatch.fnmatchcase(str(key), p) for p in pats)

def norm(v, pats):
    if isinstance(v, bytes):
        try:
            if v.startswith(b"bplist"):
                d = plistlib.loads(v)
                if isinstance(d, dict) and d.get("$archiver") == "NSKeyedArchiver" and "$objects" in d:
                    d = unarchive(d)
                return ("plist", norm(d, pats))
            if v[:1] in (b"{", b"["):
                return ("json", norm(json.loads(v), pats))
        except Exception:
            pass
        return v
    if isinstance(v, dict):
        return {k: norm(x, pats) for k, x in v.items() if not noisy(k, pats)}
    if isinstance(v, list):
        return [norm(x, pats) for x in v]
    return v

def load(spec):
    r = subprocess.run(["git", "show", spec], capture_output=True)
    if r.returncode != 0:
        return None
    try:
        d = plistlib.loads(r.stdout)
    except Exception:
        return None
    return d if isinstance(d, dict) else None

for path in sys.argv[2:]:
    old, new = load("HEAD:" + path), load(":" + path)
    if old is None or new is None:
        print("real\t" + path)
        continue
    pats = [k for f, k in rules if fnmatch.fnmatchcase(path, f)]
    real = []
    for k in sorted(set(old) | set(new), key=str):
        a, b = old.get(k, MISSING), new.get(k, MISSING)
        if a == b or noisy(k, pats):
            continue
        if a is not MISSING and b is not MISSING and norm(a, pats) == norm(b, pats):
            continue
        name = " ".join(str(k).split())
        real.append(name if len(name) <= 60 else name[:59] + "…")
    print(("real\t%s\t%s" % (path, ", ".join(real))) if real else "noise\t" + path)
PYEOF
}

declare -A PLIST_KEYS=()   # path → the keys that changed, for the report
left_out=()
modified=()
while IFS= read -r -d '' f; do
  [[ "$f" == *.plist ]] && modified+=("$f")
done < <(git diff --cached --name-only --diff-filter=M -z)
if (( ${#modified[@]} > 0 )); then
  if ! command -v python3 >/dev/null 2>&1; then
    warn "python3 not found — every changed plist is committed, keys that change on their own included"
  elif changes=$(plist_changes "${modified[@]}"); then
    while IFS=$'\t' read -r kind path keys; do
      case "$kind" in
        noise) left_out+=("$path") ;;
        real)  PLIST_KEYS["$path"]="${keys:-}" ;;
      esac
    done <<< "$changes"
  else
    warn "could not compare the changed plists with the last commit — every one is committed"
  fi
fi
if (( ${#left_out[@]} > 0 )); then
  # Index and working tree both, so ~/.mrk/preferences is left clean: a file
  # left modified there would stop pull-prefs' --ff-only pull the next time
  # another Mac pushed the same file.
  git checkout -q HEAD -- "${left_out[@]}"
  log "Left out, changed only in keys that change on their own: $(printf '%s, ' "${left_out[@]}" | sed 's/, $//')"
fi

if git diff --cached --quiet; then
  # Nothing to commit is not always nothing to push. A run whose push fails
  # leaves its commit here. Until 2026-10-01 the next run that found nothing new
  # stopped at "No changes to push.", exit 0, with that commit still absent from
  # mrk-prefs, which is what the next Mac restores from. Since 2026-09-30 that
  # is the usual run: a plist that changed only in PREFS_NOISE keys is left out
  # above, where before it made a commit whose push carried the earlier one
  # (audit 20, X-1).
  unpushed=$(unpushed_count "$REAL_PREFS_DIR")
  if (( unpushed == 0 )); then
    log "No changes to push."
    exit 0
  fi
  if (( DRY_RUN )); then
    log "No changes to commit. The real run would push $unpushed commit(s) that an earlier run left unpushed."
    ok "Dry run: nothing was committed or pushed."
    exit 0
  fi
  log "No changes to commit. Pushing $unpushed commit(s) that an earlier run left unpushed."
  git push -u origin HEAD
  ok "Pushed to $PREFS_REPO"
  exit 0
fi

# report_staged — each staged file, with a modified plist's changed keys
report_staged() {
  local status path n=0 more=0
  while IFS=$'\t' read -r status path; do
    if (( ++n > 20 )); then more=$(( more + 1 )); continue; fi
    case "$status" in
      A) printf '    %s (new)\n' "$path" ;;
      D) printf '    %s (removed)\n' "$path" ;;
      *) if [[ -n "${PLIST_KEYS[$path]:-}" ]]; then
           printf '    %s: %s\n' "$path" "${PLIST_KEYS[$path]}"
         else
           printf '    %s\n' "$path"
         fi ;;
    esac
  done < <(git -c core.quotepath=off diff --cached --name-status --no-renames)
  if (( more > 0 )); then printf '    … and %d more\n' "$more"; fi
}
staged_count=$(git diff --cached --name-only | wc -l | tr -d ' ')
if (( DRY_RUN )); then
  log "Would commit $staged_count file(s):"
else
  log "Committing $staged_count file(s):"
fi
report_staged

# Scan staged snapshot files before commit/push.
#
# fonts/ is excluded. A font is an opaque binary: it cannot hold a credential
# in any form the scanner's text patterns would match, and feeding 45 of them
# to `head -c 8` inside a command substitution printed 45 "ignored null byte
# in input" warnings per run — the same noise that got Calibre's plugin .zips
# narrowed out of scope above. Excluding them here rather than teaching
# scan_for_secrets to skip binaries keeps the scanner's behaviour unchanged
# for everything else.
#
# commit_paths, not `git diff --cached --name-only --diff-filter=AM`: `git add
# -A` stages a renamed plist as R, which that filter drops unread.
staged_paths=()
if ! commit_paths staged_paths . --cached; then
  err "Could not list the staged files — nothing was committed."
  exit 1
fi
prefs_top=$(git rev-parse --show-toplevel)
changed_files=()
for f in ${staged_paths[@]+"${staged_paths[@]}"}; do
  [[ "${f#"$prefs_top"/}" == fonts/* ]] && continue
  changed_files+=("$f")
done
if (( DRY_RUN )); then
  if (( ${#changed_files[@]} > 0 )) && ! scan_for_secrets "${changed_files[@]}"; then
    warn "The real run would stop here and ask before it committed."
  fi
  ok "Dry run: nothing was committed or pushed."
  exit 0
fi
if (( ${#changed_files[@]} > 0 )); then
  require_clean_secrets "${changed_files[@]}" || exit 1
fi

git commit -m "snapshot: $(date '+%Y-%m-%d %H:%M')"
# -u origin HEAD: the init path (git init + remote add) has no upstream yet;
# on the clone path this is equivalent to a plain push.
git push -u origin HEAD
ok "Pushed to $PREFS_REPO"
