#!/usr/bin/env bash

# mrk snapshot-prefs — export current app preferences to ~/.mrk/preferences/
# and push to the private mrk-prefs repo.

# Re-exec with Homebrew bash if running under bash < 4 (macOS ships bash 3.2).
# This script uses mapfile, which bash 3.2 does not have. The failure was a
# runtime one, so neither `bash -n` nor shellcheck caught it.
if (( BASH_VERSINFO[0] < 4 )); then
  for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_brew_bash" ]] && exec "$_brew_bash" "$0" "$@"
  done
  echo "error: bash 4+ required (system bash is ${BASH_VERSION}; install via 'brew install bash')" >&2
  exit 1
fi

set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

: "${PREFS_REPO:=git@github.com:sevmorris/mrk-prefs.git}"
LOCAL_PREFS_DIR="$HOME/.mrk/preferences"
APP_SUPPORT="$HOME/Library/Application Support"

# Apps whose export failed or timed out — reported at exit, never fatal.
SNAPSHOT_SKIPPED=()
report_skipped(){
  if (( ${#SNAPSHOT_SKIPPED[@]} > 0 )); then
    warn "Skipped ${#SNAPSHOT_SKIPPED[@]} app(s) — export failed or timed out: ${SNAPSHOT_SKIPPED[*]}"
  fi
}
trap report_skipped EXIT

# Export a defaults domain with a timeout so a hung or sandboxed domain can't
# stall the whole run. Prefers timeout/gtimeout (coreutils); else background-kill.
defaults_export_timeout(){
  local bundle_id="$1" out="$2" secs="${3:-15}"
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" defaults export "$bundle_id" "$out"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" defaults export "$bundle_id" "$out"
  else
    defaults export "$bundle_id" "$out" &
    local pid=$! rc=0
    ( sleep "$secs"; kill "$pid" 2>/dev/null ) &
    local killer=$!
    wait "$pid" 2>/dev/null || rc=$?
    kill "$killer" 2>/dev/null || true
    return "$rc"
  fi
}

# Ensure the local prefs dir is a git repo pointing at mrk-prefs
if [[ ! -d "$LOCAL_PREFS_DIR/.git" ]]; then
  if [[ -d "$LOCAL_PREFS_DIR" ]]; then
    log "Initialising git repo in existing directory: $LOCAL_PREFS_DIR"
    git -C "$LOCAL_PREFS_DIR" init
    git -C "$LOCAL_PREFS_DIR" remote add origin "$PREFS_REPO"
  else
    log "Cloning $PREFS_REPO → $LOCAL_PREFS_DIR"
    git clone "$PREFS_REPO" "$LOCAL_PREFS_DIR"
  fi
fi

# ── Plist exports (defaults export) ──────────────────────────────────────────

snapshot_plist(){
  local bundle_id="$1" filename="$2" app_path="$3" name="$4"
  if [[ ! -d "$app_path" ]]; then
    log "Skipping $name (not installed)"
    return 0
  fi
  if ! defaults_export_timeout "$bundle_id" "$LOCAL_PREFS_DIR/$filename"; then
    warn "failed to export $name — skipped"
    SNAPSHOT_SKIPPED+=("$name")
    return 0
  fi
  # Convert to xml1 (as bin/snapshot does) so the secret scan reads text,
  # not binary plist data.
  if ! plutil -convert xml1 "$LOCAL_PREFS_DIR/$filename" 2>/dev/null; then
    warn "failed to convert $name export to xml1 — skipped"
    SNAPSHOT_SKIPPED+=("$name")
    return 0
  fi
  if ! scan_for_secrets "$LOCAL_PREFS_DIR/$filename"; then
    warn "$name export may contain secrets — review before pushing"
  fi
  log "Saved $name → $LOCAL_PREFS_DIR/$filename"
}

# Previously captured
snapshot_plist "com.hegenberg.BetterSnapTool"           "BetterSnapTool.plist"    "/Applications/BetterSnapTool.app"   "BetterSnapTool"
snapshot_plist "com.jordanbaird.Ice"                    "Ice.plist"               "/Applications/Ice.app"              "Ice"
snapshot_plist "com.googlecode.iterm2"                  "iTerm2.plist"            "/Applications/iTerm.app"            "iTerm2"

# Newly added
snapshot_plist "com.raycast.macos"                      "Raycast.plist"           "/Applications/Raycast.app"          "Raycast"
snapshot_plist "eu.exelban.Stats"                       "Stats.plist"             "/Applications/Stats.app"            "Stats"
snapshot_plist "com.rogueamoeba.Loopback"               "Loopback.plist"          "/Applications/Loopback.app"         "Loopback"
snapshot_plist "com.rogueamoeba.soundsource"            "SoundSource.plist"       "/Applications/SoundSource.app"      "SoundSource"
snapshot_plist "com.rogueamoeba.audiohijack"            "AudioHijack.plist"       "/Applications/Audio Hijack.app"     "Audio Hijack"
snapshot_plist "com.rogueamoeba.farrago"                "Farrago.plist"           "/Applications/Farrago.app"          "Farrago"
snapshot_plist "com.rogueamoeba.Piezo"                  "Piezo.plist"             "/Applications/Piezo.app"            "Piezo"
snapshot_plist "abnerworks.Typora"                      "Typora.plist"            "/Applications/Typora.app"           "Typora"
snapshot_plist "com.aone.keka"                          "Keka.plist"              "/Applications/Keka.app"             "Keka"
snapshot_plist "com.tclementdev.timemachineeditor.application" "TimeMachineEditor.plist" "/Applications/TimeMachineEditor.app" "TimeMachineEditor"
snapshot_plist "com.goodsnooze.MacWhisper"              "MacWhisper.plist"        "/Applications/MacWhisper.app"       "MacWhisper"

# Migrated out of Magic Backup Machine, 2026-09-02. MBM carried these inside an
# rsync mirror, which keeps the current state and no history. They are settings,
# they are tiny, and a regression in one is worth being able to diff.
snapshot_plist "net.imput.helium"                       "Helium.plist"            "/Applications/Helium.app"           "Helium"
snapshot_plist "com.descript.beachcube"                 "Descript.plist"          "/Applications/Descript.app"         "Descript"
snapshot_plist "com.WavesAudio.central"                 "WavesCentral.plist"      "/Applications/Waves Central.app"    "Waves Central"
snapshot_plist "org.musicbrainz.Picard"                 "Picard.plist"            "/Applications/MusicBrainz Picard.app" "MusicBrainz Picard"

# KeyVault (io.github.sevmorris.KeyVault) is deliberately absent, and must stay
# absent. It is a secrets manager. Its API keys and notes are self-describing
# Keychain items, not UserDefaults, so a plist export would carry no secret —
# but it would put a manifest of what the vault holds into mrk-prefs. Its SSH
# and GPG keys are not in the Keychain at all: KeyVault indexes ~/.ssh and
# ~/.gnupg, so those never had anything to do with a defaults export either.
# Nothing here can back up a KeyVault vault, and nothing here should try.
# The key files have their own script — snapshot-keys — which writes one
# encrypted archive to a path outside every directory a wipe deletes, and
# pushes nowhere. Same call already made for Bitwarden, NordPass and 1Password.

# ── My own applications ───────────────────────────────────────────────────────

# Every io.github.sevmorris.* domain, taken as a group rather than named one at
# a time. The list changes whenever I ship something new, and a hand-maintained
# list would go stale the first time that happened — check-picker-desc exists
# because that kind of list always does.
#
# Also migrated out of Magic Backup Machine. These are the preferences of
# software I wrote: a settings regression after a release is precisely what
# version history is for, and an rsync mirror cannot answer "what changed".
snapshot_own_apps(){
  local dest="$LOCAL_PREFS_DIR/sevmorris-apps"
  local f base domain found=0
  mkdir -p "$dest"
  for f in "$HOME"/Library/Preferences/io.github.sevmorris.*.plist; do
    [[ -f "$f" ]] || continue          # no match leaves the glob unexpanded
    base="$(basename "$f")"
    domain="${base%.plist}"
    if ! defaults_export_timeout "$domain" "$dest/$base"; then
      warn "failed to export $domain — skipped"
      SNAPSHOT_SKIPPED+=("$domain")
      continue
    fi
    if ! plutil -convert xml1 "$dest/$base" 2>/dev/null; then
      warn "failed to convert $domain export to xml1 — skipped"
      SNAPSHOT_SKIPPED+=("$domain")
      rm -f "$dest/$base"
      continue
    fi
    found=$(( found + 1 ))
  done
  if (( found > 0 )); then
    log "Saved $found of my own apps' preferences → $dest"
  else
    log "Skipping my own apps (no io.github.sevmorris.* domains found)"
  fi
}
snapshot_own_apps

# ── Application Support files ─────────────────────────────────────────────────

snapshot_app_support(){
  local app_name="$1" dest_subdir="$2"
  shift 2
  local files=("$@")
  local src_dir="$APP_SUPPORT/$app_name"
  local dest_dir="$LOCAL_PREFS_DIR/app-support/$dest_subdir"

  if [[ ! -d "$src_dir" ]]; then
    log "Skipping $app_name app support (directory not found)"
    return 0
  fi

  mkdir -p "$dest_dir"
  local saved=0
  for file in "${files[@]}"; do
    if [[ -f "$src_dir/$file" ]]; then
      cp "$src_dir/$file" "$dest_dir/$file"
      if ! scan_for_secrets "$dest_dir/$file"; then
        warn "$app_name/$file may contain secrets — review before pushing"
      fi
      saved=$(( saved + 1 ))
    fi
  done
  log "Saved $app_name app support ($saved file(s)) → $dest_dir"
}

# Loopback routing configurations
snapshot_app_support "Loopback" "Loopback" \
  "Devices.plist" "RecentApps.plist"

# SoundSource device presets and routing
snapshot_app_support "SoundSource" "SoundSource" \
  "Presets.plist" "CustomPresets.plist" "Sources.plist" "Models.plist"

# ── Preference directories (file trees, not defaults domains) ─────────────────

# Some apps store configuration as a tree of files under ~/Library/Preferences/
# rather than as a defaults domain, so `defaults export` captures nothing useful.
# Copy selected top-level globs and/or subdirectories verbatim into config/, then
# secret-scan each copied file. The dest is cleared first so files removed from
# the source (e.g. uninstalled plugins) don't linger in the backup.
snapshot_pref_dir(){
  local src_dir="$1" dest_subdir="$2" name="$3"
  shift 3
  local includes=("$@")

  [[ -n "$dest_subdir" ]] || { warn "snapshot_pref_dir: empty dest_subdir for $name"; return 0; }
  if [[ ! -d "$src_dir" ]]; then
    log "Skipping $name (config dir not found: $src_dir)"
    return 0
  fi

  local dest_dir="$LOCAL_PREFS_DIR/config/$dest_subdir"
  rm -rf "$dest_dir"
  mkdir -p "$dest_dir"

  local item path rel saved=0
  for item in "${includes[@]}"; do
    shopt -s nullglob
    # Intentional glob: $item is a pattern (e.g. *.json) or a literal subdir name.
    # shellcheck disable=SC2206
    local matches=( "$src_dir"/$item )
    shopt -u nullglob
    for path in "${matches[@]}"; do
      [[ -e "$path" ]] || continue
      rel="${path#"$src_dir"/}"
      mkdir -p "$dest_dir/$(dirname "$rel")"
      cp -R "$path" "$dest_dir/$rel"
      saved=$(( saved + 1 ))
    done
  done

  # Plugin/config files may carry tokens — scan everything that was copied.
  local f
  while IFS= read -r -d '' f; do
    if ! scan_for_secrets "$f"; then
      warn "$name/${f#"$dest_dir"/} may contain secrets — review before pushing"
    fi
  done < <(find "$dest_dir" -type f -print0 2>/dev/null)

  log "Saved $name config ($saved item(s)) → $dest_dir"
}

# Calibre stores settings as JSON/plist files plus conversion presets under
# ~/Library/Preferences/calibre/ (not a defaults domain).
#
# The plugins/ directory is deliberately NOT taken wholesale. It is ~5 MB of
# which ~8 KB is settings: the rest is plugin .zip files and vendored
# third-party source (DeACSM ships copies of asn1crypto and oscrypto). All of
# that reinstalls from Calibre's plugin manager, and scanning it produced a
# dozen false "possible secret" hits on lines like `password = password.encode(...)`
# in the crypto libraries, plus null-byte warnings from grepping the .zips.
#
# Two things under plugins/ are worth keeping:
#   plugins/*.json      — per-plugin settings (deacsm.json, dedrm.json)
#   plugins/*/account   — DeACSM's activation state. Real key material: it
#                         cannot be regenerated without a re-authorization.
#
# That directory is kept on purpose: losing it costs a re-authorization. It is
# why sevmorris/mrk-prefs must stay private. The secret scanner does not flag
# it — its XML element names match none of the scanner's patterns — so this
# comment is the only thing recording that key material lives in that repo.
snapshot_pref_dir "$HOME/Library/Preferences/calibre" "calibre" "Calibre" \
  "*.json" "*.plist" "conversion" "plugins/*.json" "plugins/*/account"

# ~/.config/MusicBrainz is deliberately NOT captured, though it looks like an
# obvious candidate — an INI under ~/.config, which is a dotfile in everything
# but location. Picard writes oauth_access_token and oauth_refresh_token into
# the same file as the settings, and the secret scan caught all three INIs on
# the first run after this was added. Splitting settings from credentials would
# mean rewriting the file, and a rewritten INI does not restore cleanly.
#
# Unlike the Calibre DeACSM activation below, these tokens are worth nothing to
# carry: re-authorising Picard is a login. The org.musicbrainz.Picard plist
# above holds the UI preferences and is clean, so that half is captured.
# Magic Backup Machine keeps the config directory.

# ── Fonts ─────────────────────────────────────────────────────────────────────

# Hand-installed fonts. None of these come from a cask, so `make brew` cannot
# put them back — without this they are simply gone after a wipe. Small enough
# (a few MB) to keep verbatim, and no font here is a secret, so no scan.
snapshot_fonts(){
  local src="$HOME/Library/Fonts"
  local dest="$LOCAL_PREFS_DIR/fonts"

  if [[ ! -d "$src" ]]; then
    log "Skipping fonts (directory not found)"
    return 0
  fi

  # Cleared first, so a font deleted on this machine also leaves the backup.
  rm -rf "$dest"
  mkdir -p "$dest"

  local count=0 f
  while IFS= read -r -d '' f; do
    if cp "$f" "$dest/"; then
      # ~/Library/Fonts has a mix of 644 and 755; the 755 ones were landing in
      # git as mode 100755. A font is data, not a program.
      chmod 644 "$dest/$(basename "$f")"
      count=$(( count + 1 ))
    fi
  done < <(find "$src" -maxdepth 1 -type f \( -iname '*.otf' -o -iname '*.ttf' \
    -o -iname '*.ttc' -o -iname '*.otc' -o -iname '*.dfont' \) -print0 2>/dev/null)

  if (( count == 0 )); then
    rmdir "$dest" 2>/dev/null || true
    log "Skipping fonts (none found)"
    return 0
  fi
  log "Saved fonts ($count file(s)) → $dest"
}

snapshot_fonts

# ── Repository manifest ───────────────────────────────────────────────────────

# Which repositories this machine has, and where they came from.
#
# pushall pushes ~/Projects, but nothing recorded what is *in* it, so a wipe
# left you reconstructing the list from memory. Two details make a manifest
# worth more than `ls`: a directory name is not always the repo name (Cypher's
# origin is sevmorris/FL2601), and DoublEnder's private Cloud overlay lives in
# a bare repo at ~/DoublEnder-cloud.git that nothing else on disk points to.
#
# Remotes only. No credentials, and no repository contents.
snapshot_repos(){
  local out="$LOCAL_PREFS_DIR/repos.tsv"
  local count=0 d name remote

  {
    printf '# Generated by snapshot-prefs. One repository per line.\n'
    printf '# name\tremote\tpath-under-HOME\tkind\n'
  } > "$out"

  for d in "$HOME"/Projects/*/; do
    [[ -d "$d/.git" ]] || continue
    name="$(basename "$d")"
    remote="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
    [[ -n "$remote" ]] || { warn "No origin remote for $name — not recorded"; continue; }
    printf '%s\t%s\tProjects/%s\twork\n' "$name" "$remote" "$name" >> "$out"
    count=$(( count + 1 ))
  done

  # Bare repos sitting directly in $HOME. DoublEnder's overlay is the reason
  # this loop exists; it is recorded, but restore-repos deliberately will not
  # clone it, because its working tree is interleaved with the public repo.
  for d in "$HOME"/*.git; do
    [[ -d "$d" ]] || continue
    name="$(basename "$d")"
    remote="$(git -C "$d" remote get-url origin 2>/dev/null || true)"
    [[ -n "$remote" ]] || continue
    printf '%s\t%s\t%s\tbare\n' "${name%.git}" "$remote" "$name" >> "$out"
    count=$(( count + 1 ))
  done

  log "Saved repository manifest ($count repo(s)) → $out"
}

snapshot_repos

# ── Commit and push ───────────────────────────────────────────────────────────

cd "$LOCAL_PREFS_DIR"

# Stage only snapshot outputs — never `git add .`
#
# Pathspecs, not a list of existing files: `git add -A` over a pathspec also
# stages DELETIONS. Listing found files could only ever stage adds and
# modifications, so a file dropped from the source (an uninstalled Calibre
# plugin, say) stayed in HEAD and kept being pushed, even though
# snapshot_pref_dir had already cleared it from the working tree.
#
# `:(glob)` keeps *.plist to the top level, matching the old shell glob.
add_specs=()
if compgen -G '*.plist' >/dev/null 2>&1 || \
   git ls-files --error-unmatch -- ':(glob)*.plist' >/dev/null 2>&1; then
  add_specs+=(':(glob)*.plist')
fi
if [[ -f repos.tsv ]] || git ls-files --error-unmatch -- repos.tsv >/dev/null 2>&1; then
  add_specs+=('repos.tsv')
fi
# sevmorris-apps was added in the 2026-09-02 migration and omitted here, so the
# 22 plists were exported to disk, never staged, and the commit reported success
# without them. Any new destination directory has to be added to this list —
# that is the cost of staging by pathspec rather than `git add .`, which is
# still the right trade (finding N-5).
for tree in app-support config fonts sevmorris-apps; do
  if [[ -d "$tree" ]] || git ls-files --error-unmatch -- "$tree" >/dev/null 2>&1; then
    add_specs+=("$tree")
  fi
done

if (( ${#add_specs[@]} == 0 )); then
  log "No preference files to stage."
  exit 0
fi

git add -A -- "${add_specs[@]}"

if git diff --cached --quiet; then
  log "No changes to push."
  exit 0
fi

# Scan staged snapshot files before commit/push.
#
# fonts/ is excluded. A font is an opaque binary: it cannot hold a credential
# in any form the scanner's text patterns would match, and feeding 45 of them
# to `head -c 8` inside a command substitution printed 45 "ignored null byte
# in input" warnings per run — the same noise that got Calibre's plugin .zips
# narrowed out of scope above. Excluding them here rather than teaching
# scan_for_secrets to skip binaries keeps the scanner's behaviour unchanged
# for everything else.
mapfile -t changed_files < <(git diff --cached --name-only --diff-filter=AM \
  | grep -v '^fonts/' || true)
if (( ${#changed_files[@]} > 0 )); then
  require_clean_secrets "${changed_files[@]}" || exit 1
fi

git commit -m "snapshot: $(date '+%Y-%m-%d %H:%M')"
# -u origin HEAD: the init path (git init + remote add) has no upstream yet;
# on the clone path this is equivalent to a plain push.
git push -u origin HEAD
ok "Pushed to $PREFS_REPO"
