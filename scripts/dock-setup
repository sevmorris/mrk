#!/usr/bin/env bash
set -euo pipefail

# dock-setup — Populate the Dock with preferred apps
# Run via: make dock
# Requires dockutil (installed automatically if missing).
#
# The layout is config/dock.txt: edit that file, not this script.

# Resolve symlinks so this works when called via ~/bin
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF'
dock-setup — rebuild the Dock from the preferred app layout

Usage:
  dock-setup [--dry-run | -n]
  dock-setup --check

Options:
  -n, --dry-run   Show the Dock it would build, and change nothing
      --check     Show each item of the list, and each item of the Dock that
                  the list does not have, as a line for a program to read,
                  and change nothing
  -h, --help      Show this help

dock-setup installs dockutil if that is missing, then replaces the current
Dock with the apps and folders that config/dock.txt lists, left to right;
edit that file to change the layout. Normally run as `make dock`.

--check shows one line for each item, in the order of the file, with five
fields separated by tabs: app or folder, the line as the file has it, the
path it names, present or missing, and docked, undocked or unknown. Docked
means the item is in the Dock now. Unknown means dock-setup cannot read the
Dock, because dockutil is not installed or `dockutil --list` failed.

Then one line for each file or folder in the Dock that the list does not
have, in the order of the Dock: unlisted, an empty field, its path, present
or missing, and docked. `make dock` removes these items. The Dock can also
hold a web link or a spacer, which --check does not show and `make dock` also
removes.

A tab, a newline and a backslash in a field are escaped as
config/defaults.tsv escapes them (\t, \n, \\). A later version may add
fields at the end of a line, and never removes or reorders one. It exits 0
when it can read the list, 1 when it refuses the list, and 2 for a bad option.
EOF
}

DRY_RUN=0
CHECK=0
for arg in "$@"; do
  case "$arg" in
    -n|--dry-run) DRY_RUN=1 ;;
    --check) CHECK=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; printf '\nunknown argument: %s\n' "$arg" >&2; exit 2 ;;
  esac
done

# --check is for a program to read (mrk Settings), on stdout, which holds
# nothing else: fd 3 is stdout, and everything else goes to stderr, as in
# defaults.sh --check.
if (( CHECK )); then
  exec 3>&1 1>&2
fi

# ── The layout: config/dock.txt ──────────────────────────────────────────────
#
# One path a line, left to right (mrk_config_entries). A path that ends in .app
# is an app; any other is a folder, which the Dock keeps beside the Trash. ~/
# at the start is the home directory. Read and checked whole before anything
# changes: dockutil --remove all below empties the Dock, so a missing file, an
# empty list or a line that is not a path stops the run while the Dock is
# still as it was.
#
# The list is the Dock in use on 2026-09-28, left to right (audit 15, T-14).
# Until then it was an older layout, and `make dock` would have replaced the
# live Dock with it. Finder is always first and needs no entry.
DOCK_LIST="$SCRIPT_DIR/../config/dock.txt"
if [[ ! -r "$DOCK_LIST" ]]; then
  err "Cannot read $DOCK_LIST — the Dock is unchanged."
  exit 1
fi
dock_apps=()
dock_folders=()
dock_entries=()
dock_kinds=()
dock_paths=()
while IFS= read -r entry; do
  # A carriage return, from an editor that writes CRLF, would make every app a
  # folder that does not exist, which a run skips. Refused, with every control
  # character but the tab, which a path can hold and --check escapes (audit
  # 22, Z-6).
  if [[ "${entry//$'\t'/}" == *[[:cntrl:]]* ]]; then
    err "A control character, in config/dock.txt: $(printf '%q' "$entry") — the Dock is unchanged."
    info "Each line is one path. An editor that writes CRLF line ends leaves a carriage return at the end of each line."
    exit 1
  fi
  # shellcheck disable=SC2088  # a literal ~/ in the file, expanded here
  case "$entry" in
    '~/'*) path="$HOME/${entry#\~/}" ;;
    /*)    path="$entry" ;;
    *)
      err "Not a path, in config/dock.txt: $entry — the Dock is unchanged."
      info "Each line is a full path, or a path that starts with ~/."
      exit 1
      ;;
  esac
  case "$path" in
    *.app) dock_apps+=("$path");    dock_kinds+=(app) ;;
    *)     dock_folders+=("$path"); dock_kinds+=(folder) ;;
  esac
  dock_entries+=("$entry")
  dock_paths+=("$path")
done < <(mrk_config_entries "$DOCK_LIST")
if (( ${#dock_apps[@]} == 0 )); then
  err "config/dock.txt lists no app — the Dock is unchanged."
  exit 1
fi

# real_path PATH — PATH with each symlink in it followed, and no / at the end,
# so that two names for one app compare equal. The Dock names Safari by where
# it is, /System/Volumes/Preboot/Cryptexes/App/System/Applications/Safari.app,
# and /Applications/Safari.app is a symlink to that. A path that does not
# exist stays as it is.
real_path() {
  local p=$1
  [[ "$p" == */ && "$p" != / ]] && p=${p%/}
  if [[ -d "$p" ]]; then
    (cd -P "$p" 2>/dev/null && pwd -P) || printf '%s\n' "$p"
  else
    printf '%s\n' "$p"
  fi
}

# --check: each item, in the order of the file, with the question the run asks
# of it — is the app installed, does the folder exist — and whether it is in
# the Dock now. Then each file or folder in the Dock that the list does not
# have: what `make dock` would remove. The Dock in use on 2026-10-22 held
# Signal, which the list did not, and the check could not show it. It
# installs, saves and changes nothing: no dockutil means the Dock is unknown.
#
# dockutil --list prints a tab-separated line for each item: its label, its
# URL, its section, the plist and the bundle id. A file's URL is percent
# encoded and ends in / for a folder or an app. Only persistentApps and
# persistentOthers are the Dock's own items; recentApps are not. The tabs
# become \037 before the read, because read takes two tabs as one, and a
# spacer's label and URL are empty.
if (( CHECK )); then
  docked_real=()   # the real path of each file or folder in the Dock, in order
  docked_paths=()  # the same, as the Dock names it
  dock_known=0
  if ! command -v dockutil >/dev/null 2>&1; then
    warn "dockutil not found — cannot read the Dock, so each item is unknown"
  elif dock_now=$(dockutil --list); then
    dock_known=1
    while IFS=$'\037' read -r _label url section _rest; do
      case "$section" in persistentApps|persistentOthers) ;; *) continue ;; esac
      case "$url" in file://*) ;; *) continue ;; esac
      path=${url#file://}
      path=$(printf '%b' "${path//%/\\x}")
      [[ "$path" == */ && "$path" != / ]] && path=${path%/}
      docked_paths+=("$path")
      docked_real+=("$(real_path "$path")")
    done <<< "${dock_now//$'\t'/$'\037'}"
  else
    warn "dockutil --list failed — cannot read the Dock, so each item is unknown"
  fi

  listed_real=()
  for i in "${!dock_entries[@]}"; do
    listed_real[i]=$(real_path "${dock_paths[i]}")
    if [[ -d "${dock_paths[i]}" ]]; then state=present; else state=missing; fi
    if (( ! dock_known )); then
      docked=unknown
    else
      docked=undocked
      for real in ${docked_real[@]+"${docked_real[@]}"}; do
        [[ "$real" == "${listed_real[i]}" ]] && { docked=docked; break; }
      done
    fi
    mrk_check_line "${dock_kinds[i]}" "${dock_entries[i]}" "${dock_paths[i]}" "$state" "$docked" >&3
  done
  for j in ${docked_real[@]+"${!docked_real[@]}"}; do
    for real in "${listed_real[@]}"; do
      [[ "$real" == "${docked_real[j]}" ]] && continue 2
    done
    if [[ -e "${docked_paths[j]}" ]]; then state=present; else state=missing; fi
    mrk_check_line unlisted "" "${docked_paths[j]}" "$state" docked >&3
  done
  exit 0
fi

section "Dock setup"

# A dry run reads the same list, and asks the same question of each path, as
# the run below; it installs, saves and changes nothing.
if (( DRY_RUN )); then
  dry "Would save the Dock, then delete every item from it"
  would=0
  skipped=0
  for app in "${dock_apps[@]}"; do
    name=$(basename "$app" .app)
    if [[ -d "$app" ]]; then
      dry "Would add: $name"
      (( would++ )) || true
    else
      warn "Skipped: $name (not installed)"
      (( skipped++ )) || true
    fi
  done
  for folder in ${dock_folders[@]+"${dock_folders[@]}"}; do
    folder_name=$(basename "$folder")
    if [[ -d "$folder" ]]; then
      dry "Would add: $folder_name folder, as a list"
    else
      warn "Skipped: $folder_name folder (no $folder)"
    fi
  done
  dry "$would app(s) would be added, $skipped skipped. Nothing changed."
  exit 0
fi

if ! command -v dockutil >/dev/null 2>&1; then
  log "dockutil not found — installing..."
  brew install dockutil || { err "Failed to install dockutil"; exit 1; }
fi

# Snapshot the Dock before wiping it.
#
# `dockutil --remove all` below destroys the whole arrangement, and until
# 2026-09-10 nothing recorded it. Every other mutating script in mrk writes an
# undo — defaults.sh, hardening.sh, post-install, trim-services, setup all do —
# and this one wrote none. The gap was sharpest in the rollback itself, which
# already carried seven com.apple.dock keys (tilesize, orientation, mineffect,
# …): mrk could undo the Dock's icon size but not which icons were in it.
#
# The backup is written ONCE and never refreshed. A second `make dock` would
# otherwise capture the layout this script just applied and overwrite the
# pre-mrk original with it — the re-run decay recorded as M2. defaults.sh solves
# the same problem by saving its rollback line before the idempotency check.
#
# No `defaults delete` branch, unlike post-install's plist helper: com.apple.dock
# always exists on macOS, so "there was nothing here before" is never the right
# undo for it.
STATE_DIR="${STATE_DIR:-$HOME/.mrk}"
ROLLBACK="${ROLLBACK:-$STATE_DIR/defaults-rollback.sh}"
DOCK_BACKUP_DIR="$STATE_DIR/plist-backups"
DOCK_BACKUP="$DOCK_BACKUP_DIR/com.apple.dock.plist"

init_rollback "$ROLLBACK" || exit 1
mkdir -p "$DOCK_BACKUP_DIR"

if [[ -f "$DOCK_BACKUP" ]]; then
  logskip "Dock snapshot" "already captured at $DOCK_BACKUP"
elif ! defaults export com.apple.dock "$DOCK_BACKUP" 2>/dev/null; then
  # A failed read must not become a rollback line. That is the P-3 class: an
  # unreadable domain recorded as a known state produces an undo that asserts
  # something untrue.
  rm -f "$DOCK_BACKUP"
  warn "could not snapshot com.apple.dock — no Dock rollback will be written"
else
  ok "Dock snapshot → $DOCK_BACKUP"
  if ! grep -qF "defaults import com.apple.dock " "$ROLLBACK" 2>/dev/null; then
    {
      printf 'defaults import com.apple.dock %s\n' "$(printf '%q' "$DOCK_BACKUP")"
      printf 'killall Dock >/dev/null 2>&1 || true\n'
    } >> "$ROLLBACK"
  fi
fi

log "Clearing current Dock..."
dockutil --remove all --no-restart || warn "dockutil --remove all failed"

added=0
skipped=0

for app in "${dock_apps[@]}"; do
  name=$(basename "$app" .app)
  if [[ -d "$app" ]]; then
    if dockutil --add "$app" --no-restart; then
      ok "Added: $name"
      (( added++ )) || true
    else
      warn "Failed to add: $name"
    fi
  else
    warn "Skipped: $name (not installed)"
    (( skipped++ )) || true
  fi
done

# Each folder beside the Trash: a stack, shown as a list, sorted by name.
for folder in ${dock_folders[@]+"${dock_folders[@]}"}; do
  folder_name=$(basename "$folder")
  if [[ ! -d "$folder" ]]; then
    warn "Skipped: $folder_name folder (no $folder)"
  elif dockutil --add "$folder" --view list --display stack --sort name --no-restart; then
    ok "Added: $folder_name folder"
  else
    warn "Failed to add: $folder_name folder"
  fi
done

killall Dock
log "$added app(s) added, $skipped skipped"
