#!/usr/bin/env bash
set -euo pipefail

# mrk snapshot-keys — bundle ~/.ssh, ~/.gnupg and the code-signing identities
# into one passphrase-encrypted OpenPGP archive, for carrying private key
# material to a new machine.
#
# Why this exists, and why it is not snapshot-prefs:
#
#   snapshot-prefs pushes to the mrk-prefs git repo. Private keys must never go
#   there, so this writes a single encrypted file to a path you choose and
#   pushes nothing anywhere. The two scripts deliberately share no destination.
#
#   KeyVault's own export covers the secrets KeyVault owns — its API keys and
#   its notes. It does not cover SSH or GPG keys: those live as files in ~/.ssh
#   and ~/.gnupg, and KeyVault only indexes them. This script is the other half.
#
#   The Developer ID signing identity is the item here with no recovery path at
#   all. Apple will reissue a certificate, but the private key that pairs with
#   it is generated once and never re-derivable — lose it and every released app
#   loses its signing continuity. It lives in the login Keychain, so no
#   file-tree backup catches it, which is exactly why it is bundled here.
#
# Format is symmetric OpenPGP, AES-256, ASCII-armored — the same shape KeyVault
# exports, so both halves of a transfer open with a plain `gpg -d` on any
# machine, years from now, with no mrk and no KeyVault present.

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

check_macos

# gpg asks for the passphrase through gpg-agent, and the agent has to be told
# which terminal to use. Inside the tar|gpg pipeline gpg's stdin is the pipe,
# so the agent cannot work it out on its own and dies with "Inappropriate
# ioctl for device" before any prompt appears. Capture the terminal here, at
# the top, while stdin is still the terminal — by the time the pipeline runs
# it is too late. Homebrew's default pinentry is the curses build, which is
# why this bites even on a desktop; a GUI pinentry-mac would not care.
if [[ -z "${GPG_TTY:-}" ]]; then
  if _mrk_tty=$(tty 2>/dev/null); then
    export GPG_TTY="$_mrk_tty"
  fi
fi

# Every file this script creates holds key material. 077 before anything else,
# so there is no window where the output is world-readable.
umask 077

DRY_RUN=0
FORCE=0
WITH_SIGNING=1
OUTPUT=""

usage() {
  cat >&2 <<'EOF'
Usage: snapshot-keys [-o PATH] [-n] [-f] [--no-signing]

Bundle ~/.ssh, ~/.gnupg and your code-signing identities into one
passphrase-encrypted OpenPGP archive.

  -o, --output PATH   Where to write the archive
                      (default: ~/Desktop/mrk-keys-<timestamp>.asc)
  -n, --dry-run       Show what would be bundled, write nothing
  -f, --force         Overwrite an existing output file
      --no-signing    Skip the code-signing identities (they need GUI prompts)
  -h, --help          Show this help

Restore with: restore-keys <archive>
Read without mrk: gpg -d <archive> | tar -tvf -
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -o|--output)  OUTPUT="${2:-}"; shift 2 || { err "--output needs a path"; exit 1; } ;;
    -n|--dry-run) DRY_RUN=1; shift ;;
    -f|--force)   FORCE=1; shift ;;
    --no-signing) WITH_SIGNING=0; shift ;;
    -h|--help)    usage; exit 0 ;;
    *)            err "Unknown option: $1"; usage; exit 1 ;;
  esac
done

section "Snapshot keys"

command -v gpg >/dev/null 2>&1 || {
  err "gpg not found — install it with: brew install gnupg"
  exit 1
}

# ── Choose and vet the destination ────────────────────────────────────────────

if [[ -z "$OUTPUT" ]]; then
  OUTPUT="$HOME/Desktop/mrk-keys-$(date +%Y%m%d-%H%M%S).asc"
fi

# Resolve to an absolute path without requiring the file to exist yet.
out_dir="$(cd "$(dirname "$OUTPUT")" 2>/dev/null && pwd)" || {
  err "Directory does not exist: $(dirname "$OUTPUT")"
  exit 1
}
OUTPUT="$out_dir/$(basename "$OUTPUT")"

# The archive must outlive a wipe. Everything below is deleted by nuke-mrk or
# by make uninstall, and the repo path would additionally put private keys in
# reach of a stray `git add`. Refusing here is the whole safety property of this
# script, so it is a hard error rather than a warning.
for forbidden in "$HOME/mrk" "$HOME/.mrk"; do
  if [[ "$OUTPUT" == "$forbidden"/* ]]; then
    err "Refusing to write inside $forbidden"
    info "nuke-mrk and make uninstall delete that directory — the archive must survive them."
    info "Write it to an encrypted external disk, or leave the default (~/Desktop)."
    exit 1
  fi
done

if [[ -e "$OUTPUT" ]] && (( ! FORCE )); then
  err "Output already exists: $OUTPUT"
  info "Pass --force to overwrite it, or choose another path with --output."
  exit 1
fi

# ── Collect what exists ───────────────────────────────────────────────────────

sources=()
[[ -d "$HOME/.ssh"   ]] && sources+=(".ssh")
[[ -d "$HOME/.gnupg" ]] && sources+=(".gnupg")

if (( ${#sources[@]} == 0 )); then
  err "Neither ~/.ssh nor ~/.gnupg exists — nothing to bundle."
  exit 1
fi

for s in "${sources[@]}"; do
  count=$(find "$HOME/$s" -type f 2>/dev/null | wc -l | tr -d ' ')
  # shellcheck disable=SC2088  # Literal "~/" for the reader, not a path to expand
  log "~/$s ($count files)"
done

# ── Code-signing identities ───────────────────────────────────────────────────

# Exported into a staging directory rather than straight into the tar stream,
# because `security export` writes a file and cannot write to a pipe. The .p12
# it produces is itself passphrase-encrypted — macOS asks for that passphrase in
# its own dialog, so this script never sees or handles it — which means the
# staging copy is encrypted at rest for the seconds it exists.
SIGNING_STAGE=""
SIGNING_FILE="signing-identities.p12"

cleanup_stage() { [[ -n "$SIGNING_STAGE" ]] && rm -rf "$SIGNING_STAGE"; }
trap cleanup_stage EXIT

export_signing_identities() {
  local ids
  ids=$(security find-identity -v -p codesigning 2>/dev/null | grep -c ')' || true)
  if [[ -z "$ids" || "$ids" == "0" ]]; then
    logskip "code-signing identities" "none found in the login keychain"
    return 1
  fi

  log "Code-signing identities ($ids found)"
  security find-identity -v -p codesigning 2>/dev/null \
    | sed -n 's/.*"\(.*\)"/    \1/p' >&2

  echo "" >&2
  warn "macOS will now ask twice: once to let this read the private keys,"
  info "and once to set a passphrase for the exported .p12."
  info "That .p12 passphrase is a SECOND secret. Store it with the first one —"
  info "without it the identities cannot be imported, even from a good archive."
  echo "" >&2

  SIGNING_STAGE="$(mrk_mktemp_d)"
  # No -P: `security export` itself documents that flag as insecure and prompts
  # via its own GUI instead, which keeps the passphrase out of this process.
  if ! security export -k "$HOME/Library/Keychains/login.keychain-db" \
       -t identities -f pkcs12 -o "$SIGNING_STAGE/$SIGNING_FILE" 2>/dev/null; then
    warn "Signing identity export failed or was cancelled — continuing without it."
    rm -rf "$SIGNING_STAGE"; SIGNING_STAGE=""
    return 1
  fi
  if [[ ! -s "$SIGNING_STAGE/$SIGNING_FILE" ]]; then
    warn "Signing identity export produced an empty file — continuing without it."
    rm -rf "$SIGNING_STAGE"; SIGNING_STAGE=""
    return 1
  fi
  ok "Signing identities staged for the archive"
  return 0
}

# notarytool credentials are a keychain profile, not a file, and there is no
# supported way to export one. Say so rather than leaving a silent hole: the
# release scripts break without it, and the fix is one command.
#
# Unconditional, because a notarytool profile cannot be detected. It is stored
# under an Apple-private keychain access group: `security find-generic-password`
# and `security dump-keychain` both come back empty for a profile that
# demonstrably works, and a SecItemCopyMatching probe with
# kSecUseDataProtectionKeychain returns errSecItemNotFound from an unentitled
# process. Absence of evidence here is not evidence of absence — an earlier
# version of this script tested for the item and reported a working profile as
# missing. The only real check is `xcrun notarytool history --keychain-profile
# <name>`, which is a network round-trip and does not belong in a backup script.
report_notary_profile() {
  echo "" >&2
  warn "notarytool credentials are NOT in this archive, and cannot be."
  info "A keychain profile has no export, and cannot be read by any tool but"
  info "notarytool. On the new machine, recreate each profile your release"
  info "scripts name:"
  info "  xcrun notarytool store-credentials <profile-name> \\"
  info "    --apple-id <id> --team-id <team>"
  info "Omit --password and notarytool prompts for it, keeping the app-specific"
  info "password out of your shell history."
  info "Check an existing one with: xcrun notarytool history --keychain-profile <name>"
}

# gpg-agent sockets are live endpoints, not data. tar cannot store them and
# would warn on each one. Lock files are equally worthless in a restore.
tar_excludes=(
  --exclude='.gnupg/S.*'
  --exclude='.gnupg/.#*'
  --exclude='.gnupg/*.lock'
)

if (( DRY_RUN )); then
  echo "" >&2
  dry "Would bundle: ${sources[*]}"
  if (( WITH_SIGNING )); then
    sig_count=$(security find-identity -v -p codesigning 2>/dev/null | grep -c ')' || true)
    if [[ -n "$sig_count" && "$sig_count" != "0" ]]; then
      dry "Would export $sig_count code-signing identit(ies) as $SIGNING_FILE"
    else
      dry "No code-signing identities to export"
    fi
  fi
  dry "Would write:  $OUTPUT"
  echo "" >&2
  info "Contents that would be included:"
  tar -czf - -C "$HOME" "${tar_excludes[@]}" "${sources[@]}" 2>/dev/null \
    | tar -tvf - 2>/dev/null | sed 's/^/    /' >&2 || true
  exit 0
fi

# ── Bundle and encrypt ────────────────────────────────────────────────────────

echo "" >&2
warn "This archive will hold your private keys."
info "Choose a strong passphrase, and store it in your password manager."
info "Losing the passphrase means losing the archive — there is no recovery."
echo "" >&2

if (( WITH_SIGNING )); then
  export_signing_identities || true
  report_notary_profile
fi

# A second -C adds the staged .p12 under its bare name, so it lands beside
# .ssh and .gnupg in the archive rather than under a temp path.
tar_extra=()
if [[ -n "$SIGNING_STAGE" ]]; then
  tar_extra=(-C "$SIGNING_STAGE" "$SIGNING_FILE")
fi

# tar streams straight into gpg. The plaintext tarball is never a file, so an
# interrupt or a crash cannot leave unencrypted key material behind.
tmp_out="$(mrk_mktemp)"
cleanup() { rm -f "$tmp_out"; cleanup_stage; }
trap cleanup EXIT

if ! tar -czf - -C "$HOME" "${tar_excludes[@]}" "${sources[@]}" "${tar_extra[@]}" 2>/dev/null \
   | gpg --symmetric --cipher-algo AES256 --armor --yes -o "$tmp_out"; then
  err "Encryption failed — no archive written."
  exit 1
fi

if [[ ! -s "$tmp_out" ]]; then
  err "gpg produced an empty archive — no archive written."
  exit 1
fi

# Structural check before the file is put in place: confirm gpg really wrote a
# symmetrically-encrypted message. It does not prove the passphrase is what you
# meant to type — nothing except a real decrypt can prove that.
#
# --list-packets prints the packet listing and then tries the session key
# anyway, exiting 2 with "decryption failed: Bad session key" when it cannot get
# the passphrase. Piped straight into grep under `set -o pipefail` that exit
# status won, so the check passed only because the agent still had the
# passphrase cached from the encryption a moment earlier — and would have
# discarded a good archive on any machine where it did not. The output is
# captured first so the packet listing decides, and --pinentry-mode error keeps
# the agent from raising a second dialog to reach that verdict.
packets="$(gpg --list-packets --batch --pinentry-mode error "$tmp_out" 2>&1 || true)"
if ! printf '%s' "$packets" | grep -q "symkey enc packet"; then
  err "Output is not a symmetrically-encrypted OpenPGP message — no archive written."
  exit 1
fi

mv "$tmp_out" "$OUTPUT"
chmod 600 "$OUTPUT"
trap - EXIT

size=$(du -h "$OUTPUT" | cut -f1 | tr -d ' ')
echo "" >&2
ok "Wrote $OUTPUT ($size)"
echo "" >&2
info "Next steps:"
info "  1. Copy the archive to an encrypted external disk."
info "  2. Store the passphrase in your password manager."
info "  3. On the new machine: restore-keys <archive>"
echo "" >&2
info "The archive is plain OpenPGP. To read it without mrk:"
info "  gpg -d $(basename "$OUTPUT") | tar -tvf -"
