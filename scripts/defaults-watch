#!/usr/bin/env bash
# defaults-watch — name the key a System Settings change writes.
#
# A setting changed in System Settings is the one change on this Mac that no
# mrk command records: SMAC-2's "After You Change Something" says to find the
# key with `defaults read` and add it to config/defaults.tsv by hand. Finding
# it meant guessing a domain. This snapshots every preferences domain, waits
# while the setting is changed, snapshots again, and names what changed, with
# the line config/defaults.tsv needs to keep it.
#
# Read only: it exports and compares, and writes nothing but its own scratch
# directory. Runs under the bash 3.2 macOS ships.
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF'
defaults-watch — name the key a System Settings change writes

Usage:
  defaults-watch [--seconds N]

Options:
      --seconds N  Wait N seconds between the two snapshots instead of for
                   Return, for a change made by a script or without a terminal
  -h, --help       Show this help

defaults-watch snapshots every preferences domain: yours, as `defaults
domains` lists them with NSGlobalDomain, the ones for this Mac alone
(-currentHost), and the readable files in /Library/Preferences, which hold
settings for all users. It waits while you change one setting, snapshots
again, and prints each key that changed, with its old and new value.

For a key config/defaults.tsv already lists, it says whether the new value
is the one mrk sets, or that config/defaults-skip.tsv skips the key, so
make defaults leaves it as it is. For any other, it shows the line of config/defaults.tsv
that would keep it, and says that check-defaults-desc will then want its
description in docs/defaults/descriptions.tsv. Window positions, timestamps
and launch counters are listed apart, as probably not the setting. It changes
nothing.
EOF
}

WAIT=""
while (($#)); do
  case "$1" in
    --seconds)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { usage >&2; printf '\n--seconds needs a whole number\n' >&2; exit 2; }
      WAIT=$2; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; printf '\nunknown argument: %s\n' "$1" >&2; exit 2 ;;
  esac
done

check_macos
for cmd in defaults python3; do
  command -v "$cmd" >/dev/null 2>&1 || { err "$cmd not found"; exit 1; }
done
if [[ -z "$WAIT" && ! -t 0 ]]; then
  err "No terminal to wait at for Return. Give --seconds N to wait that long instead."
  exit 2
fi

DEFAULTS_TSV="$REPO_ROOT/config/defaults.tsv"
SKIP_TSV="$REPO_ROOT/config/defaults-skip.tsv"
SYSTEM_PREFS="${DEFAULTS_WATCH_SYSTEM_DIR:-/Library/Preferences}"

W=$(mrk_mktemp_d) || exit 1
trap 'rm -rf "$W"' EXIT

# domains [-currentHost] — one domain per line, as `defaults domains` lists
# them. Returns 1 when defaults fails, which is not the same as listing none.
domains() {
  local out
  out=$(defaults "$@" domains) || return 1
  printf '%s\n' "$out" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$' || true
}

# export_all DIR KIND [-currentHost] — export each domain DIR/KIND.names lists
# to DIR/KIND/<line>.plist, eight at a time: one at a time, 700 domains take
# over ten seconds, and a setting is easier to change with the snapshot done.
# Numbered, not named, so a domain with a / in it cannot write elsewhere.
export_all() {
  local dir=$1 kind=$2 host=${3:-} n=0 d
  mkdir -p "$dir/$kind"
  # shellcheck disable=SC2016  # $1 to $4 are expanded by the sh xargs starts
  while IFS= read -r d; do
    n=$((n + 1))
    printf '%s\0%s\0' "$n" "$d"
  done < "$dir/$kind.names" |
    xargs -0 -n 2 -P 8 sh -c '
      if [ -n "$1" ]; then defaults -currentHost export "$4" "$2/$3.plist"
      else defaults export "$4" "$2/$3.plist"; fi 2>/dev/null || true' sh "$host" "$dir/$kind"
}

# snapshot DIR — your domains, this Mac's, and the readable system ones.
snapshot() {
  local dir=$1 f list
  mkdir -p "$dir/system"
  if ! list=$(domains); then
    err "defaults domains failed, so there is nothing to compare. Nothing was changed."
    return 1
  fi
  { echo NSGlobalDomain; [[ -z "$list" ]] || printf '%s\n' "$list"; } > "$dir/user.names"
  domains -currentHost > "$dir/host.names" || : > "$dir/host.names"
  export_all "$dir" user
  export_all "$dir" host -currentHost
  for f in "$SYSTEM_PREFS"/*.plist; do
    [[ -f "$f" && -r "$f" ]] && cp "$f" "$dir/system/" 2>/dev/null || true
  done
  return 0
}

log "Snapshotting your preferences…"
snapshot "$W/before" || exit 1
users=$(wc -l < "$W/before/user.names" | tr -d ' ')
hosts=$(wc -l < "$W/before/host.names" | tr -d ' ')
info "$users domains of yours, $hosts for this Mac alone, and the readable ones in $SYSTEM_PREFS"

if [[ -n "$WAIT" ]]; then
  log "Waiting $WAIT second(s) for the change…"
  sleep "$WAIT"
else
  printf '\n  Change the setting in System Settings now, then press Return. ' >&2
  read -r _ </dev/tty || true
  printf '\n' >&2
fi

log "Snapshotting again, and comparing…"
snapshot "$W/after" || exit 1

python3 - "$W/before" "$W/after" "$DEFAULTS_TSV" "$SYSTEM_PREFS" "$(printf '%s\n' "${MRK_SELF_CHANGING_KEYS[@]}")" "$SKIP_TSV" <<'PYEOF'
import datetime, fnmatch, os, plistlib, re, shlex, sys

before, after, defaults_tsv, system_dir = sys.argv[1:5]
skip_tsv = sys.argv[6]

# Keys an app or System Settings itself rewrites, not settings. The first part
# is MRK_SELF_CHANGING_KEYS in lib.sh, the list snapshot-prefs leaves out of a
# commit. A toolbar's layout is this script's own addition, as it was before
# the two lists became one: here a key is only listed apart, never dropped, so
# the bar for calling one noise is lower than it is there.
NOISE = sys.argv[5].splitlines() + ["NSToolbar Configuration *"]
WRITABLE = (bool, int, float, str)


def load(root, kind):
    out = {}
    if kind == "system":
        d = os.path.join(root, "system")
        for f in sorted(os.listdir(d)):
            if f.endswith(".plist"):
                v = read(os.path.join(d, f))
                if v is not None:
                    out[f[:-len(".plist")]] = v
        return out
    path = os.path.join(root, kind + ".names")
    names = open(path, encoding="utf-8").read().splitlines() if os.path.exists(path) else []
    for i, name in enumerate(names, 1):
        v = read(os.path.join(root, kind, f"{i}.plist"))
        if v is not None:
            out[name] = v
    return out


def read(path):
    try:
        with open(path, "rb") as f:
            v = plistlib.load(f)
    except Exception:
        return None
    return v if isinstance(v, dict) else None


HOME = os.path.expanduser("~")
ESCAPES = {"t": "\t", "n": "\n", "\\": "\\"}


def unescape(field):
    """A field of config/defaults.tsv as text, or None for a stray backslash."""
    out, i = [], 0
    while i < len(field):
        if field[i] != "\\":
            out.append(field[i])
            i += 1
        elif field[i + 1:i + 2] in ESCAPES:
            out.append(ESCAPES[field[i + 1]])
            i += 2
        else:
            return None
    return "".join(out)


def escape(text):
    return text.replace("\\", "\\\\").replace("\t", "\\t").replace("\n", "\\n")


def table(path):
    """(domain, key) -> (line, type, value, when, section) for each line of
    config/defaults.tsv. A line that is not six fields is left out:
    defaults.sh and make check say what is wrong with it."""
    out = {}
    try:
        lines = open(path, encoding="utf-8").read().split("\n")
    except OSError:
        return out
    for no, line in enumerate(lines, 1):
        if line.startswith("#") or not line.strip():
            continue
        fields = [unescape(f) for f in line.split("\t")]
        if len(fields) == 6 and None not in fields:
            out.setdefault((fields[0], fields[1]), (no, *fields[2:]))
    return out


def skips(path):
    """(domain, key) for each line of config/defaults-skip.tsv, the keys
    defaults.sh does not write. A line that is not two fields is left out:
    defaults.sh and make check say what is wrong with it."""
    out = set()
    try:
        lines = open(path, encoding="utf-8").read().split("\n")
    except OSError:
        return out
    for line in lines:
        if line.startswith("#") or not line.strip():
            continue
        fields = [unescape(f) for f in line.split("\t")]
        if len(fields) == 2 and None not in fields:
            out.add(tuple(fields))
    return out


def row(dom, key, v, when, section):
    """A line of config/defaults.tsv that sets KEY to V. A path in the home
    directory is written with ~/, as the file writes one, so the line suits
    another Mac."""
    val = wvalue(v)
    if isinstance(v, str) and val.startswith(HOME + "/"):
        val = "~/" + val[len(HOME) + 1:]
    return "\t".join(escape(f) for f in (dom, str(key), wtype(v), val, when, section))


def show(v):
    if v is None:
        return "(absent)"
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return repr(v)
    if isinstance(v, str):
        return '"' + v + '"'
    if isinstance(v, datetime.datetime):
        return v.isoformat()
    if isinstance(v, bytes):
        return f"<data, {len(v)} bytes>"
    if isinstance(v, list):
        return f"<array of {len(v)}>"
    if isinstance(v, dict):
        return f"<dict of {len(v)}>"
    return repr(v)


def wtype(v):
    return {bool: "bool", int: "int", float: "float", str: "string"}[type(v)]


def wvalue(v):
    if isinstance(v, bool):
        return "true" if v else "false"
    return str(v)


def q(s):
    """Quote a word for a shell command, with double quotes, and only when it
    needs them."""
    if s and re.fullmatch(r"[A-Za-z0-9._/:@%+=-]+", s):
        return s
    return '"' + re.sub(r'(["\\$`])', r"\\\1", s) + '"'


def same(written_type, written_value, v):
    if written_type == "string" and written_value.startswith("~/"):
        written_value = HOME + written_value[1:]
    if written_type == "bool":
        return isinstance(v, bool) and v == (written_value == "true")
    if written_type == "int":
        return isinstance(v, int) and not isinstance(v, bool) and str(v) == written_value
    if written_type == "float":
        try:
            return isinstance(v, (int, float)) and not isinstance(v, bool) and float(written_value) == float(v)
        except ValueError:
            return False
    return isinstance(v, str) and v == written_value


def nested(a, b, path, out, limit=6):
    if len(out) >= limit or a == b:
        return
    if isinstance(a, dict) and isinstance(b, dict):
        for k in sorted(set(a) | set(b), key=str):
            nested(a.get(k), b.get(k), path + [str(k)], out, limit)
    elif isinstance(a, list) and isinstance(b, list) and len(a) == len(b):
        for i, (x, y) in enumerate(zip(a, b)):
            nested(x, y, path + [str(i)], out, limit)
    else:
        out.append(("/".join(path), a, b))


def noisy(key, old, new):
    return (any(fnmatch.fnmatchcase(str(key), p) for p in NOISE)
            or isinstance(new, datetime.datetime) or isinstance(old, datetime.datetime))


written = table(defaults_tsv)
skipped = skips(skip_tsv)
changes = []
for kind in ("user", "host", "system"):
    a, b = load(before, kind), load(after, kind)
    for dom in sorted(set(a) | set(b)):
        da, db = a.get(dom, {}), b.get(dom, {})
        for key in sorted(set(da) | set(db), key=str):
            old, new = da.get(key), db.get(key)
            if old != new:
                changes.append((kind, dom, key, old, new))

real = [c for c in changes if not noisy(c[2], c[3], c[4])]
noise = [c for c in changes if noisy(c[2], c[3], c[4])]

if not changes:
    print("\nNo preference changed. A setting that is not a preference — a login item,")
    print("a network or account setting, a privacy permission — is not stored here.")
    sys.exit(0)

where = {"user": "", "host": "  (this Mac only: -currentHost)", "system": "  (all users: " + system_dir + ")"}
for kind, dom, key, old, new in real:
    print(f"\n{dom}  {key}{where[kind]}")
    print(f"    {show(old)} → {show(new)}")
    if isinstance(old, (dict, list)) or isinstance(new, (dict, list)):
        paths = []
        nested(old, new, [str(key)], paths)
        for p, x, y in paths:
            print(f"      {p}: {show(x)} → {show(y)}")
    w = written.get((dom, key)) if kind == "user" else None
    if w:
        line, wt, wv, when, section = w
        if new is not None and same(wt, wv, new):
            print(f"    config/defaults.tsv line {line} sets {show(new)}: this is the value mrk sets.")
        elif (dom, str(key)) in skipped:
            print(f"    config/defaults.tsv line {line} sets {wt} {wv}, but config/defaults-skip.tsv skips the key,")
            print("    so make defaults leaves it as it is.")
        else:
            print(f"    config/defaults.tsv line {line} sets {wt} {wv}, so make defaults would put that back.")
            if isinstance(new, WRITABLE):
                print(f"    To keep {show(new)} instead, change that line to this, with a tab between fields:")
                print(f"      {row(dom, key, new, when, section)}")
            print("    Or skip the key, so that make defaults leaves it as it is:")
            print(f"      mrk-defaults --skip {shlex.quote(dom)} {shlex.quote(str(key))}")
        continue
    if new is None:
        flag = "-currentHost " if kind == "host" else ""
        target = os.path.join(system_dir, dom) if kind == "system" else dom
        sudo = "sudo " if kind == "system" else ""
        print("    Now absent. mrk-defaults cannot delete a key; to remove it on another Mac:")
        print(f"      {sudo}defaults {flag}delete {q(target)} {q(str(key))}")
        continue
    if not isinstance(new, WRITABLE):
        print(f"    A {show(new)}: config/defaults.tsv holds bool, int, float and string only, so")
        print("    this one would have to be written with defaults write by hand.")
        continue
    if kind == "host":
        print("    config/defaults.tsv cannot hold a -currentHost key; hardening.sh writes its one with:")
        print(f"      defaults -currentHost write {q(dom)} {q(str(key))} -{wtype(new)} {q(wvalue(new))}")
    elif kind == "system":
        print("    A setting for all users. mrk-defaults writes only your own preferences;")
        print("    hardening.sh writes the system ones, with:")
        print(f"      sudo defaults write {q(os.path.join(system_dir, dom))} {q(str(key))} -{wtype(new)} {q(wvalue(new))}")
    else:
        # The section of the first line for the same domain, as a start;
        # Applications is the file's own section for an app's key.
        section = next((w[4] for (d, _), w in written.items() if d == dom), "Applications")
        print("    Not in config/defaults.tsv. To keep it, add this line to it, with a tab between fields:")
        print(f"      {row(dom, key, new, 'always', section)}")
        print("    and add its description to docs/defaults/descriptions.tsv, which check-defaults-desc requires.")

if noise:
    print("\nAlso changed, and probably not the setting:")
    for kind, dom, key, old, new in noise:
        print(f"    {dom}  {key}{where[kind]}")
if not real:
    print("\nNothing but those changed. A setting that is not a preference — a login item,")
    print("a network or account setting, a privacy permission — is not stored here.")
PYEOF
