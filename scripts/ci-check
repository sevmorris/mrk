#!/usr/bin/env bash
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF'
ci-check — run every gate this repository checks before a push

Usage:
  ci-check

Options:
  -h, --help      Show this help

ci-check takes no options other than --help. It runs check-picker-desc,
check-defaults-desc, a secret scan over every tracked file, check-commit-gates,
the cleanempties, defaults-rollback, hardening-rollback, macos-updates,
restore-keys, install-all, new-mac, pinned-downloads, sync-login-items, sync,
check-picker-desc, topgrade-npm, picard-settings, snapshot-prefs, plist-import-order, setup-safety, undo-files,
dock-setup, clear-app-caches, zshrc-nvm, check-updates, defaults-watch, home-makefile, update-verdict, update-full, maintain, install-apps, make-pull, gitconfig and docs-drift tests in tests/, shellcheck over every tracked bash script,
and `go test` for each
directory under tools/. It stops at the first gate that fails, so a red gate early on means
the later ones did not run.
EOF
}
mrk_help_guard "$(usage)" "$@"

log "check-picker-desc"
"$SCRIPT_DIR/check-picker-desc"

log "check-defaults-desc"
"$SCRIPT_DIR/check-defaults-desc"

# Scan every TRACKED file, not just the staged ones.
#
# mrk-push and pushall already gate a commit on scan_for_secrets, but they see
# only what is being staged. A file that trips the scanner and is then committed
# stays tripped: it flags on every future push that touches it, and the person
# pushing learns to answer yes. scan_for_secrets says as much about itself,
# where it declines to flag Keka's ExportPassword — "flagging those trains the
# user to dismiss the gate".
#
# That had already happened. A comment in scripts/snapshot-prefs quoted an
# example secret assignment verbatim while explaining false positives, so the
# file flagged itself on every push that staged it.
log "secret scan (tracked files)"
# -z: without it git C-quotes an unusual name, "caf\303\251.txt" fails the -f
# test below, and the file drops out of the scan without a word.
scan_files=()
while IFS= read -r -d '' f; do
  [[ -f "$REPO_ROOT/$f" ]] && scan_files+=("$REPO_ROOT/$f")
done < <(git -C "$REPO_ROOT" ls-files -z)
if (( ${#scan_files[@]} == 0 )); then
  err "secret scan matched no tracked files — the gate would pass vacuously"
  exit 1
fi
if ! scan_for_secrets "${scan_files[@]}"; then
  # Not a count of flagged files — scan_for_secrets reports each hit above and
  # returns a single non-zero for the batch, so any number here would be the
  # number scanned, wearing the word "flagged".
  err "secret scan found possible secrets in the tracked files — see the lines above"
  err "If this is a false positive, reword the line: a permanent hit trains you to ignore the gate."
  exit 1
fi
ok "secret scan clean (${#scan_files[@]} tracked files)"

# The scan above covers what is already committed; this covers what the
# commit paths let through — pushall, mrk-push, and the helpers snapshot-prefs
# shares with them — by planting secrets and conflicts in throwaway repos.
log "check-commit-gates"
"$SCRIPT_DIR/check-commit-gates"

# cleanempties (ce) in dotfiles/.aliases moves folders to the Trash, and until
# 2026-09-11 it broke git repositories and could loop forever. The test lives in
# tests/ rather than scripts/, which setup links into ~/bin, and runs under an
# interactive zsh because that is the only shell .aliases loads in.
log "cleanempties"
zsh -f -i "$REPO_ROOT/tests/cleanempties.zsh"

# The undo script make defaults writes, round-tripped on a plist in a temporary
# directory: until 2026-09-11 it restored 7 of 23 kinds of value wrongly.
log "defaults rollback"
"$REPO_ROOT/tests/defaults-rollback.sh"

# harden, run against a sandbox with every system path redirected: until
# 2026-09-11 its password-on-wake step changed nothing macOS reads, and its undo
# left three settings changed.
log "hardening rollback"
"$REPO_ROOT/tests/hardening-rollback.sh"

# macos-updates, against a stubbed softwareupdate, and a guard that nothing
# else calls softwareupdate with --all: until 2026-09-16 `make updates` and
# update-full ran `softwareupdate -ia`, which on macOS 26.7 started
# downloading macOS 27.
log "macOS updates"
"$REPO_ROOT/tests/macos-updates.sh"

# restore-keys, against throwaway HOMEs and a real gpg: until 2026-09-17 gpg ran
# while ~/.gnupg was moved aside, made a new one holding `use-keyboxd`, and the
# restored pubring.kbx went unread. On the 2026-09-15 migration that left
# Homebrew's gpg and GPG Suite's reading two different keyrings.
log "restore-keys"
"$REPO_ROOT/tests/restore-keys.sh"

# mrk-install --all, against a stubbed make: until 2026-09-18 it ran the three
# phases itself and skipped what make all does around them. It now runs make all.
log "install --all"
"$REPO_ROOT/tests/install-all.sh"

# setup and brew as a new Mac runs them: under /bin/bash, with no Homebrew and
# curl, brew and gum stubbed. Until 2026-09-27 both demanded Homebrew's bash
# and exited 1 without it, so neither could run on the Mac it was for — and
# brew is the phase that installs Homebrew. Also build-tools with Homebrew off
# PATH, as make all runs it after Phase 2: until 2026-09-27 "Go is not installed".
log "new Mac (bash 3.2, no Homebrew)"
"$REPO_ROOT/tests/new-mac.sh"

# git_clone_pinned, against repositories built on the spot: until 2026-09-18 nvm
# arrived by piping its install script into bash and the zsh plugins by tag
# alone. Also guards that no script pipes a download into a shell.
log "pinned downloads"
"$REPO_ROOT/tests/pinned-downloads.sh"

# sync-login-items, on a copy of the repository with osascript and gum stubbed:
# until 2026-09-18 it wrote an app named with $, a backtick, a backslash or a
# quote correctly and then could not read it back, so it re-added it every run.
log "sync-login-items"
"$REPO_ROOT/tests/sync-login-items.sh"

# sync, on a copy of the repository with brew, mrk-picker and gum stubbed and
# fake apps under a throwaway HOME: until 2026-09-27 it put every cask in one
# section and wrote no picker description, so each add turned check-picker-desc
# red until the package was described by hand.
log "sync"
"$REPO_ROOT/tests/sync.sh"

# check-picker-desc --fix, and mrk-push and pushall running it, on copies of the
# repository edited as Barkeep edits the Brewfile: until 2026-09-27 a package
# added in Barkeep got no description, and turned check-picker-desc red.
log "check-picker-desc --fix"
"$REPO_ROOT/tests/check-picker-desc.sh"

# topgrade's npm steps, with a stub nvm in a throwaway HOME: until 2026-09-23
# they sourced nvm from Homebrew's prefix, where mrk never installs it, and
# found npm only when the shell that started topgrade had loaded nvm already.
log "topgrade npm steps"
"$REPO_ROOT/tests/topgrade-npm.sh"

# picard_settings, on an INI holding fake credentials: from 2026-09-24
# snapshot-prefs keeps Picard's settings, which share a file with its OAuth
# tokens. The secret scan cannot stand behind the filter — none of its patterns
# names fanart.tv's client_key — so this test does.
log "Picard settings"
"$REPO_ROOT/tests/picard-settings.sh"

# snapshot-prefs under a throwaway HOME, with defaults stubbed and a scratch
# mrk-prefs: a plist that changed only in keys that change on their own is left
# out, a commit holding nothing else is not made, and --dry-run writes nothing.
# Until 2026-09-30 every such difference made a commit.
log "snapshot-prefs"
"$REPO_ROOT/tests/snapshot-prefs.sh"

# post-install whole, on a copy of the repository with defaults stubbed to keep
# every domain in a scratch directory: until 2026-09-27 its app-defaults scripts
# ran before the plist imports, so six apps' saved preferences were never
# imported on a new Mac. Audit 19, W-2. Also a Mac with Homebrew off PATH, as
# after Phase 2 in make all, where until 2026-09-27 it skipped topgrade, pyenv
# and pinentry-mac as not installed. Audit 19, W-31.
log "plist import order"
"$REPO_ROOT/tests/plist-import-order.sh"

# setup and post-install on a copy of the repository under a throwaway HOME:
# until 2026-09-27 they linked ~ into whichever checkout ran them, linked any
# directory in dotfiles/ (and moved ~/.claude aside for it), and a dry run
# opened installers, ran sudo and chsh. Audit 19, W-4, W-5, W-7, W-11.
log "setup safety"
"$REPO_ROOT/tests/setup-safety.sh"

# uninstall, nuke-mrk, trim-services and setup's login message, with their undo
# scripts run through stubs: until 2026-09-27 the services undo was never
# offered and nuke-mrk trashed it, the defaults undo deleted every imported
# app's preferences unasked, trim-services could empty its undo file, and a
# second setup run made the login-message undo restore mrk's own message.
# Audit 19, W-3, W-8, W-9, W-13.
log "undo files"
"$REPO_ROOT/tests/undo-files.sh"

# make dock, with dockutil stubbed: every app in DOCK_APPS added in order, the
# folder only when it exists, a missing app skipped. Until 2026-09-28 the list
# was not the Dock in use, and make dock would have replaced it. Audit 15, T-14.
log "dock setup"
"$REPO_ROOT/tests/dock-setup.sh"

# clear-app-caches under a scratch HOME: every HTTP, code and Slack cache it
# names cleared, the browsers' GPU caches and profile data left. Until
# 2026-09-28 it cleared Helium's GPU caches daily and at login, which only made
# Helium recompile them. Audit 18.
log "clear app caches"
"$REPO_ROOT/tests/clear-app-caches.sh"

# .zshrc's nvm block in a bare zsh, with a stub nvm: loaded with --no-use and
# the default alias's newest Node put on PATH directly, nvm use only as the
# fallback. Until 2026-09-28 every shell paid about 220 ms for nvm use. Audit 18.
log "zshrc nvm"
"$REPO_ROOT/tests/zshrc-nvm.sh"

# check-updates in a pseudo-terminal, against a scratch origin, under a
# throwaway HOME with fetch and make stubbed: compared at every shell start,
# fetched at most once a day, asked once for each remote head, and never on a
# branch other than the default. Until 2026-09-30 it ran at most once a week.
log "check updates"
"$REPO_ROOT/tests/check-updates.sh"

# defaults-watch against a stub defaults whose second snapshot differs from its
# first: each kind of change named, with what defaults.sh does about it, and
# nothing written. New on 2026-09-30: until then a System Settings change was
# the one change nothing recorded.
log "defaults watch"
"$REPO_ROOT/tests/defaults-watch.sh"

# ~/Makefile against a stub ~/mrk: every target of ~/mrk's Makefile forwarded
# from the home, with its ARGS. Until 2026-09-30 only eleven were, and
# `make update` from ~ found no rule.
log "home Makefile"
"$REPO_ROOT/tests/home-makefile.sh"

# make update against a stub topgrade: its last word says which steps failed and
# that the rest ran, or that the run stopped before its summary. Until
# 2026-09-30 a run with one failed cask ended on "make: *** [update] Error 1".
log "update verdict"
"$REPO_ROOT/tests/update-verdict.sh"

# update-full with every command it reaches stubbed: its eight steps in order,
# step 1 pulling with PULL_BUILD=0 and step 4 through run_topgrade. Until
# 2026-10-01 no test ran it, and a copy that ran plain topgrade again passed
# every gate here. Audit 20, X-11.
log "update-full"
"$REPO_ROOT/tests/update-full.sh"

# maintain --dry-run: its build check names each Go tool as up to date, older
# than its source or not installed, by tool_freshness in lib.sh, and a dry run
# calls neither gh, git nor make. Audit 20, X-11.
log "maintain"
"$REPO_ROOT/tests/maintain.sh"

# install-apps with curl, gh and hdiutil stubbed: a private repo gh cannot
# reach yet is a skip, not a failure; a 403 or no network still fails. Until
# 2026-09-28 the 404 failed, and on a new Mac that stopped make all before
# build-tools. Audit 11, R-2.
log "install apps"
"$REPO_ROOT/tests/install-apps.sh"

# make pull against a scratch origin, under a throwaway HOME with go stubbed:
# each pulled change to tools/, scripts/, bin/ or dotfiles/ rebuilt or relinked,
# and a docs-only pull left alone. Until 2026-09-30 make pull only fast-forwarded,
# and new tools, scripts and dotfiles waited for a make target run by hand.
log "make pull"
"$REPO_ROOT/tests/make-pull.sh"

# dotfiles/.gitconfig as the global config of a throwaway HOME: local-branches
# names exactly the branches with no upstream, with colour on or off, and git
# writes no escape codes into a pipe. Until 2026-10-04 color.ui was always, and
# local-branches listed branches that had an upstream. Audit 21, Y-1.
log "gitconfig"
"$REPO_ROOT/tests/gitconfig.sh"

# The hand-written lists of commands, targets and tests, against the repository:
# until 2026-09-28 the manual listed three ~/Makefile targets that did not
# exist, make check's help and the manual's row missed half the tests, and BIN-1
# said 39 entries where it had 41. Audit 19, W-26, W-27, W-28. Since
# 2026-09-28 it also holds README's and the manual's defaults key count to
# check-defaults-desc's (audit 15, T-3).
log "docs drift"
"$REPO_ROOT/tests/docs-drift.sh"

if command -v shellcheck >/dev/null 2>&1; then
  log "shellcheck"
  # Every tracked file whose first line names bash, wherever it lives. Until
  # 2026-09-28 this listed directories, and the six app-defaults scripts in
  # assets/ that post-install runs were never checked (audit 19, W-30).
  scripts=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && scripts+=("$f")
  done < <(
    git -C "$REPO_ROOT" ls-files \
      | while IFS= read -r f; do
          [[ -f "$REPO_ROOT/$f" ]] && head -1 "$REPO_ROOT/$f" | grep -qE '^#!.*bash' && printf '%s\n' "$REPO_ROOT/$f"
        done
  )
  if ((${#scripts[@]} > 0)); then
    shellcheck -x "${scripts[@]}"
  fi
else
  warn "shellcheck not installed — skipping (brew install shellcheck)"
fi

# go is required, not optional, and this deliberately does NOT mirror the
# warn-and-skip above it. shellcheck may be skipped because its absence removes
# a lint; skipping `go test` would remove the tests while still printing "All
# checks passed". That exact shape already cost four days on 2026-09-05, when a
# red gate earlier in this file meant the picker tests never ran and nobody
# noticed. A gate that cannot run its tests must say so and fail.
if ! command -v go >/dev/null 2>&1; then
  err "go is not installed — cannot run the tool tests"
  info "  install it with: brew install go   (it is in the Brewfile, so 'make brew' covers it)"
  exit 1
fi

# Every module under tools/, from its go.mod, so a new one is tested without an
# edit here; make tidy reads the same list (audit 19, W-25).
for gomod in "$REPO_ROOT"/tools/*/go.mod; do
  dir=$(basename "$(dirname "$gomod")")
  log "go test: tools/$dir"
  # -count=1: no cached result. mrk-status's tests run scripts/lib.sh and
  # read scripts/sync, which Go does not count as the test's inputs, and on
  # 2026-09-30 a cached pass hid a deliberate break in lib.sh's tool_freshness.
  (cd "$REPO_ROOT/tools/$dir" && go test -count=1 ./...)
done

ok "All checks passed"
