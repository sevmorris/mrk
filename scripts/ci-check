#!/usr/bin/env bash
set -euo pipefail

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF'
ci-check — run every gate this repository checks before a push

Usage:
  ci-check

Options:
  -h, --help      Show this help

ci-check takes no options other than --help. It runs check-picker-desc, check-
defaults-desc, shellcheck over the tracked scripts, and `go test` for each
directory under tools/. It stops at the first gate that fails, so a red gate
early on means the later ones did not run.
EOF
}
mrk_help_guard "$(usage)" "$@"

log "check-picker-desc"
"$SCRIPT_DIR/check-picker-desc"

log "check-defaults-desc"
"$SCRIPT_DIR/check-defaults-desc"

if command -v shellcheck >/dev/null 2>&1; then
  log "shellcheck"
  scripts=()
  while IFS= read -r f; do
    [[ -n "$f" ]] && scripts+=("$f")
  done < <(
    git -C "$REPO_ROOT" ls-files 'scripts/*' 'bin/*' \
      | while IFS= read -r f; do
          [[ -f "$REPO_ROOT/$f" ]] && head -1 "$REPO_ROOT/$f" | grep -qE '^#!.*bash' && printf '%s\n' "$REPO_ROOT/$f"
        done
  )
  if ((${#scripts[@]} > 0)); then
    shellcheck -x "${scripts[@]}"
  fi
else
  warn "shellcheck not installed — skipping (brew install shellcheck)"
fi

for dir in picker mrk-status mrk-menu theme; do
  log "go test: tools/$dir"
  (cd "$REPO_ROOT/tools/$dir" && go test ./...)
done

ok "All checks passed"
