#!/usr/bin/env bash
set -euo pipefail

# mrk install-apps — install the apps from this Mac's own GitHub releases
#
# Extracted from post-install on 2026-09-17 so that Phase 3 and `make apps`
# share one copy. Sourcing this file defines the functions and nothing else;
# running it installs the set and exits non-zero if any app failed.

# Resolve symlinks so this works when called via ~/bin
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
INSTALL_APPS_DIR="$(cd "$(dirname "$_self")" && pwd)"

# shellcheck source=lib.sh
source "$INSTALL_APPS_DIR/lib.sh"

INSTALL_APPS_USAGE='mrk-install-apps — install the apps this Mac runs, from their GitHub releases

Usage:
  mrk-install-apps [--help | -h]

Downloads the latest release DMG of each app and installs it, but only when the app
inside is signed by the expected Developer ID team and accepted by Gatekeeper —
which for a Developer ID app means notarized. An app already in /Applications is
left alone: this bootstraps a Mac, it does not manage updates. Each app checks GitHub
for its own updates once installed.

Normally run as `make apps`, and as part of `make post-install`.'

# The Developer ID team every app installed this way must be signed by. A
# release asset is only as trustworthy as the GitHub account that uploaded it;
# the signature ties it to the one key that account's owner signs with.
GITHUB_APP_TEAM_ID="T9RLNAXPWU"

# The apps this Mac runs that are published from its owner's own repos, as
#   <bundle name>|<repo holding the releases>|<display name>
#
# Kept as data so adding an app is one line. Three things this list encodes
# that are easy to get wrong:
#
#   - ClipHack's DMGs are published to a SEPARATE repo, ClipHack-releases. Its
#     source repo has no release assets at all.
#   - Magic Backup Machine's bundle is "Magic Backup Machine.app" while its DMG
#     is MagicBackupMachine-*.dmg. install_github_app compares bundle names, so
#     the spacing here is load-bearing.
#   - Cypher/FL2601 is deliberately absent. It is sandboxed with no network
#     entitlement, so it cannot check for its own updates, and Homebrew is its
#     update path by design — it stays a cask in the Brewfile.
#
# JustLoop, WireHack and Perfect Passwords Grabber are absent because they are
# not installed on this Mac. WireHack is superseded by ClipHack.
COMPANION_APPS=(
  "Barkeep.app|sevmorris/Barkeep|Barkeep"
  "ClipHack.app|sevmorris/ClipHack-releases|ClipHack"
  "DoublEnder.app|sevmorris/DoublEnder|DoublEnder"
  "FilmStrip.app|sevmorris/FilmStrip|FilmStrip"
  "KeyVault.app|sevmorris/KeyVault|KeyVault"
  "Magic Backup Machine.app|sevmorris/magic-backup-machine|Magic Backup Machine"
  "WaxOnWaxOff.app|sevmorris/WaxOnWaxOff|WaxOnWaxOff"
)

# github_app_trusted APP — true when APP's signature verifies in full, it is
# signed by GITHUB_APP_TEAM_ID, and Gatekeeper accepts it, which for a
# Developer ID app means notarized.
github_app_trusted(){
  local app="$1" team
  codesign --verify --deep --strict "$app" 2>/dev/null || return 1
  team=$(codesign -dv "$app" 2>&1 | sed -n 's/^TeamIdentifier=//p')
  [[ "$team" == "$GITHUB_APP_TEAM_ID" ]] || return 1
  spctl --assess --type execute "$app" 2>/dev/null || return 1
}

# fetch_release_dmg REPO DEST NAME — put the latest release DMG of REPO at DEST.
#
# gh first, when it is installed and authenticated: it carries the token, and a
# token is the only way to reach a release in a private repo. Magic Backup
# Machine is one, and a plain unauthenticated request for it returns 404 —
# indistinguishable from "no such release", which is how it read before this
# existed. curl otherwise, which is enough for every public repo here and is
# what a Mac whose gh is not yet logged in falls back to.
fetch_release_dmg(){
  local repo="$1" dest="$2" name="$3" release_json dmg_url
  if command -v gh >/dev/null 2>&1 && gh auth status >/dev/null 2>&1; then
    if gh release download --repo "$repo" --pattern '*.dmg' --output "$dest" --clobber >/dev/null 2>&1; then
      return 0
    fi
    log "Warning: gh could not download the latest $name release from $repo"
    return 1
  fi
  # A failed API call used to read as "could not find the DMG".
  if ! release_json=$(curl -sf "https://api.github.com/repos/${repo}/releases/latest"); then
    log "Warning: could not read the latest $name release from GitHub — not installed (a private repo needs an authenticated gh)"
    return 1
  fi
  dmg_url=$(jq -r '.assets[] | select(.name | endswith(".dmg")) | .browser_download_url' <<<"$release_json" | head -1)
  if [[ -z "$dmg_url" ]]; then
    log "Warning: could not find $name DMG in latest release"
    return 1
  fi
  curl -L -sf -o "$dest" "$dmg_url"
}

install_github_app(){
  local app_path="$1" repo="$2" name="$3"
  # Install-only: skips if the app is already present.
  # This is intentional — mrk bootstraps a new machine, it doesn't manage updates.
  # To update one of these apps, use the app itself, or delete it and re-run.
  if [[ -d "$app_path" ]]; then
    logskip "$name" "installed — skipping"
    return 0
  fi
  name="${name//[^[:alnum:]._-]/}"
  local tmp_dmg tmp_mount found_app
  tmp_dmg=$(mrk_mktemp)
  tmp_mount=$(mrk_mktemp_d)
  # Every path out of here goes through _github_app_done, which detaches,
  # deletes both temporary paths and drops the EXIT trap. The trap is for
  # Ctrl-C: the INT trap above exits, and the exit runs this. The failure
  # paths used to return with it still set, so it fired again when
  # post-install ended — with this function's locals gone, and `set -u`
  # stopped it with "tmp_mount: unbound variable".
  _github_app_done() {
    hdiutil detach "$tmp_mount" -quiet 2>/dev/null || true
    rm -f "$tmp_dmg"
    rm -rf "$tmp_mount" 2>/dev/null || true
    trap - EXIT
  }
  trap _github_app_done EXIT
  log "Downloading $name..."
  if ! fetch_release_dmg "$repo" "$tmp_dmg" "$name"; then
    _github_app_done; log "Warning: failed to download $name"; return 1
  fi
  if ! hdiutil attach "$tmp_dmg" -mountpoint "$tmp_mount" -quiet -nobrowse -readonly; then
    _github_app_done; log "Warning: failed to mount $name DMG"; return 1
  fi
  found_app=$(find "$tmp_mount" -maxdepth 2 -name "*.app" -type d | head -1)
  if [[ -z "$found_app" ]]; then
    _github_app_done; log "Warning: no .app found in $name DMG"; return 1
  fi
  # The app must be the one the skip test above looks for. Copying whatever
  # the DMG held into /Applications printed success for a differently named
  # bundle, left $app_path absent, and downloaded it again on every run.
  if [[ "$(basename "$found_app")" != "$(basename "$app_path")" ]]; then
    _github_app_done
    log "Warning: the $name DMG holds $(basename "$found_app"), not $(basename "$app_path") — not installed"
    return 1
  fi
  # Checked before anything reaches /Applications. This function used to
  # install whatever the DMG held and then strip every extended attribute
  # from it, and nothing ever looked at a signature: curl sets no quarantine,
  # so Gatekeeper never assesses an app installed this way on its own.
  if ! github_app_trusted "$found_app"; then
    _github_app_done
    log "Warning: $name in the DMG is not a notarized app signed by team $GITHUB_APP_TEAM_ID — not installed"
    return 1
  fi
  # ditto, not cp: on this Mac `cp` is GNU coreutils, which does not keep
  # macOS metadata. A copy that fails part-way is removed, so the skip test
  # above does not mistake the remains for an installed app on the next run.
  if ! ditto "$found_app" "$app_path"; then
    rm -rf "$app_path"
    _github_app_done; log "Warning: failed to copy $name to $app_path"; return 1
  fi
  _github_app_done
  if ! github_app_trusted "$app_path"; then
    rm -rf "$app_path"
    log "Warning: the installed copy of $name failed its signature check — removed"
    return 1
  fi
  ok "$name → $app_path"
}

# install_companion_apps — install every app in COMPANION_APPS, and leave the
# number that failed in COMPANION_FAILED. A single app failing never stops the
# rest: a GitHub outage or one unsigned release should not cost a new Mac its
# other six apps.
install_companion_apps(){
  COMPANION_FAILED=0
  local entry bundle repo name
  for entry in "${COMPANION_APPS[@]}"; do
    bundle="${entry%%|*}"
    repo="${entry#*|}"; repo="${repo%%|*}"
    name="${entry##*|}"
    install_github_app "/Applications/$bundle" "$repo" "$name" \
      || COMPANION_FAILED=$(( COMPANION_FAILED + 1 ))
  done
  return 0
}

# Sourced by post-install, which calls install_companion_apps itself. Run
# directly, install the set and report.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  mrk_help_guard "$INSTALL_APPS_USAGE" "$@"
  section "Apps from GitHub releases"
  install_companion_apps
  if (( COMPANION_FAILED )); then
    err "$COMPANION_FAILED app(s) were not installed"
    exit 1
  fi
  ok "All apps present"
fi
