#!/usr/bin/env bash
set -euo pipefail

# mrk restore-keys — restore ~/.ssh, ~/.gnupg and the code-signing identities
# from a snapshot-keys archive.
#
# The counterpart to snapshot-keys, the way pull-prefs is the counterpart to
# snapshot-prefs. Takes the passphrase-encrypted OpenPGP archive and puts the
# key material back where SSH, GPG and KeyVault expect to find it.
#
# Two properties matter more than convenience here:
#
#   Nothing is clobbered silently. An existing ~/.ssh or ~/.gnupg is moved
#   aside with a timestamp first, so a restore onto a machine that already has
#   keys is recoverable.
#
#   Plaintext key material is never written to a temporary file. gpg decrypts
#   straight into tar, which extracts to the final location. There is no
#   window in which an unencrypted copy exists somewhere else on disk.
#
# The archive can also hold credentials that live inside a project's working
# tree, under Projects/. Those go back only into a checkout that already
# exists; see "Credentials kept inside projects" below.

_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

check_macos
umask 077

# gpg asks for the passphrase through gpg-agent, and the agent has to be told
# which terminal to use. Inside the tar|gpg pipeline gpg's stdin is the pipe,
# so the agent cannot work it out on its own and dies with "Inappropriate
# ioctl for device" before any prompt appears. Capture the terminal here, at
# the top, while stdin is still the terminal — by the time the pipeline runs
# it is too late. Homebrew's default pinentry is the curses build, which is
# why this bites even on a desktop; a GUI pinentry-mac would not care.
if [[ -z "${GPG_TTY:-}" ]]; then
  if _mrk_tty=$(tty 2>/dev/null); then
    export GPG_TTY="$_mrk_tty"
  fi
fi

LIST_ONLY=0
PROJECTS_ONLY=0
ARCHIVE=""

usage() {
  cat <<'EOF'
Usage: restore-keys [-l | --projects] <archive>

Restore ~/.ssh, ~/.gnupg, any code-signing identities, and the credentials
projects keep out of git, from a snapshot-keys archive.

  -l, --list      List the archive contents, restore nothing
      --projects  Restore only the project credentials, into the checkouts
                  that exist now. Run it after restore-repos.
  -h, --help      Show this help

An existing ~/.ssh or ~/.gnupg is moved aside with a timestamp before the
restore, never overwritten in place, and so is an existing project credential
that differs from the archive's. A project credential goes back only once its
project is cloned; until then it stays in the archive.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    -l|--list) LIST_ONLY=1; shift ;;
    --projects) PROJECTS_ONLY=1; shift ;;
    -h|--help) usage; exit 0 ;;
    -*)        err "Unknown option: $1"; echo >&2; usage >&2; exit 2 ;;
    # One archive, not several. This arm used to be a bare assignment inside
    # the loop, so a second path overwrote the first: `restore-keys a.gpg
    # b.gpg` restored b and discarded a without a word. On the key-restore
    # path — run once, on a new machine, to recover a Developer ID Apple
    # cannot reissue — silently picking one of two archives is the worst
    # available behaviour.
    *)         if [[ -n "$ARCHIVE" ]]; then
                 err "Too many arguments — restore-keys takes one archive"
                 printf '\n  already given: %s\n  and then: %s\n\n' "$ARCHIVE" "$1" >&2
                 usage >&2
                 exit 2
               fi
               ARCHIVE="$1"; shift ;;
  esac
done

# No archive is a wrong command line, so it exits 2 like the two-archive case
# above, and before anything else runs. It used to exit 1 after the gpg check.
if [[ -z "$ARCHIVE" ]]; then
  err "No archive given."
  echo >&2
  usage >&2
  exit 2
fi

section "Restore keys"

command -v gpg >/dev/null 2>&1 || {
  err "gpg not found — install it with: brew install gnupg"
  exit 1
}

if [[ ! -f "$ARCHIVE" ]]; then
  err "Archive not found: $ARCHIVE"
  exit 1
fi

# Every gpg call below runs against a scratch home directory, never ~/.gnupg.
#
# Decrypting the archive needs no keyring, but gpg opens one anyway, and it
# creates its home directory when there is none. From GnuPG 2.4.1, a home
# directory that gpg creates gets a common.conf holding `use-keyboxd`, which
# moves the public keys out of pubring.kbx and into a keyboxd database. The
# restore below moves ~/.gnupg aside and then runs gpg, so gpg found no
# ~/.gnupg, created one with that common.conf, and tar extracted the archive
# into it. From then on Homebrew's gpg never read the restored pubring.kbx,
# while GPG Suite's gpg 2.2, which has no keyboxd, read nothing else. The
# 2026-09-15 migration split this Mac's keyring in two that way; it was found
# on 2026-09-17, when the two listed different keys. With a scratch home,
# ~/.gnupg holds exactly what the archive holds. The scratch directory never
# sees key material: it holds the agent's sockets and an empty keyring.
GPG_SCRATCH="$(mrk_mktemp_d)"
cleanup_gpg_scratch() {
  gpgconf --homedir "$GPG_SCRATCH" --kill all >/dev/null 2>&1 || true
  rm -rf "$GPG_SCRATCH"
}
trap cleanup_gpg_scratch EXIT

# Confirm the file is a symmetrically-encrypted OpenPGP message before moving
# anything aside.
#
# gpg has no "describe but do not decrypt" mode: --list-packets prints the
# packet listing and then tries the session key anyway, so it exits 2 with
# "decryption failed: Bad session key" whenever it cannot get the passphrase.
# Two consequences, both of which bit this check:
#
#   Under `set -o pipefail`, piping straight into grep made the pipeline
#   inherit that exit 2 even though grep had matched, so a perfectly good
#   archive was reported as "Not a snapshot-keys archive" — on a new machine,
#   which is the only place this script ever runs. The output is captured
#   first so the packet listing, not gpg's exit status, decides.
#
#   Without --pinentry-mode error the agent raises a passphrase dialog here,
#   before the real decrypt below. That is the second prompt this check was
#   supposed to avoid.
packets="$(gpg --homedir "$GPG_SCRATCH" --list-packets --batch --pinentry-mode error "$ARCHIVE" 2>&1 || true)"
if ! printf '%s' "$packets" | grep -q "symkey enc packet"; then
  err "Not a snapshot-keys archive: $ARCHIVE"
  info "Expected a symmetrically-encrypted OpenPGP message."
  exit 1
fi

# ── List mode ─────────────────────────────────────────────────────────────────

if (( LIST_ONLY )); then
  log "Reading $ARCHIVE..."
  echo "" >&2
  gpg --homedir "$GPG_SCRATCH" -d -q "$ARCHIVE" 2>/dev/null | tar -tvf - | sed 's/^/    /' >&2
  exit 0
fi

stamp="$(date +%Y%m%d-%H%M%S)"

# ── Credentials kept inside projects ──────────────────────────────────────────

# snapshot-keys bundles a few credentials that live inside project working
# trees, under Projects/ in the archive, and the main extract below leaves them
# out. On a new machine this runs before restore-repos, and a file written into
# ~/Projects/DoublEnder before the clone makes that folder exist without being a
# repository, so restore-repos would leave it alone and never clone it. Each
# file goes in only once the checkout it belongs in exists; the rest stay in the
# archive, and `restore-keys --projects` puts them back after restore-repos.
#
# Reading the archive again does not ask for the passphrase again: gpg-agent
# caches a symmetric passphrase for the life of the scratch home.
PROJECT_PENDING=()
PROJECT_RESTORED=0
restore_project_files() {
  local listing name project dest i
  local -a names=() ready=() pmoved=() pmoved_orig=()

  if ! listing=$(gpg --homedir "$GPG_SCRATCH" -d -q "$ARCHIVE" 2>/dev/null | tar -tf - 2>/dev/null); then
    err "Could not read the archive — wrong passphrase, or a damaged archive."
    return 1
  fi
  while IFS= read -r name; do
    if [[ "$name" == Projects/*/* && "$name" != */ ]]; then names+=("$name"); fi
  done <<<"$listing"
  if (( ${#names[@]} == 0 )); then
    if (( PROJECTS_ONLY )); then info "The archive holds no project credentials."; fi
    return 0
  fi

  for name in "${names[@]}"; do
    project=${name#Projects/}
    project=${project%%/*}
    if [[ -d "$HOME/Projects/$project/.git" ]]; then
      ready+=("$name")
    else
      PROJECT_PENDING+=("$name")
    fi
  done
  (( ${#ready[@]} > 0 )) || return 0

  # Nothing clobbered silently, as with ~/.ssh: an existing file is moved aside
  # first, and the copy is dropped below only when the archive's is identical.
  for name in "${ready[@]}"; do
    dest="$HOME/$name"
    if [[ -e "$dest" ]]; then
      mv "$dest" "$dest.before-restore-$stamp"
      pmoved+=("$dest.before-restore-$stamp")
      pmoved_orig+=("$dest")
    fi
  done
  if ! gpg --homedir "$GPG_SCRATCH" -d -q "$ARCHIVE" 2>/dev/null | tar -xpf - -C "$HOME" "${ready[@]}"; then
    err "Could not extract the project credentials — putting the originals back."
    for i in "${!pmoved[@]}"; do
      rm -f "${pmoved_orig[$i]}"
      mv "${pmoved[$i]}" "${pmoved_orig[$i]}"
    done
    return 1
  fi
  for name in "${ready[@]}"; do
    chmod 600 "$HOME/$name"
    # shellcheck disable=SC2088  # Literal "~/" for the reader, not a path to expand
    ok "~/$name restored (600)"
    PROJECT_RESTORED=$((PROJECT_RESTORED + 1))
  done
  for i in "${!pmoved[@]}"; do
    if cmp -s "${pmoved[$i]}" "${pmoved_orig[$i]}"; then
      rm -f "${pmoved[$i]}"
    else
      warn "Kept the previous ~/${pmoved_orig[$i]#"$HOME"/} as $(basename "${pmoved[$i]}")"
    fi
  done
  return 0
}

report_project_pending() {
  local name
  (( ${#PROJECT_PENDING[@]} > 0 )) || return 0
  echo "" >&2
  warn "Not restored yet — the project each belongs in is not cloned here:"
  for name in "${PROJECT_PENDING[@]}"; do
    info "  ~/$name"
  done
  info "They are still in the archive. Once restore-repos has cloned the project:"
  info "  restore-keys --projects $ARCHIVE"
}

if (( PROJECTS_ONLY )); then
  log "Reading $ARCHIVE..."
  restore_project_files || exit 1
  report_project_pending
  (( ${#PROJECT_PENDING[@]} == 0 )) || exit 1
  if (( PROJECT_RESTORED > 0 )); then
    echo "" >&2
    ok "Restored $PROJECT_RESTORED project credential file(s)"
  fi
  exit 0
fi

# ── Move aside whatever is already there ──────────────────────────────────────

log "Reading $ARCHIVE..."

# Parallel arrays rather than deriving the original path back out of the backup
# name: the rollback below runs on the failure path, which is the worst place to
# be doing string surgery on a filename.
moved=()
moved_orig=()

for d in .ssh .gnupg; do
  if [[ -e "$HOME/$d" ]]; then
    backup="$HOME/${d}.before-restore-${stamp}"
    mv "$HOME/$d" "$backup"
    moved+=("$backup")
    moved_orig+=("$HOME/$d")
    warn "Moved existing ~/$d → $(basename "$backup")"
  fi
done

# If the extract fails after a move, put the originals back rather than leaving
# the machine with no keys at all.
restore_originals() {
  local rc=$? i
  if (( rc != 0 )) && (( ${#moved[@]} > 0 )); then
    err "Restore failed — putting the original directories back."
    for i in "${!moved[@]}"; do
      rm -rf "${moved_orig[$i]}"
      mv "${moved[$i]}" "${moved_orig[$i]}" && ok "Restored ${moved_orig[$i]}"
    done
  fi
  return $rc
}
# restore_originals returns the failure status, and under set -e that would end
# the trap before the scratch cleanup. The script still exits with its own
# status: a trap that finishes normally does not change it.
trap 'restore_originals || true; cleanup_gpg_scratch' EXIT

# ── Decrypt straight into place ───────────────────────────────────────────────

# Projects/ is left out here and placed below, only into checkouts that exist.
if ! gpg --homedir "$GPG_SCRATCH" -d -q "$ARCHIVE" 2>/dev/null | tar -xpf - -C "$HOME" --exclude Projects; then
  err "Decryption or extraction failed — wrong passphrase, or a damaged archive."
  exit 1
fi

trap cleanup_gpg_scratch EXIT

# ── Put back anything the archive did not replace ─────────────────────────────

# Both directories are moved aside above, because what the archive holds is not
# knowable without decrypting it, and decrypting twice would mean two passphrase
# prompts. An archive from a machine that had no ~/.gnupg therefore left this
# machine with no ~/.gnupg either — the directory survived only as a timestamped
# copy, which is not where gpg looks. Anything the extract did not recreate goes
# back where it was; the copy is dropped, since it is now the live directory
# again rather than a spare.
for i in "${!moved[@]}"; do
  if [[ ! -e "${moved_orig[$i]}" ]]; then
    mv "${moved[$i]}" "${moved_orig[$i]}"
    unset "moved[$i]"
    warn "Archive had no $(basename "${moved_orig[$i]}") — put the existing one back"
  fi
done
# Reindex: unset leaves holes, and the report below walks the array.
moved=(${moved[@]+"${moved[@]}"})

# ── Correct the permissions ───────────────────────────────────────────────────

# tar -p preserves the recorded modes, but an archive built elsewhere, or one
# that travelled through a filesystem without POSIX permissions, can arrive
# with modes that ssh and gpg reject outright. Setting them is cheap; debugging
# "Permissions are too open" on a new machine is not.
if [[ -d "$HOME/.ssh" ]]; then
  chmod 700 "$HOME/.ssh"
  find "$HOME/.ssh" -type f -exec chmod 600 {} +
  find "$HOME/.ssh" -type f -name '*.pub' -exec chmod 644 {} +
  # shellcheck disable=SC2088  # Literal "~/" for the reader, not a path to expand
  ok "~/.ssh restored (700, keys 600)"
fi

if [[ -d "$HOME/.gnupg" ]]; then
  chmod 700 "$HOME/.gnupg"
  find "$HOME/.gnupg" -type d -exec chmod 700 {} +
  find "$HOME/.gnupg" -type f -exec chmod 600 {} +
  # shellcheck disable=SC2088  # Literal "~/" for the reader, not a path to expand
  ok "~/.gnupg restored (700)"
fi

# ── Code-signing identities ───────────────────────────────────────────────────

# The .p12 rides in the archive alongside .ssh and .gnupg, so it extracts into
# $HOME. Import it and delete it: leaving a bundle of private keys sitting in
# the home directory is exactly the state this whole script exists to avoid,
# and the removal runs whether or not the import succeeds.
P12="$HOME/signing-identities.p12"
if [[ -f "$P12" ]]; then
  echo "" >&2
  log "Archive contains code-signing identities"
  info "macOS will ask for the .p12 passphrase — the second one you were told"
  info "to store, not the archive passphrase."
  echo "" >&2
  # -T pre-authorises the two tools that actually use the key, so signing a
  # build later does not raise a keychain dialog per invocation.
  if security import "$P12" -k "$HOME/Library/Keychains/login.keychain-db" \
       -T /usr/bin/codesign -T /usr/bin/security 2>/dev/null; then
    ok "Signing identities imported"
  else
    warn "Signing identity import failed or was cancelled."
    info "The archive still holds them. Re-run restore-keys, or import by hand:"
    info "  security import <file>.p12 -k ~/Library/Keychains/login.keychain-db"
  fi
  rm -f "$P12"
fi

# The keys are in place by now, so a failure here is reported, not rolled back.
if ! restore_project_files; then
  warn "The keys are restored; the project credentials are not."
  info "Once the cause is fixed: restore-keys --projects $ARCHIVE"
fi

# ── Report ────────────────────────────────────────────────────────────────────

echo "" >&2
if [[ -d "$HOME/.gnupg" ]]; then
  # The agent holds state from before the restore, including a cached view of a
  # keyring that no longer exists. Restarting it is what makes the imported
  # secret keys visible to gpg without a logout.
  gpgconf --kill gpg-agent 2>/dev/null || true
  log "Restarted gpg-agent"
fi

ok "Restore complete"
echo "" >&2
info "Check the result:"
info "  ssh-add -l                                 # SSH keys"
info "  gpg --list-secret-keys                     # GPG secret keys"
info "  ssh -T git@github.com                      # GitHub authentication"
info "  security find-identity -v -p codesigning   # signing identities"

report_project_pending

if (( ${#moved[@]} > 0 )); then
  echo "" >&2
  warn "Your previous directories were kept, not deleted:"
  for b in "${moved[@]}"; do
    info "  $b"
  done
  info "Delete them once you have checked the restore."
fi
