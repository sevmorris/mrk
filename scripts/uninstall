#!/usr/bin/env bash
set -euo pipefail

# mrk uninstaller - conservative
# - Unlinks ~/bin symlinks pointing into this repo
# - Optionally runs ~/.mrk/defaults-rollback.sh, hardening-rollback.sh and
#   services-rollback.sh
# - Does not remove user data or dotfiles

# Resolve symlinks so this works when called via ~/bin
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
INSTALL_BIN="$HOME/bin"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

usage() {
  cat <<'EOF'
mrk-uninstall — remove mrk's ~/bin symlinks, and optionally roll back settings

Usage:
  mrk-uninstall

Options:
  -h, --help      Show this help

mrk-uninstall takes no options other than --help. It unlinks every ~/bin
symlink pointing into this repository, then offers to run the undo scripts in
~/.mrk: the macOS defaults, the security hardening and the background
services. The defaults undo also deletes the whole preferences of each app
whose settings post-install imported; that part is offered on its own, with
the apps named. It removes no user data, no dotfiles and not the repository
itself. It must be run interactively.
EOF
}

# The guard runs before the TTY check below so that --help still answers when
# stdin is not a terminal, and — the real reason — before the unlinking, which
# has no gate of its own. The [y/N] further down covers only the rollback step:
# by the time it is reached, every symlink has already been removed. Until this
# guard existed, `mrk-uninstall --help` uninstalled mrk.
mrk_help_guard "$(usage)" "$@"

if [[ ! -t 0 ]]; then
  echo "error: uninstall must be run interactively" >&2
  exit 1
fi

log(){ printf "[uninstall] %s\n" "$*"; }
warn(){ printf "[warn] %s\n" "$*"; }

log "Unlinking mrk symlinks from $INSTALL_BIN..."
removed=0
failed=0

# Function to remove symlinks from a directory
remove_symlinks_from() {
  local dir="$1"
  if [[ ! -d "$dir" ]]; then
    return 0
  fi
  
  while IFS= read -r -d '' link; do
    local target
    target="$(readlink "$link" 2>/dev/null || true)"
    if [[ -z "$target" ]]; then
      continue
    fi
    
    # Check if symlink points to this repo's scripts or bin directories
    case "$target" in
      *"/scripts/"*|*"/bin/"*)
        # Verify it's actually in our repo
        if [[ "$target" == "$REPO_ROOT"/* ]]; then
          if rm -f "$link"; then
            log "Removed: $link -> $target"
            ((removed++)) || true
          else
            warn "Failed to remove: $link"
            ((failed++)) || true
          fi
        fi
        ;;
    esac
  done < <(find "$dir" -maxdepth 1 -type l -print0 2>/dev/null || true)
}

remove_symlinks_from "$INSTALL_BIN"

if (( removed > 0 )); then
  log "Removed $removed symlink(s)"
fi

if (( failed > 0 )); then
  warn "$failed symlink(s) failed to remove"
fi

if (( removed == 0 && failed == 0 )); then
  if [[ ! -d "$INSTALL_BIN" ]]; then
    warn "$INSTALL_BIN not found (nothing to unlink)"
  fi
fi

offer_rollback() {
  local script="$1" label="$2"
  if [[ ! -x "$script" ]] || [[ ! -s "$script" ]]; then
    return 0
  fi
  if [[ -t 0 ]]; then
    read -r -p "Run $label rollback now? [y/N] " ans
    if [[ "$ans" =~ ^[Yy]$ ]]; then
      log "Running $script..."
      if "$script"; then
        log "$label rollback completed successfully"
      else
        warn "$label rollback returned non-zero exit code"
      fi
    else
      log "Skipped $label rollback (you can run it later: $script)."
    fi
  else
    log "Non-interactive mode: skipping $label rollback"
    log "You can run it manually: $script"
  fi
}

# Remove the LaunchAgents installed by post-install. The symlinks they invoke
# have just been unlinked above, so leaving the jobs registered would schedule a
# daily run against a path that no longer exists. Unload as well as delete:
# launchd keeps a job until it is booted out, regardless of the file.
for label in com.user.clear_app_caches com.user.clear_derived_data; do
  agent="$HOME/Library/LaunchAgents/$label.plist"
  if [[ -f "$agent" ]]; then
    launchctl unload "$agent" >/dev/null 2>&1 || true
    rm -f "$agent"
    log "Removed LaunchAgent: $label"
  fi
done

# The defaults undo in two parts: the per-key lines, then the whole-domain
# deletes of the apps post-install imported, named and asked about on their own.
# See MRK_WHOLE_DOMAIN_UNDO in lib.sh (audit 19, W-13).
offer_defaults_rollback() {
  local script="$HOME/.mrk/defaults-rollback.sh" domains n=0 ans
  [[ -s "$script" ]] || return 0
  read -r -p "Run macOS defaults rollback now? It puts back the macOS settings mrk changed [y/N] " ans
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then
    log "Skipped macOS defaults rollback (you can run it later: $script)."
    return 0
  fi
  log "Running the macOS settings in $script..."
  if run_rollback "$script" settings; then
    log "macOS defaults rollback completed successfully"
  else
    warn "macOS defaults rollback returned non-zero exit code"
  fi

  domains=$(rollback_domains "$script")
  [[ -n "$domains" ]] && n=$(printf '%s\n' "$domains" | wc -l | tr -d ' ')
  (( n > 0 )) || return 0
  log "The same file also deletes the whole preferences of $n app(s) whose settings post-install imported:"
  printf '%s\n' "$domains" | sed 's/^/    /'
  log "Everything set in those apps since the import would go with them."
  read -r -p "Delete those apps' preferences too? [y/N] " ans
  if [[ ! "$ans" =~ ^[Yy]$ ]]; then
    log "Kept those apps' preferences."
    return 0
  fi
  if run_rollback "$script" domains; then
    log "Deleted the preferences of $n app(s)"
  else
    warn "deleting those apps' preferences returned non-zero exit code"
  fi
}

offer_defaults_rollback
offer_rollback "$HOME/.mrk/hardening-rollback.sh" "security hardening"
# trim-services writes this one. Until 2026-09-27 nothing offered it (audit 19, W-8).
offer_rollback "$HOME/.mrk/services-rollback.sh" "background services"

log "Uninstall complete."
