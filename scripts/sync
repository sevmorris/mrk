#!/usr/bin/env bash

# Re-exec with Homebrew bash if running under bash < 4 (macOS ships bash 3.2)
if (( BASH_VERSINFO[0] < 4 )); then
  for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_brew_bash" ]] && exec "$_brew_bash" "$0" "$@"
  done
  echo "error: bash 4+ required (system bash is ${BASH_VERSION}; install via 'brew install bash')" >&2
  exit 1
fi

set -euo pipefail

# mrk sync — Snapshot installed Homebrew packages into the Brewfile

# Resolve symlinks so this works when called via ~/bin
_self="${BASH_SOURCE[0]}"
while [[ -L "$_self" ]]; do
  _dir="$(cd "$(dirname "$_self")" && pwd)"
  _self="$(readlink "$_self")"
  [[ "$_self" != /* ]] && _self="$_dir/$_self"
done
SCRIPT_DIR="$(cd "$(dirname "$_self")" && pwd)"

# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

check_macos

DRY_RUN=0
COMMIT=0
PRUNE=0
CHECK=0
DETAILS=0

# One decision made on the command line in place of the picker and the gum
# prompts, for a program with no terminal to show them on (Barkeep). DECIDE is
# add, ignore or prune; DECIDE_KIND is formula or cask, from --formula or
# --cask, or found among the candidates when neither is given. Each decision
# fills the variables the picker would have filled, and the same code as an
# interactive run then writes the Brewfile, the description table and the
# ignore list, so the two cannot place, describe or refuse a package
# differently.
DECIDE=""
DECIDE_NAME=""
DECIDE_KIND=""
DECIDE_SECTION=""
SECTION_GIVEN=0

usage_error() { err "$*"; info "Run sync --help for the options."; exit 2; }

decide() {
  [[ -z "$DECIDE" ]] || usage_error "Give one decision per run: --add, --ignore or --prune with a name, once."
  DECIDE=$1
  DECIDE_NAME=$2
}

while (("$#")); do
  case "$1" in
    --dry-run|-n) DRY_RUN=1 ;;
    --commit|-c)  COMMIT=1 ;;
    --prune|-p)
      # A name after it makes it one decision; alone it opens the selection.
      # No package name starts with a dash, so the next option is never
      # mistaken for one.
      if (( $# > 1 )) && [[ "$2" != -* ]]; then
        decide prune "$2"; shift
      else
        PRUNE=1
      fi
      ;;
    --add|--ignore)
      (( $# > 1 )) && [[ "$2" != -* ]] || usage_error "$1 needs a package name."
      decide "${1#--}" "$2"; shift
      ;;
    --section)
      (( $# > 1 )) && [[ "$2" != -* ]] || usage_error "--section needs a section name."
      DECIDE_SECTION=$2; SECTION_GIVEN=1; shift
      ;;
    --formula|--cask)
      [[ -z "$DECIDE_KIND" || "$DECIDE_KIND" == "${1#--}" ]] || usage_error "Give --formula or --cask, not both."
      DECIDE_KIND=${1#--}
      ;;
    --check)      CHECK=1 ;;
    --details)    DETAILS=1 ;;
    -h|--help)
      cat <<'USAGE'
mrk sync — Snapshot installed Homebrew packages into the Brewfile

Usage: scripts/sync [options]
  --dry-run, -n   Show what would be added without modifying the Brewfile
  --commit, -c    Auto-commit the Brewfile after updating
  --prune, -p     Remove Brewfile entries for packages that are no longer installed
  --check         Print what --dry-run would add and --prune would remove, one
                  line each, tab-separated: add or prune, formula or cask, name.
                  Nothing else on stdout, nothing changed, no picker. Exits 0
                  when it could tell, drift or none; 1 when brew failed.
                  mrk-status reads it. Takes precedence over the other options.
  --details       With --check: three more fields on each line, for a program
                  that shows the drift. For an add: the section sync files a
                  cask under (empty for a formula), why, and the description
                  the table will hold. For a prune: the entry's section, an
                  empty field, and its description. Asks Homebrew about each
                  new package, so it is slower than --check alone.

One decision, made without the picker or a prompt (for a program, such as
Barkeep). Each takes one package that --check lists, and refuses any other.
With -n it shows what it would do; with -c it commits what it changed.
  --add NAME      Add NAME as the picker would: in name order, with Homebrew's
                  description, and a cask filed by its app's category.
  --section NAME  The Brewfile section for a formula --add adds, as its "## "
                  line names it, with or without the "## ". A formula needs
                  one; a cask takes none. A name no section has yet starts one.
  --ignore NAME   Add NAME to ~/.mrk/sync-ignore, so sync stops offering it.
  --prune NAME    Delete NAME's entry, which is not installed, and its
                  description when no other entry uses it.
  --formula, --cask
                  Which kind NAME is. Needed only when it is both.
Exits 0 when done, 1 when sync refuses or brew fails, 2 for a bad option.
USAGE
      exit 0
      ;;
    *) usage_error "Unknown option: $1" ;;
  esac
  shift
done

(( DETAILS && ! CHECK )) && usage_error "--details works only with --check."
if [[ -n "$DECIDE" ]]; then
  # A package name as Homebrew spells one: also what keeps a name from
  # breaking the Brewfile line, the table line or the ignore file.
  [[ "$DECIDE_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9@+._/-]*$ ]] \
    || usage_error "Not a package name: '$DECIDE_NAME'."
  (( PRUNE )) && usage_error "--prune without a name opens the selection; it does not combine with --$DECIDE."
fi
(( SECTION_GIVEN )) && [[ "$DECIDE" != add ]] && usage_error "--section works only with --add."
[[ -n "$DECIDE_KIND" && -z "$DECIDE" ]] && usage_error "--$DECIDE_KIND works only with --add, --ignore or --prune NAME."
if (( SECTION_GIVEN )); then
  DECIDE_SECTION="${DECIDE_SECTION#\#\# }"
  # The names section 6 offers for a formula: no Taps, no cask section, and
  # nothing gum input would not let you type on one line.
  [[ -n "${DECIDE_SECTION//[[:space:]]/}" ]] || usage_error "--section needs a section name."
  [[ "$DECIDE_SECTION" != *[[:cntrl:]]* ]] || usage_error "A section name is one line of text."
  [[ "$DECIDE_SECTION" != \#* ]] || usage_error "Give the section as its \"## \" line names it: '## Repo essentials' or 'Repo essentials'."
  case "$DECIDE_SECTION" in
    Taps|Casks*) usage_error "'$DECIDE_SECTION' is not a formula section. sync files a cask by its app's category." ;;
  esac
fi

REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
readonly BREWFILE="$REPO_ROOT/Brewfile"
# The one description table: an add writes to it and a prune deletes from it.
readonly DESC_TABLE="$REPO_ROOT/tools/picker/descriptions.tsv"

if [[ ! -f "$BREWFILE" ]]; then
  err "Brewfile not found: $BREWFILE"
  exit 1
fi

# Resolve Homebrew. MRK_BREW names another brew, so tests/sync.sh can run sync
# against a stub, as SHELLS_FILE lets a test run scripts/setup.
HOMEBREW="${MRK_BREW:-}"
if [[ -n "$HOMEBREW" ]]; then
  [[ -x "$HOMEBREW" ]] || { err "MRK_BREW is not executable: $HOMEBREW"; exit 1; }
elif [[ -x /opt/homebrew/bin/brew ]]; then
  HOMEBREW=/opt/homebrew/bin/brew
elif [[ -x /usr/local/bin/brew ]]; then
  HOMEBREW=/usr/local/bin/brew
else
  err "Homebrew not found at /opt/homebrew/bin/brew or /usr/local/bin/brew"
  exit 1
fi
eval "$($HOMEBREW shellenv)"

# Temp files
TEMP_BREWFILE=""
TEMP_INSERTIONS=""
BREWFILE_TMP=""
PICKER_TMP=""
TEMP_META=""
TEMP_DESCS=""
PICKER_CHANGED=0
cleanup() {
  [[ -n "$TEMP_BREWFILE"   && -f "$TEMP_BREWFILE"   ]] && rm -f "$TEMP_BREWFILE"   || true
  [[ -n "$TEMP_INSERTIONS" && -f "$TEMP_INSERTIONS" ]] && rm -f "$TEMP_INSERTIONS" || true
  [[ -n "$BREWFILE_TMP"    && -f "$BREWFILE_TMP"    ]] && rm -f "$BREWFILE_TMP"    || true
  [[ -n "$PICKER_TMP"      && -f "$PICKER_TMP"      ]] && rm -f "$PICKER_TMP"      || true
  [[ -n "$TEMP_META"       && -f "$TEMP_META"       ]] && rm -f "$TEMP_META"       || true
  [[ -n "$TEMP_DESCS"      && -f "$TEMP_DESCS"      ]] && rm -f "$TEMP_DESCS"      || true
}
trap cleanup EXIT INT TERM

# Belt-and-braces for the replace: mktemp creates the file 0600, and any writer
# path that produced nothing would otherwise truncate the Brewfile. Refuse to
# install an empty file, and restore the expected mode before the swap.
replace_brewfile() {
  if [[ ! -s "$BREWFILE_TMP" ]]; then
    err "Refusing to replace the Brewfile with an empty file — aborting."
    return 1
  fi
  chmod 644 "$BREWFILE_TMP"
  mv "$BREWFILE_TMP" "$BREWFILE"
  BREWFILE_TMP=""
}

# ─── Load persistent ignore list ─────────────────────────────────────────────
#
# Format of ~/.mrk/sync-ignore:
#   one formula or cask name per line (no brew/cask prefix)
#   lines starting with # are ignored
#   example:
#     nvm
#     python@3.12
#
# sync appends a package to it when you choose to ignore one, and creates the
# file if it is absent (_append_sync_ignore, below). You can also write it by
# hand, to keep a package installed but never have sync suggest it.

_SYNC_IGNORE=()
if [[ -f "${STATE_DIR}/sync-ignore" ]]; then
  while IFS= read -r _line; do
    _line="${_line%%#*}"            # strip inline comments
    _line="${_line//[[:space:]]/}"  # strip whitespace
    [[ -n "$_line" ]] && _SYNC_IGNORE+=("$_line")
  done < "${STATE_DIR}/sync-ignore"
  if (( ${#_SYNC_IGNORE[@]} > 0 )); then
    log "Loaded ${#_SYNC_IGNORE[@]} ignore rule(s) from ~/.mrk/sync-ignore"
  fi
fi

_sync_ignored() {
  local _pkg="$1"
  local _item
  for _item in "${_SYNC_IGNORE[@]}"; do
    [[ "$_item" == "$_pkg" ]] && return 0
  done
  return 1
}

# Append one package name to the ignore file, and create the file if it is
# absent. Append-only: existing lines are never rewritten or reordered.
# Mirrors _append_login_item_ignore in scripts/sync-login-items.
_append_sync_ignore() {
  local _pkg="$1"
  local _f="${STATE_DIR}/sync-ignore"

  if [[ ! -f "$_f" ]]; then
    mkdir -p "$STATE_DIR"
    cat > "$_f" <<'IGNOREHEADER'
# mrk sync ignore list
#
# One formula name or cask name per line, with no brew or cask prefix.
# A # character starts a comment.
#
# sync drops these names, so it never offers them as new packages.
IGNOREHEADER
  fi

  # A file whose last line has no newline would otherwise absorb the append.
  if [[ -s "$_f" && -n "$(tail -c 1 "$_f")" ]]; then
    printf '\n' >> "$_f"
  fi

  printf '%s\n' "$_pkg" >> "$_f"
  _SYNC_IGNORE+=("$_pkg")   # keep the in-memory list authoritative
}

# ─── 1. Parse Brewfile entries ───────────────────────────────────────────────

declare -A brewfile_formulae=()
declare -A brewfile_casks=()
# kind:name → the "## " section the entry is in, for --check --details.
declare -A brewfile_section=()

_current_section=""
while IFS= read -r line || [[ -n "$line" ]]; do
  if [[ "$line" =~ ^##[[:space:]](.+) ]]; then
    _current_section="${BASH_REMATCH[1]}"
  elif [[ "$line" =~ ^brew[[:space:]]\"([^\"]+)\" ]]; then
    brewfile_formulae["${BASH_REMATCH[1]}"]=1
    brewfile_section["formula:${BASH_REMATCH[1]}"]="$_current_section"
  elif [[ "$line" =~ ^cask[[:space:]]\"([^\"]+)\" ]]; then
    brewfile_casks["${BASH_REMATCH[1]}"]=1
    brewfile_section["cask:${BASH_REMATCH[1]}"]="$_current_section"
  fi
done < "$BREWFILE"

# ─── 2. Get installed packages ───────────────────────────────────────────────

log "Scanning installed Homebrew packages..."

declare -A installed_formulae=()    # top-level only (for new-package detection)
declare -A installed_formulae_all=() # all installed (for stale detection)
declare -A installed_casks=()

if ! _leaves_out=$($HOMEBREW leaves --installed-on-request 2>/dev/null); then
  err "brew leaves failed — cannot determine installed formulae"
  exit 1
fi
while IFS= read -r pkg; do
  [[ -n "$pkg" ]] && installed_formulae["$pkg"]=1
done <<< "$_leaves_out"

# Capture with an exit-code check (like brew leaves above): a failed list must
# not silently yield an empty set, which --prune would read as "every tracked
# entry is stale" and offer to delete the whole Brewfile.
if ! _formulae_out=$($HOMEBREW list --formula 2>/dev/null); then
  err "brew list --formula failed — cannot determine installed formulae"
  exit 1
fi
while IFS= read -r pkg; do
  [[ -n "$pkg" ]] && installed_formulae_all["$pkg"]=1
done <<< "$_formulae_out"

if ! _casks_out=$($HOMEBREW list --cask 2>/dev/null); then
  err "brew list --cask failed — cannot determine installed casks"
  exit 1
fi
while IFS= read -r pkg; do
  [[ -n "$pkg" ]] && installed_casks["$pkg"]=1
done <<< "$_casks_out"

# A successful read that returns nothing is the other half of the guard above,
# and only --prune is exposed to it: staleness is "in the Brewfile, absent from
# the installed set", so an empty installed set marks every tracked entry stale
# and offers to delete the whole Brewfile.
#
# The exit-code checks above do not cover this. `brew list` exits 0 and prints
# nothing when Homebrew has nothing installed — a fresh machine after Homebrew
# but before `make brew`, or a half-migrated prefix.
#
# Both lists, not either: a machine with casks and no formulae is unremarkable,
# and aborting on that would be a false alarm. Both empty is not.
#
# scripts/sync-login-items refuses the identical shape for system login items
# and cites this file as its model. It guards emptiness as well as failure;
# this one only guarded failure.
if { (( PRUNE )) || [[ "$DECIDE" == prune ]]; } \
   && (( ${#installed_formulae_all[@]} == 0 )) && (( ${#installed_casks[@]} == 0 )); then
  err "Homebrew reports nothing installed — refusing to prune."
  info "'Nothing is installed' and 'the read returned nothing' are"
  info "indistinguishable here, and pruning on the second would offer to delete"
  info "every entry in the Brewfile. Re-run without --prune, or check"
  info "'brew list --formula' and 'brew list --cask' by hand."
  exit 1
fi

# ─── 3. Compute diff ─────────────────────────────────────────────────────────

new_formulae_arr=()
new_casks_arr=()
_filtered=0

for pkg in "${!installed_formulae[@]}"; do
  [[ -z "${brewfile_formulae[$pkg]+x}" ]] || continue
  if _sync_ignored "$pkg"; then
    _filtered=$((_filtered + 1))
    continue
  fi
  new_formulae_arr+=("$pkg")
done

for pkg in "${!installed_casks[@]}"; do
  [[ -z "${brewfile_casks[$pkg]+x}" ]] || continue
  if _sync_ignored "$pkg"; then
    _filtered=$((_filtered + 1))
    continue
  fi
  new_casks_arr+=("$pkg")
done

if (( _filtered > 0 )); then
  log "Skipping $_filtered ignored package(s) (see ~/.mrk/sync-ignore)"
fi

# Sort
if (( ${#new_formulae_arr[@]} > 0 )); then
  mapfile -t new_formulae_arr < <(printf '%s\n' "${new_formulae_arr[@]}" | sort)
fi
if (( ${#new_casks_arr[@]} > 0 )); then
  mapfile -t new_casks_arr < <(printf '%s\n' "${new_casks_arr[@]}" | sort)
fi

# ─── 3b. Compute stale entries (for --prune) ─────────────────────────────────

stale_formulae_arr=()
stale_casks_arr=()

for pkg in "${!brewfile_formulae[@]}"; do
  [[ -z "${installed_formulae_all[$pkg]+x}" ]] && stale_formulae_arr+=("$pkg")
done

for pkg in "${!brewfile_casks[@]}"; do
  [[ -z "${installed_casks[$pkg]+x}" ]] && stale_casks_arr+=("$pkg")
done

if (( ${#stale_formulae_arr[@]} > 0 )); then
  mapfile -t stale_formulae_arr < <(printf '%s\n' "${stale_formulae_arr[@]}" | sort)
fi
if (( ${#stale_casks_arr[@]} > 0 )); then
  mapfile -t stale_casks_arr < <(printf '%s\n' "${stale_casks_arr[@]}" | sort)
fi

n_stale=$(( ${#stale_formulae_arr[@]} + ${#stale_casks_arr[@]} ))

# --check stops here: the drift as the dashboard reads it, from the same
# comparison and the same sync-ignore that an add or a prune would use, so the
# two cannot disagree about what is unrecorded. Until 2026-09-30 mrk-status
# compared the Brewfile with `brew list` itself, which knows nothing of
# sync-ignore or of the difference between a leaf and a dependency.
#
# --details adds what a program needs to show a decision before it is made:
# where sync would file each new cask and why, and the words the description
# table will hold. Three fields more, after the three mrk-status reads, which
# keeps them out of its way: its parser takes a line of exactly three fields.
# They cost a `brew info` for each new package, about 0.3 s here, which is why
# they are asked for rather than always there.

# The description table as name → description, for --details and the checks.
declare -A table_desc=()
if [[ -f "$DESC_TABLE" ]]; then
  while IFS=$'\t' read -r _name _desc; do
    [[ -n "$_name" && "$_name" != \#* && -n "$_desc" ]] && table_desc["$_name"]="$_desc"
  done < "$DESC_TABLE"
fi

# check_line ACTION KIND NAME [SECTION WHY DESCRIPTION] — one --check line.
# A tab or a newline inside a field would split it, so each becomes a space.
check_line() {
  local out="$1" f
  shift
  for f in "$@"; do
    f="${f//$'\t'/ }"
    out+=$'\t'"${f//$'\n'/ }"
  done
  printf '%s\n' "$out"
}

if (( CHECK )); then
  if (( ! DETAILS )); then
    for pkg in ${new_formulae_arr[@]+"${new_formulae_arr[@]}"};     do check_line add formula "$pkg"; done
    for pkg in ${new_casks_arr[@]+"${new_casks_arr[@]}"};           do check_line add cask "$pkg"; done
    for pkg in ${stale_formulae_arr[@]+"${stale_formulae_arr[@]}"}; do check_line prune formula "$pkg"; done
    for pkg in ${stale_casks_arr[@]+"${stale_casks_arr[@]}"};       do check_line prune cask "$pkg"; done
    exit 0
  fi

  declare -A d_section=() d_reason=() d_desc=()
  meta_args=()
  for pkg in ${new_formulae_arr[@]+"${new_formulae_arr[@]}"}; do meta_args+=("formula:$pkg"); done
  for pkg in ${new_casks_arr[@]+"${new_casks_arr[@]}"};       do meta_args+=("cask:$pkg"); done
  if (( ${#meta_args[@]} > 0 )); then
    command -v python3 >/dev/null 2>&1 || { err "python3 not found — cannot read Homebrew's descriptions"; exit 1; }
    TEMP_META=$(mktemp "${TMPDIR:-/tmp}/mrk-meta.XXXXXX")
    brew_describe "$HOMEBREW" "$DESC_TABLE" "${meta_args[@]}" > "$TEMP_META" \
      || { err "Could not read Homebrew's descriptions"; exit 1; }
    while IFS=$'\x1f' read -r kind name section reason desc have; do
      [[ -n "$name" ]] || continue
      [[ "$kind" == cask ]] && d_section["$kind:$name"]="Casks - $section"
      d_reason["$kind:$name"]="$reason"
      # The words the table holds after the add: its own when it has some,
      # since sync never rewrites a description.
      if [[ "$have" == 1 ]]; then
        d_desc["$kind:$name"]="${table_desc[$name]:-}"
      else
        d_desc["$kind:$name"]="$desc"
      fi
    done < "$TEMP_META"
  fi

  for kind in formula cask; do
    if [[ "$kind" == formula ]]; then list=(${new_formulae_arr[@]+"${new_formulae_arr[@]}"})
    else list=(${new_casks_arr[@]+"${new_casks_arr[@]}"}); fi
    for pkg in ${list[@]+"${list[@]}"}; do
      check_line add "$kind" "$pkg" "${d_section[$kind:$pkg]:-}" "${d_reason[$kind:$pkg]:-}" "${d_desc[$kind:$pkg]:-}"
    done
  done
  for kind in formula cask; do
    if [[ "$kind" == formula ]]; then list=(${stale_formulae_arr[@]+"${stale_formulae_arr[@]}"})
    else list=(${stale_casks_arr[@]+"${stale_casks_arr[@]}"}); fi
    for pkg in ${list[@]+"${list[@]}"}; do
      check_line prune "$kind" "$pkg" "${brewfile_section[$kind:$pkg]:-}" "" "${table_desc[$pkg]:-}"
    done
  done
  exit 0
fi

# ─── 3c. Check a decision made on the command line ──────────────────────────
#
# A decision takes exactly what the picker would have offered: an add or an
# ignore, a package --check lists as add; a prune, one it lists as prune. So
# --add cannot bring back a package sync-ignore names, add a dependency, or
# add an entry twice, and --prune cannot delete the entry of a package that is
# still installed. Each refusal says why and changes nothing.

_listed() {  # _listed NAME WORD... — whether NAME is one of the WORDs
  local want=$1 w
  shift
  for w in "$@"; do [[ "$w" == "$want" ]] && return 0; done
  return 1
}

refuse() { err "$*"; exit 1; }

if [[ -n "$DECIDE" ]]; then
  n="$DECIDE_NAME"
  if [[ "$DECIDE" == prune ]]; then
    as_formula=0; as_cask=0
    _listed "$n" ${stale_formulae_arr[@]+"${stale_formulae_arr[@]}"} && as_formula=1
    _listed "$n" ${stale_casks_arr[@]+"${stale_casks_arr[@]}"} && as_cask=1
  else
    # Ignoring a name the list already has is done, not refused: the run
    # that follows would not offer it either way.
    if [[ "$DECIDE" == ignore ]] && _sync_ignored "$n"; then
      log "$n is already in ~/.mrk/sync-ignore"
      exit 0
    fi
    as_formula=0; as_cask=0
    _listed "$n" ${new_formulae_arr[@]+"${new_formulae_arr[@]}"} && as_formula=1
    _listed "$n" ${new_casks_arr[@]+"${new_casks_arr[@]}"} && as_cask=1
  fi

  case "$DECIDE_KIND" in
    formula) as_cask=0 ;;
    cask)    as_formula=0 ;;
  esac
  kinds=${DECIDE_KIND:-formula or cask}

  # sync-ignore holds names, not kinds: one line drops both, so ignoring a
  # name that is both needs no --formula or --cask.
  if (( as_formula && as_cask )) && [[ "$DECIDE" != ignore ]]; then
    refuse "$n is both a formula and a cask. Add --formula or --cask."
  elif (( as_formula )); then
    DECIDE_KIND=formula
  elif (( as_cask )); then
    DECIDE_KIND=cask
  elif [[ "$DECIDE" == prune ]]; then
    in_brewfile=0
    [[ "$DECIDE_KIND" != cask && -n "${brewfile_formulae[$n]+x}" ]] && in_brewfile=1
    [[ "$DECIDE_KIND" != formula && -n "${brewfile_casks[$n]+x}" ]] && in_brewfile=1
    (( in_brewfile )) || refuse "The Brewfile has no $kinds entry for $n."
    refuse "$n is installed, so sync does not prune its entry. Uninstall it first, or delete the line by hand."
  else
    # Why the picker would not have offered it, most telling reason first.
    if _sync_ignored "$n"; then
      refuse "$n is in ~/.mrk/sync-ignore, so sync does not offer it. Delete it from that file first."
    elif [[ "$DECIDE_KIND" != cask && -n "${brewfile_formulae[$n]+x}" ]] \
      || [[ "$DECIDE_KIND" != formula && -n "${brewfile_casks[$n]+x}" ]]; then
      refuse "$n is already in the Brewfile."
    elif [[ "$DECIDE_KIND" != cask && -n "${installed_formulae_all[$n]+x}" ]]; then
      refuse "$n is installed only as a dependency. sync adds the formulae you installed yourself (brew leaves --installed-on-request)."
    else
      refuse "Homebrew does not list $n as an installed $kinds."
    fi
  fi

  if [[ "$DECIDE" == add ]]; then
    if [[ "$DECIDE_KIND" == formula ]] && (( ! SECTION_GIVEN )); then
      refuse "$n is a formula. Give its section with --section: sync does not guess a formula's section."
    fi
    if [[ "$DECIDE_KIND" == cask ]] && (( SECTION_GIVEN )); then
      refuse "$n is a cask, and sync files a cask by its app's category. Leave out --section."
    fi
  fi

  if [[ "$DECIDE" == ignore ]]; then
    if (( DRY_RUN )); then
      dry "Would add $n to ~/.mrk/sync-ignore"
    else
      _append_sync_ignore "$n"
      log "Added $n to ~/.mrk/sync-ignore"
    fi
    exit 0
  fi
fi

declare -A prune_formulae=()
declare -A prune_casks=()

if [[ "$DECIDE" == prune ]]; then
  # The decision is the selection: one entry, checked in section 3c.
  if [[ "$DECIDE_KIND" == formula ]]; then
    prune_formulae["$DECIDE_NAME"]=1
  else
    prune_casks["$DECIDE_NAME"]=1
  fi
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Sync — Stale Brewfile Entry (not installed)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  printf "    - %s \"%s\"\n" "$([[ "$DECIDE_KIND" == formula ]] && echo brew || echo cask)" "$DECIDE_NAME"
  echo ""
elif (( PRUNE && n_stale > 0 )); then
  echo ""
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "  Sync — Stale Brewfile Entries (not installed)"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

  if (( ${#stale_formulae_arr[@]} > 0 )); then
    echo ""
    echo "  Formulae:"
    for pkg in "${stale_formulae_arr[@]}"; do
      printf "    - brew \"%s\"\n" "$pkg"
    done
  fi
  if (( ${#stale_casks_arr[@]} > 0 )); then
    echo ""
    echo "  Casks:"
    for pkg in "${stale_casks_arr[@]}"; do
      printf "    - cask \"%s\"\n" "$pkg"
    done
  fi
  echo ""

  # Selection UI for pruning

  if command -v gum >/dev/null 2>&1; then
    if (( ${#stale_formulae_arr[@]} > 0 )); then
      # gum renders its own help footer with the live keybindings, so these headers
      # deliberately do not name any key. They used to say "space to toggle"; gum 2.0
      # moved the multi-select toggle to `x`, and the stale hint told people to press
      # a key that selects nothing — enter then confirmed an empty set, silently.
      # Let gum be the only thing that describes gum's keys.
      gum_out=$(gum choose --no-limit \
        --cursor.foreground=196 \
        --selected.foreground=196 \
        --header="Select formulae to REMOVE from Brewfile:" \
        "${stale_formulae_arr[@]}" < /dev/tty 2>/dev/tty) || true
      while IFS= read -r name; do
        [[ -n "$name" ]] && prune_formulae["$name"]=1
      done <<< "$gum_out"
    fi
    if (( ${#stale_casks_arr[@]} > 0 )); then
      gum_out=$(gum choose --no-limit \
        --cursor.foreground=196 \
        --selected.foreground=196 \
        --header="Select casks to REMOVE from Brewfile:" \
        "${stale_casks_arr[@]}" < /dev/tty 2>/dev/tty) || true
      while IFS= read -r name; do
        [[ -n "$name" ]] && prune_casks["$name"]=1
      done <<< "$gum_out"
    fi
  else
    # No gum — list them and confirm all-or-nothing
    printf "Remove all %d stale entries? [y/N] " "$n_stale"
    read -r answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      for pkg in "${stale_formulae_arr[@]}"; do prune_formulae["$pkg"]=1; done
      for pkg in "${stale_casks_arr[@]}"; do prune_casks["$pkg"]=1; done
    fi
  fi
elif (( PRUNE )); then
  log "No stale entries found — Brewfile is clean."
fi

# Removing a Brewfile entry orphans its mrk-picker description, and
# check-picker-desc gates the two one-to-one. Nothing coupled them — sync only
# ever ran the picker as a UI — so a removal looked complete and the mismatch
# surfaced later as a red build: descript on 2026-09-04, then gemini-cli and
# google-chrome@canary on 2026-09-05, the second found by reading CI logs
# rather than by the person who made the change. From 2026-09-08 sync named the
# leftover lines and asked for a hand edit; since 2026-09-18 the prune takes the
# description with it, because a step sync can do exactly is not one to hand
# back. No rebuild follows: the picker looks descriptions up by the names the
# Brewfile gives it, so an entry still compiled into the binary is never read.
#
# A name leaves the table only when no Brewfile entry still uses it.
# check-picker-desc matches by name alone, so a formula and a cask that share a
# name share one description, and pruning one of them must keep it.
#
# awk rather than grep because a package name is not a regex: python@3.12 would
# otherwise match python@3-12. The name is the text before the first tab, and
# the comparison is exact.

# Print, one per line and sorted, the pruned names whose description should go.
_orphaned_descriptions() {
  [[ -f "$DESC_TABLE" ]] || return 0
  local pkg
  for pkg in "${!prune_formulae[@]}" "${!prune_casks[@]}"; do
    [[ -n "${brewfile_formulae[$pkg]+x}" && -z "${prune_formulae[$pkg]+x}" ]] && continue
    [[ -n "${brewfile_casks[$pkg]+x}"    && -z "${prune_casks[$pkg]+x}"    ]] && continue
    printf '%s\n' "$pkg"
  done | sort -u | while IFS= read -r pkg; do
    awk -F'\t' -v want="$pkg" '
      !/^#/ && NF > 1 && $1 == want { found = 1; exit }
      END { exit !found }' "$DESC_TABLE" && printf '%s\n' "$pkg"
  done
  return 0
}

n_prune=$(( ${#prune_formulae[@]} + ${#prune_casks[@]} ))
orphaned_descs=()
if (( n_prune > 0 )); then
  mapfile -t orphaned_descs < <(_orphaned_descriptions)
fi

if (( n_prune > 0 )); then
  if (( DRY_RUN )); then
    echo "  [dry run] Would remove $n_prune entr(ies) from Brewfile."
    if (( ${#orphaned_descs[@]} > 0 )); then
      echo "  [dry run] Would remove ${#orphaned_descs[@]} description(s) from tools/picker/descriptions.tsv: ${orphaned_descs[*]}"
    fi
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  else
    # Build sed patterns to remove matching lines (atomic write via temp file)
    local_sed_args=()
    escaped_pkg=
    BREWFILE_TMP="$(mktemp "${REPO_ROOT}/.Brewfile.XXXXXX")"
    for pkg in "${!prune_formulae[@]}"; do
      escaped_pkg=$(printf '%s\n' "$pkg" | sed 's/[[\.*^$&/]/\\&/g')
      local_sed_args+=(-e "/^brew \"${escaped_pkg}\"/d")
    done
    for pkg in "${!prune_casks[@]}"; do
      escaped_pkg=$(printf '%s\n' "$pkg" | sed 's/[[\.*^$&/]/\\&/g')
      local_sed_args+=(-e "/^cask \"${escaped_pkg}\"/d")
    done

    sed "${local_sed_args[@]}" "$BREWFILE" > "$BREWFILE_TMP"
    replace_brewfile || exit 1

    log "Removed $n_prune stale entr(ies) from Brewfile."
    if (( ${#orphaned_descs[@]} > 0 )); then
      # The Brewfile is already written, so a failure here leaves exactly the
      # state the old warning described. Say so, with the names, and go on.
      if picker_remove_descriptions "$DESC_TABLE" "${orphaned_descs[@]}"; then
        PICKER_CHANGED=1
        log "Removed ${#orphaned_descs[@]} description(s) from tools/picker/descriptions.tsv: ${orphaned_descs[*]}"
      else
        warn "Delete these from tools/picker/descriptions.tsv by hand, or check-picker-desc will fail: ${orphaned_descs[*]}"
      fi
    fi
    echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  fi
elif (( PRUNE && n_stale > 0 )); then
  log "No stale entries selected for removal."
fi

# Section 11 reads these on every path. Declared inside the add flow, they were
# unbound on a prune-only run, so `sync -p -c` pruned the Brewfile and then died
# under set -u before it could commit.
declare -A selected_casks=()
declare -A formula_section_map=()

# join_by SEP WORD... — the words joined by SEP. IFS joins on its first
# character only: until 2026-09-28 the commit message's IFS=', ' gave
# "add a,b", and IFS='; ' "add a,b;remove c" (audit 19, W-18).
join_by() {
  local sep="$1" out="${2-}"
  shift 2 || return 0
  local w
  for w in "$@"; do out+="$sep$w"; done
  printf '%s' "$out"
}

# commit_changes — section 11: commit what this run changed. A function, so
# that the two exits in the add flow reach it too: until 2026-09-28 `sync -p -c`
# that pruned and then added nothing stopped at "No packages selected" with the
# prune uncommitted (audit 19, W-18).
commit_changes() {
  cd "$REPO_ROOT"
  # Stage the description table only when this run edited it, so a run that
  # wrote no description never commits someone's unrelated edit to that file.
  changed_files=()
  git diff --quiet Brewfile 2>/dev/null || changed_files+=("Brewfile")
  if (( PICKER_CHANGED )) && ! git diff --quiet tools/picker/descriptions.tsv 2>/dev/null; then
    changed_files+=("tools/picker/descriptions.tsv")
  fi

  if (( ${#changed_files[@]} == 0 )); then
    log "No changes to commit."
  else
    # Build commit message from adds and removes
    added_pkgs=()
    removed_pkgs=()
    if (( ${#formula_section_map[@]} > 0 )); then
      for pkg in "${!formula_section_map[@]}"; do
        added_pkgs+=("$pkg")
      done
    fi
    if (( ${#selected_casks[@]} > 0 )); then
      for pkg in "${!selected_casks[@]}"; do
        (( selected_casks["$pkg"] == 1 )) && added_pkgs+=("$pkg")
      done
    fi
    if (( ${#prune_formulae[@]} > 0 )); then
      for pkg in "${!prune_formulae[@]}"; do removed_pkgs+=("$pkg"); done
    fi
    if (( ${#prune_casks[@]} > 0 )); then
      for pkg in "${!prune_casks[@]}"; do removed_pkgs+=("$pkg"); done
    fi

    commit_parts=()
    if (( ${#added_pkgs[@]} > 0 )); then
      mapfile -t added_pkgs < <(printf '%s\n' "${added_pkgs[@]}" | sort)
      commit_parts+=("add $(join_by ', ' "${added_pkgs[@]}")")
    fi
    if (( ${#removed_pkgs[@]} > 0 )); then
      mapfile -t removed_pkgs < <(printf '%s\n' "${removed_pkgs[@]}" | sort)
      commit_parts+=("remove $(join_by ', ' "${removed_pkgs[@]}")")
    fi

    commit_msg="sync: $(join_by '; ' "${commit_parts[@]}")"
    git add "${changed_files[@]}"
    git commit -m "$commit_msg"
    log "Committed: $commit_msg"
  fi
}

# A decision to prune is the whole run: commit it when asked, and add nothing.
if [[ "$DECIDE" == prune ]]; then
  (( COMMIT && ! DRY_RUN )) && commit_changes
  exit 0
fi

if (( ${#new_formulae_arr[@]} == 0 && ${#new_casks_arr[@]} == 0 )); then
  # -C, because sync runs from wherever you are: from outside the repository
  # this diff used to fail, and a sync with nothing to do fell through to the
  # prune-only path, never saying the Brewfile was up to date.
  if git -C "$REPO_ROOT" diff --quiet -- Brewfile 2>/dev/null; then
    log "Brewfile is up to date. No new packages found."
    exit 0
  fi
  # Brewfile changed (e.g. prune-only) — skip add UI; commit below if -c
  if (( ! COMMIT )); then
    exit 0
  fi
else
log "Found ${#new_formulae_arr[@]} new formula(e) and ${#new_casks_arr[@]} new cask(s) not in Brewfile."

# ─── 4. Selection UI ─────────────────────────────────────────────────────────

# Packages the user marked for the ignore list inside mrk-picker. Empty on the
# gum path, which has no way to express that and falls back to the 4b prompt.
declare -A tui_ignored=()
USED_PICKER=0

find_picker() {
  local repo_picker="$REPO_ROOT/bin/mrk-picker"
  if [[ -x "$repo_picker" ]]; then echo "$repo_picker"; return; fi
  if command -v mrk-picker >/dev/null 2>&1; then echo "mrk-picker"; return; fi
  echo ""
}

declare -A selected_formulae=()

picker_bin=""
[[ -n "$DECIDE" ]] || picker_bin=$(find_picker)

if [[ "$DECIDE" == add ]]; then
  # The decision is the selection: one package, checked in section 3c.
  if [[ "$DECIDE_KIND" == formula ]]; then
    selected_formulae["$DECIDE_NAME"]=1
  else
    selected_casks["$DECIDE_NAME"]=1
  fi
elif [[ -n "$picker_bin" ]]; then
  # Build a minimal temp Brewfile for mrk-picker
  TEMP_BREWFILE=$(mktemp "${TMPDIR:-/tmp}/mrk.XXXXXX")

  if (( ${#new_formulae_arr[@]} > 0 )); then
    printf '# New Formulae\n' >> "$TEMP_BREWFILE"
    for f in "${new_formulae_arr[@]}"; do
      printf 'brew "%s"\n' "$f" >> "$TEMP_BREWFILE"
    done
    printf '\n' >> "$TEMP_BREWFILE"
  fi
  if (( ${#new_casks_arr[@]} > 0 )); then
    printf '# New Casks\n' >> "$TEMP_BREWFILE"
    for c in "${new_casks_arr[@]}"; do
      printf 'cask "%s"\n' "$c" >> "$TEMP_BREWFILE"
    done
  fi

  picker_out=$("$picker_bin" \
    --brewfile "$TEMP_BREWFILE" \
    --installed-formulae "" \
    --installed-casks "") || true

  # The picker marks each candidate as add (space) or ignore (i), so its output
  # carries both answers. Anything it names as ignored is already a decision —
  # section 4b must not ask about it a second time.
  USED_PICKER=1
  while IFS=: read -r pkg_type pkg_name; do
    [[ -z "$pkg_name" ]] && continue
    case "$pkg_type" in
      formula)        selected_formulae["$pkg_name"]=1 ;;
      cask)           selected_casks["$pkg_name"]=1 ;;
      ignore-formula) tui_ignored["$pkg_name"]=1 ;;
      ignore-cask)    tui_ignored["$pkg_name"]=1 ;;
    esac
  done <<< "$picker_out"

elif command -v gum >/dev/null 2>&1; then
  # Fallback: gum choose
  if (( ${#new_formulae_arr[@]} > 0 )); then
    echo "" > /dev/tty
    gum_out=$(gum choose --no-limit \
      --cursor.foreground=212 \
      --selected.foreground=212 \
      --header="Select formulae to add to Brewfile:" \
      "${new_formulae_arr[@]}" < /dev/tty 2>/dev/tty) || true
    while IFS= read -r name; do
      [[ -n "$name" ]] && selected_formulae["$name"]=1
    done <<< "$gum_out"
  fi
  if (( ${#new_casks_arr[@]} > 0 )); then
    echo "" > /dev/tty
    gum_out=$(gum choose --no-limit \
      --cursor.foreground=212 \
      --selected.foreground=212 \
      --header="Select casks to add to Brewfile:" \
      "${new_casks_arr[@]}" < /dev/tty 2>/dev/tty) || true
    while IFS= read -r name; do
      [[ -n "$name" ]] && selected_casks["$name"]=1
    done <<< "$gum_out"
  fi

else
  err "Neither mrk-picker nor gum is available. Build the picker: make picker"
  exit 1
fi

# Count selections
n_selected_formulae=0
n_selected_casks=0
if (( ${#selected_formulae[@]} > 0 )); then
  for pkg in "${!selected_formulae[@]}"; do
    (( selected_formulae["$pkg"] == 1 )) && ((n_selected_formulae++)) || true
  done
fi
if (( ${#selected_casks[@]} > 0 )); then
  for pkg in "${!selected_casks[@]}"; do
    (( selected_casks["$pkg"] == 1 )) && ((n_selected_casks++)) || true
  done
fi

# ─── 4b. Offer to ignore the declined packages ───────────────────────────────
#
# The candidates the user did not select come back every run. Offer to write
# them to the ignore file, so the file populates itself instead of needing a
# hand edit. This stage touches ONLY the ignore file: it never changes the
# Brewfile. It must run before the "nothing selected" exit below, because
# declining every candidate is exactly the case this is for.
# Mirrors section 5b of scripts/sync-login-items.
#
# A decision made on the command line declines nothing: it says what to do
# with one package, and the others wait for the next run. So it is not asked.

declined_pkgs=()
for pkg in "${new_formulae_arr[@]}"; do
  [[ -n "${selected_formulae[$pkg]+x}" ]] || declined_pkgs+=("$pkg")
done
for pkg in "${new_casks_arr[@]}"; do
  [[ -n "${selected_casks[$pkg]+x}" ]] || declined_pkgs+=("$pkg")
done

if [[ -z "$DECIDE" ]] && (( ${#declined_pkgs[@]} > 0 )); then
  declare -A ignore_selected=()

  if (( USED_PICKER )); then
    # The TUI already asked. Marking nothing there means "ask me again next
    # run", which is a real answer — so an empty set here is honoured, not
    # re-prompted.
    for pkg in "${!tui_ignored[@]}"; do
      ignore_selected["$pkg"]=1
    done
  elif command -v gum >/dev/null 2>&1; then
    echo "" > /dev/tty
    gum_out=$(gum choose --no-limit \
      --cursor.foreground=214 \
      --selected.foreground=214 \
      --header="Select declined packages to add to the ignore list, so they stop reappearing:" \
      "${declined_pkgs[@]}" < /dev/tty 2>/dev/tty) || true
    while IFS= read -r pkg; do
      [[ -n "$pkg" ]] && ignore_selected["$pkg"]=1
    done <<< "$gum_out"
  else
    printf "Add all %d declined package(s) to ~/.mrk/sync-ignore? [y/N] " "${#declined_pkgs[@]}"
    read -r answer </dev/tty
    if [[ "$answer" =~ ^[Yy]$ ]]; then
      for pkg in "${declined_pkgs[@]}"; do ignore_selected["$pkg"]=1; done
    fi
  fi

  if (( ${#ignore_selected[@]} > 0 )); then
    while IFS= read -r pkg; do
      # Defensive: a selected name cannot already be in the list, because the
      # drop stage removed those before the candidates were shown.
      if _sync_ignored "$pkg"; then
        log "$pkg is already in ~/.mrk/sync-ignore"
        continue
      fi
      if (( DRY_RUN )); then
        dry "Would add $pkg to ~/.mrk/sync-ignore"
        continue
      fi
      _append_sync_ignore "$pkg"
      log "Added $pkg to ~/.mrk/sync-ignore"
    done < <(printf '%s\n' "${!ignore_selected[@]}" | sort)
  fi
fi

if (( n_selected_formulae == 0 && n_selected_casks == 0 )); then
  log "No packages selected. Nothing to add."
  (( COMMIT )) && commit_changes
  exit 0
fi

# ─── 5. Look up each selected package in Homebrew ───────────────────────────
#
# Every entry needs two things besides its line, and until 2026-09-27 sync
# supplied neither: a description in tools/picker/descriptions.tsv, which
# check-picker-desc requires of every package, and, for a cask, a section that
# says what kind of app it is. So each add left the gate red until someone wrote
# the description by hand: `sync: add prismlauncher` on 2026-09-24, then
# `picker: describe prismlauncher` to turn main green again.
#
# Both now come from what Homebrew and the app already say about themselves.
#
#   - The description is Homebrew's own `desc`. A cask whose token does not
#     name the product gets its display name in front ("GitHub Desktop — …"),
#     as the hand-written entries do. sync writes a description only where
#     there is none, so rewording one in the table sticks.
#   - A cask's section is the category its app declares: LSApplicationCategoryType
#     in the Info.plist, the vocabulary the App Store uses, mapped onto the
#     Brewfile's `## Casks - X` names by brew_describe in scripts/lib.sh. An app
#     that declares none, or a cask with no app bundle to read, goes to
#     Utilities. sync never moves an entry that is already in the Brewfile, so a
#     line moved by hand stays where it was put.
#
# The lookup and the writing live in scripts/lib.sh since 2026-09-27, when
# check-picker-desc gained --fix for the adds sync does not see: Barkeep's, and
# hand edits. One copy, so a description is worded and placed one way.
#
# A formula's section is still asked for (section 6). Matching each formula's
# description against the other sections' descriptions placed 37 of the
# Brewfile's 53 formulae correctly, which is exactly what "always the first
# section" scores: the formula sections say why a tool is here (Repo essentials,
# Languages / runtimes), not what it does. The prompt shows Homebrew's
# description instead of a guess.

if ! command -v python3 >/dev/null 2>&1; then
  err "python3 not found — cannot modify Brewfile"
  exit 1
fi

sorted_selected_formulae=()
sorted_selected_casks=()
if (( n_selected_formulae > 0 )); then
  mapfile -t sorted_selected_formulae < <(
    for pkg in "${!selected_formulae[@]}"; do
      (( selected_formulae["$pkg"] == 1 )) && printf '%s\n' "$pkg"
    done | sort
  )
fi
if (( n_selected_casks > 0 )); then
  mapfile -t sorted_selected_casks < <(
    for pkg in "${!selected_casks[@]}"; do
      (( selected_casks["$pkg"] == 1 )) && printf '%s\n' "$pkg"
    done | sort
  )
fi

meta_args=()
for pkg in "${sorted_selected_formulae[@]}"; do meta_args+=("formula:$pkg"); done
for pkg in "${sorted_selected_casks[@]}";    do meta_args+=("cask:$pkg");    done

log "Reading Homebrew's descriptions for ${#meta_args[@]} package(s)..."
TEMP_META=$(mktemp "${TMPDIR:-/tmp}/mrk-meta.XXXXXX")

# brew_describe (scripts/lib.sh) prints one record per package: kind, name,
# section (casks only), why that section, description, and 1 when the table
# already describes the name. check-picker-desc --fix reads the same records.
brew_describe "$HOMEBREW" "$DESC_TABLE" "${meta_args[@]}" > "$TEMP_META"

declare -A pkg_desc=()
declare -A pkg_described=()
declare -A cask_section_map=()
declare -A cask_reason=()
while IFS=$'\x1f' read -r kind name section reason desc have; do
  [[ -n "$name" ]] || continue
  pkg_desc["$name"]="$desc"
  pkg_described["$name"]="$have"
  if [[ "$kind" == cask ]]; then
    cask_section_map["$name"]="Casks - $section"
    cask_reason["$name"]="$reason"
  fi
done < "$TEMP_META"

# ─── 6. Section assignment for formulae ──────────────────────────────────────

# Extract formula section headers (skip Taps and Casks)
declare -a formula_sections=()
while IFS= read -r line || [[ -n "$line" ]]; do
  if [[ "$line" =~ ^##[[:space:]](.+) ]]; then
    header="${BASH_REMATCH[1]}"
    case "$header" in
      Taps) continue ;;
      Casks*) continue ;;
    esac
    formula_sections+=("$header")
  fi
done < "$BREWFILE"

# Per-formula section assignment via gum

if (( n_selected_formulae > 0 )); then
  if [[ "$DECIDE" == add ]]; then
    # --section answers the question, and section 3c checked that it was given.
    formula_section_map["$DECIDE_NAME"]="$DECIDE_SECTION"
    if ! _listed "$DECIDE_SECTION" ${formula_sections[@]+"${formula_sections[@]}"}; then
      log "The Brewfile has no '## $DECIDE_SECTION' section yet. sync adds it at the end."
    fi
  elif ! command -v gum >/dev/null 2>&1; then
    warn "gum not available — assigning formulae to '${formula_sections[0]:-CLI Tools}'"
    for pkg in "${sorted_selected_formulae[@]}"; do
      formula_section_map["$pkg"]="${formula_sections[0]:-CLI Tools}"
    done
  else
    for pkg in "${sorted_selected_formulae[@]}"; do
      header="Add formula '$pkg' to which section?"
      [[ -n "${pkg_desc[$pkg]:-}" ]] && header+=$'\n'"${pkg_desc[$pkg]}"
      echo "" > /dev/tty
      section_choice=$(gum choose \
        --cursor.foreground=212 \
        --selected.foreground=212 \
        --header="$header" \
        "${formula_sections[@]}" "New section…" \
        < /dev/tty 2>/dev/tty) || section_choice=""

      if [[ "$section_choice" == "New section…" ]]; then
        new_sec=$(gum input \
          --placeholder "Section name (e.g. Security Tools)" \
          < /dev/tty 2>/dev/tty) || new_sec=""
        if [[ -n "$new_sec" ]]; then
          formula_section_map["$pkg"]="$new_sec"
        fi
        # Empty new_sec → skip this package
      elif [[ -n "$section_choice" ]]; then
        formula_section_map["$pkg"]="$section_choice"
      fi
      # If section_choice is empty (cancelled), package is skipped
    done
  fi
fi

# Recount after possible skips from section picker
n_formula_insertions=0
if (( ${#formula_section_map[@]} > 0 )); then
  n_formula_insertions=${#formula_section_map[@]}
fi

if (( n_formula_insertions == 0 && n_selected_casks == 0 )); then
  log "No packages assigned to sections. Nothing to add."
  (( COMMIT )) && commit_changes
  exit 0
fi

# ─── 7. Build insertions list ────────────────────────────────────────────────

insertions_data=""

for pkg in "${!formula_section_map[@]}"; do
  section="${formula_section_map[$pkg]}"
  insertions_data+="${section}"$'\t'"brew \"${pkg}\""$'\n'
done

for pkg in "${sorted_selected_casks[@]}"; do
  # `greedy: true`, because this Brewfile carries it on every cask.
  #
  # It is not Homebrew's default — `brew bundle dump` emits a bare
  # `cask "name"`, and so did this line, so neither of the two ways a cask
  # can enter the Brewfile maintained the convention. Both casks sync has
  # ever added went in bare, between neighbours that had it (`sync: add
  # softraid`, `sync: add nordpass`), and `onyx` had to be repaired by a
  # later bulk snapshot.
  #
  # Without it `brew bundle` skips the cask when upgrading anything that
  # sets auto_updates or version :latest, so it quietly stops being
  # upgraded by `make update` — the opposite of why it was synced.
  insertions_data+="${cask_section_map[$pkg]}"$'\t'"cask \"${pkg}\", greedy: true"$'\n'
done

# The packages whose description sync will write: added, and not yet described.
# Formulae first, then casks, as the summary lists them; the table puts each in
# name order. A formula and a cask with the same name share one description, as
# check-picker-desc matches by name.
describe_pkgs=()
undescribable=()
declare -A _listed=()
while IFS= read -r pkg; do
  [[ -n "$pkg" && -z "${_listed[$pkg]+x}" ]] || continue
  _listed["$pkg"]=1
  [[ "${pkg_described[$pkg]:-0}" == 1 ]] && continue
  if [[ -n "${pkg_desc[$pkg]:-}" ]]; then
    describe_pkgs+=("$pkg")
  else
    undescribable+=("$pkg")
  fi
done < <(printf '%s\n' "${!formula_section_map[@]}" | sort; printf '%s\n' "${sorted_selected_casks[@]}")

# ─── 8. Show summary ─────────────────────────────────────────────────────────

# The description sync will write for a package, or why it writes none.
_desc_note() {
  local pkg="$1"
  if [[ "${pkg_described[$pkg]:-0}" == 1 ]]; then
    printf '(already described in tools/picker/descriptions.tsv)'
  elif [[ -n "${pkg_desc[$pkg]:-}" ]]; then
    printf '"%s"' "${pkg_desc[$pkg]}"
  else
    printf '(Homebrew has no description — write one in tools/picker/descriptions.tsv)'
  fi
}

echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Sync — Additions to Brewfile"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if (( ${#formula_section_map[@]} > 0 )); then
  echo ""
  echo "  Formulae:"
  while IFS= read -r pkg; do
    printf "    + brew \"%s\"  →  %s\n" "$pkg" "${formula_section_map[$pkg]}"
    printf "        %s\n" "$(_desc_note "$pkg")"
  done < <(printf '%s\n' "${!formula_section_map[@]}" | sort)
fi

if (( n_selected_casks > 0 )); then
  echo ""
  echo "  Casks:"
  for pkg in "${sorted_selected_casks[@]}"; do
    # Show exactly what will be written, greedy modifier included.
    printf "    + cask \"%s\", greedy: true  →  %s  (%s)\n" \
      "$pkg" "${cask_section_map[$pkg]}" "${cask_reason[$pkg]}"
    printf "        %s\n" "$(_desc_note "$pkg")"
  done
fi

echo ""

if (( DRY_RUN )); then
  echo "  [dry run] Brewfile and tools/picker/descriptions.tsv not modified."
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 0
fi

# ─── 9. Apply insertions with Python3 ────────────────────────────────────────

TEMP_INSERTIONS=$(mktemp "${TMPDIR:-/tmp}/mrk-insertions.XXXXXX")
printf '%s' "$insertions_data" > "$TEMP_INSERTIONS"
BREWFILE_TMP="$(mktemp "${REPO_ROOT}/.Brewfile.XXXXXX")"

python3 - "$BREWFILE" "$TEMP_INSERTIONS" "$BREWFILE_TMP" <<'PYEOF'
import sys, re
from collections import defaultdict

src_path        = sys.argv[1]
insertions_path = sys.argv[2]
out_path        = sys.argv[3]

with open(insertions_path) as f:
    raw = f.read().strip()

if not raw:
    # Nothing to insert. Still write the file through unchanged: the caller
    # mv's out_path over the Brewfile unconditionally, so exiting without
    # writing would truncate it to zero bytes.
    with open(src_path) as f:
        out = f.read()
    with open(out_path, 'w') as f:
        f.write(out)
    sys.exit(0)

insertions = []
for line in raw.splitlines():
    if '\t' in line:
        section, entry = line.split('\t', 1)
        insertions.append((section, entry))

with open(src_path) as f:
    lines = f.readlines()

def is_section_header(line):
    s = line.strip()
    return bool(re.match(r'^## ', s))

def find_section_range(lines, section_header):
    """Return (start, end) line indices for the body of a section (exclusive of header)."""
    start = None
    for i, line in enumerate(lines):
        if line.strip() == f'## {section_header}':
            start = i + 1
            continue
        if start is not None and is_section_header(line):
            return (start, i)
    if start is not None:
        return (start, len(lines))
    return None

def pkg_name(line):
    m = re.match(r'(?:brew|cask)\s+"([^"]+)"', line.strip())
    return m.group(1) if m else None

def find_insert_idx(lines, start, end, entry):
    """Find alphabetical insertion index within lines[start:end]."""
    entry_name = pkg_name(entry) or entry
    for i in range(start, end):
        n = pkg_name(lines[i])
        if n and n > entry_name:
            return i
    # Otherwise after the section's last entry, not its last non-blank line: the
    # comment that introduces the cask sections closes the section before them,
    # and a formula sorting last there would land below it.
    for i in range(end - 1, start - 1, -1):
        if pkg_name(lines[i]):
            return i + 1
    # A section with no entries yet: after whatever it holds
    for i in range(end - 1, start - 1, -1):
        if lines[i].strip():
            return i + 1
    return start

# Split into existing-section and new-section insertions
to_insert   = []  # (line_idx, entry)
new_sections = defaultdict(list)  # section_header -> [entries]

for section, entry in insertions:
    rng = find_section_range(lines, section)
    if rng is None:
        new_sections[section].append(entry)
    else:
        start, end = rng
        idx = find_insert_idx(lines, start, end, entry)
        to_insert.append((idx, entry))

# Apply existing-section insertions from bottom to top (avoid index shifting).
# Entries bound for the same line go in last name first, so each pushes the one
# after it down and they read alphabetically; by line alone their order was the
# order bash listed an associative array in.
to_insert.sort(key=lambda x: (x[0], pkg_name(x[1]) or x[1]), reverse=True)
for idx, entry in to_insert:
    lines.insert(idx, entry + '\n')

# A new cask section goes in alphabetical order among the others, directly
# before the first that sorts after it, so the comment introducing them stays
# on top. Any other new section, and a cask section sorting last, is appended.
CASKS = '## Casks - '
for section in sorted(new_sections):
    entries = sorted(new_sections[section], key=lambda e: pkg_name(e) or e)
    block = [f'## {section}\n'] + [entry + '\n' for entry in entries]
    before = None
    if ('## ' + section).startswith(CASKS):
        before = next((i for i, l in enumerate(lines)
                       if l.startswith(CASKS) and l.rstrip('\n') > '## ' + section), None)
    if before is None:
        lines.append('\n')
        lines.extend(block)
    else:
        lines[before:before] = block + ['\n']

with open(out_path, 'w') as f:
    f.writelines(lines)

total = len(to_insert) + sum(len(v) for v in new_sections.values())
print(f'Added {total} entr{"ies" if total != 1 else "y"} to Brewfile.')
PYEOF

replace_brewfile || exit 1

echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""
log "Brewfile updated."

# ─── 10. Describe the new packages in tools/picker/descriptions.tsv ─────────
#
# The descriptions section 5 read from Homebrew, written by
# picker_add_descriptions in scripts/lib.sh, each in name order among the
# table's lines. The Brewfile is written by now, so a failure names what is
# left to describe and goes on, as the prune does.

if (( ${#describe_pkgs[@]} > 0 )); then
  TEMP_DESCS=$(mktemp "${TMPDIR:-/tmp}/mrk-descs.XXXXXX")
  for pkg in "${describe_pkgs[@]}"; do
    printf '%s\t%s\n' "$pkg" "${pkg_desc[$pkg]}" >> "$TEMP_DESCS"
  done
  if picker_add_descriptions "$DESC_TABLE" "$TEMP_DESCS"; then
    PICKER_CHANGED=1
    log "Described ${#describe_pkgs[@]} package(s) in tools/picker/descriptions.tsv: ${describe_pkgs[*]}"
  else
    warn "Describe these in tools/picker/descriptions.tsv by hand, or check-picker-desc will fail: ${describe_pkgs[*]}"
  fi
fi
if (( ${#undescribable[@]} > 0 )); then
  warn "Homebrew has no description for: ${undescribable[*]}"
  warn "Write one in tools/picker/descriptions.tsv, or check-picker-desc will fail."
fi

fi  # end new-package add flow (prune-only skips sections 4–10)

# ─── 11. Optional commit ─────────────────────────────────────────────────────

if (( COMMIT )); then
  commit_changes
fi
