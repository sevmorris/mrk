# Logs
*.log
*.log.*

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-*

# Temporary files
*.tmp
*.temp
*.bak

# Claude Code runtime data — but not the skills, which are versioned here
.claude/*
!.claude/skills/
dotfiles/.claude/

# State that a tool writes under $HOME, written here by a test that used the
# repository as its HOME or XDG directory. gh's .local/state/gh/device-id was
# committed that way in #94.
/.local/
/.config/
/.cache/

# Scratch files at the top of the repository, and Go test binaries. Rooted, so
# that a script under tests/ named test-*.sh is never ignored without a word.
/test-*
*.test

# scripts/sync writes its Brewfile through a temp file in the repo root rather
# than $TMPDIR, deliberately: mv is only atomic within one filesystem, and a
# half-written Brewfile is the failure that atomicity is there to prevent. Do
# not "tidy" that into $TMPDIR. The trap removes it on EXIT, INT and TERM, so
# one survives only a SIGKILL or a crash — at which point it should not be
# sitting in git status forever.
.Brewfile.*

# Built binaries (platform-specific, built via `make picker` / `make mrk-status` / `make mrk-menu`)
bin/mrk-picker
bin/mrk-status
bin/mrk-menu

# Source-tree build artifacts from `go build` inside tools/<name>/
tools/*/mrk-status
tools/*/mrk-picker
tools/*/mrk-menu

# Plists the retired `snapshot` exported here, into the public repository. None
# should remain, and nothing writes them now; the rule stays so that one left on
# an older clone is never committed. Saved preferences live in mrk-prefs.
assets/preferences/*.plist
