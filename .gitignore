# Logs
*.log
*.log.*

# macOS
.DS_Store

# Dev-only scripts (not distributed)
scripts/clean-test
scripts/dev-test.sh
.AppleDouble
.LSOverride
._*

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-*

# Backup directories (if tracked)
backups/

# Temporary files
*.tmp
*.temp
*.bak

# State directories (user-specific)
.mrk/

# Claude Code runtime data
.claude/
dotfiles/.claude/

# Test files
test-*
*.test

# Generated files
MANIFEST.json

# Browser extension lists (user-specific)
assets/browsers/*-extensions.txt

# Homebrew
Brewfile.lock.json

# scripts/sync writes its Brewfile through a temp file in the repo root rather
# than $TMPDIR, deliberately: mv is only atomic within one filesystem, and a
# half-written Brewfile is the failure that atomicity is there to prevent. Do
# not "tidy" that into $TMPDIR. The trap removes it on EXIT, INT and TERM, so
# one survives only a SIGKILL or a crash — at which point it should not be
# sitting in git status forever.
.Brewfile.*

# Built binaries (platform-specific, built via `make picker` / `make mrk-status` / `make mrk-menu`)
bin/mrk-picker
bin/mrk-status
bin/mrk-menu

# Source-tree build artifacts from `go build` inside tools/<name>/
tools/*/mrk-status
tools/*/mrk-picker
tools/*/mrk-menu

# Personal app preferences (captured via `make snapshot-prefs`, stored in ~/.mrk/preferences/)
assets/preferences/*.plist
