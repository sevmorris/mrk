#!/usr/bin/env python3
"""contract-lines — hold the lines of a --check to scripts/mrk-contract.

Usage: tests/lib/contract-lines SCRIPT [OPTION...] < LINES

SCRIPT is a key of the contract's scripts, such as scripts/sync, and each
OPTION is one that went with --check, such as --details. Each line must have
the fields that the contract names for those options, no more and no fewer,
and each field with words must hold one of them. Each of those words must be
on one line at least. A later mrk can add a field or a word, so a program that
reads the lines takes more. This test does not: a field or a word that a
script writes and the contract does not name fails it, and so does a word that
the contract names and no line holds. So the two change in one commit.

The contract comes from the mrk-contract of this checkout. The tests of the
five --check scripts call this on the lines that their golden runs write.
Exits 0 when every line obeys, and 1, with each line that does not, when one
does not or there is no line: a test that passes no line checks nothing.
"""
import json
import os
import subprocess
import sys

here = os.path.dirname(os.path.abspath(__file__))
contract_cmd = os.path.join(here, "..", "..", "scripts", "mrk-contract")

if len(sys.argv) < 2:
    sys.exit("usage: contract-lines SCRIPT [OPTION...] < LINES")
script, options = sys.argv[1], sys.argv[2:]

contract = json.loads(subprocess.run([contract_cmd], check=True, capture_output=True).stdout)
entry = contract["scripts"].get(script)
if entry is None or entry["check"] is None:
    sys.exit(f"contract-lines: the contract has no --check for {script}")
unknown = [o for o in options if o not in entry["check"]["options"]]
if unknown:
    sys.exit(f"contract-lines: {script} --check takes no {' '.join(unknown)} by the contract")
fields = [f for f in entry["check"]["fields"] if f["with"] == "" or f["with"] in options]

# Split at the newline and the tab bytes alone, as BIN-1's rules say. The
# words are ASCII, so the bytes of a field compare as its text.
data = sys.stdin.buffer.read()
lines = [line for line in data.split(b"\n") if line]
problems = []
seen = set()
for n, line in enumerate(lines, 1):
    got = line.split(b"\t")
    if len(got) != len(fields):
        problems.append(f"line {n}: {len(got)} fields, and the contract names {len(fields)}: {line!r}")
        continue
    for f, value in zip(fields, got):
        word = value.decode("utf-8", "replace")
        seen.add((f["field"], word))
        if f["words"] and word not in f["words"]:
            problems.append(f"line {n}: {f['field']} is {value!r}, not one of {', '.join(f['words'])}")
if not lines:
    problems.append("no line to check")
else:
    for f in fields:
        unseen = [w for w in f["words"] if (f["field"], w) not in seen]
        if unseen:
            problems.append(f"no line has {' or '.join(unseen)} for {f['field']}")
for p in problems:
    print(f"    {script}: {p}", file=sys.stderr)
sys.exit(1 if problems else 0)
