#!/usr/bin/env bash

# pushall — commit and push every git repo in ~/Projects, then sync mrk
#
# Adopted into the repo from an untracked ~/bin script. Two changes on
# adoption: every commit is now gated behind the same secret scan mrk-push
# uses, and --dry-run reports what would happen without touching anything.
#
# Only tracked changes are staged (git add -u). Untracked files are never
# swept in — same rule as bin/mrk-push.
#
# Unlike mrk-push, this resolves the mrk repo from its own location rather
# than from `git rev-parse`, so the secret scanner stays available while it
# operates on other repositories.
#
# Usage:
#   pushall [--dry-run] [--projects DIR]

# Re-exec with Homebrew bash if running under bash < 4 (macOS ships bash 3.2)
if (( BASH_VERSINFO[0] < 4 )); then
  for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_brew_bash" ]] && exec "$_brew_bash" "$0" "$@"
  done
  echo "error: bash 4+ required (system bash is ${BASH_VERSION}; install via 'brew install bash')" >&2
  exit 1
fi

set -euo pipefail

# Resolve this script's real path (works when invoked via ~/bin symlink)
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd "$(dirname "$_src")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# scripts/lib.sh (not bin/lib/common.sh) — it owns require_clean_secrets.
# bin/mrk-push sources it for the same reason.
# shellcheck source=../scripts/lib.sh
source "$REPO_ROOT/scripts/lib.sh"

DRY_RUN=0
PROJECTS_DIR="${PROJECTS_DIR:-$HOME/Projects}"
PROJECTS_OVERRIDDEN=0
MRK_DIR="$REPO_ROOT"
SKIP_MRK=0
FAILED=0
LOCAL_ONLY=0
NOT_REPOS=()

usage() {
  cat <<'EOF'
pushall — commit and push every git repo in ~/Projects, then sync mrk

Usage:
  pushall [--dry-run] [--projects DIR] [--no-mrk]

Options:
      --dry-run       Report what would be committed and pushed; change nothing.
                      The secret scan still runs, so this doubles as an audit.
      --projects DIR  Directory of repos to sweep (default: ~/Projects).
                      Giving this also skips the implicit mrk sweep — pass a
                      directory and only that directory is touched.
      --no-mrk        Skip the mrk repo even on a default sweep
  -h, --help          Show this help

A repo is skipped when it has no remote or no upstream tracking branch.
A repo stopped mid-merge, mid-rebase, mid-cherry-pick or with unresolved
conflicts is left untouched and counted as a failure.
Only tracked changes are staged; untracked files are never committed.
Every commit is gated behind the mrk secret scan.

Only the branch each repo is on is pushed. pushall names what it leaves
behind: commits on other branches that are on no remote, stashes, and
folders that are not git repositories. Before a migration, deal with each.
EOF
}

# report_local_only REPO LABEL — name the work in REPO that exists on no remote
# and that this run will not push.
#
# pushall pushes the current branch and nothing else, so before 2026-09-10 a
# commit on any other branch, or a stash, went unmentioned and "Done" read as
# "everything is on GitHub". On a migration that is exactly wrong: the new
# machine gets ~/Projects back from restore-repos, which clones from GitHub,
# and Magic Backup Machine does not back ~/Projects up at all. Informational —
# it does not count as a failure.
report_local_only() {
  local repo=$1 label=$2 n s cur b c
  # Reachable from a local branch, but from no remote-tracking branch and not
  # from HEAD, whose branch this run pushes.
  n=$(git -C "$repo" rev-list --count --branches --not --remotes HEAD 2>/dev/null || echo 0)
  s=$(git -C "$repo" stash list 2>/dev/null | wc -l | tr -d ' ')
  if (( n > 0 )); then
    warn "$label: $n commit(s) on other branches exist on no remote, and pushall will not push them:"
    cur=$(git -C "$repo" symbolic-ref --short -q HEAD || true)
    while IFS= read -r b; do
      [[ "$b" == "$cur" ]] && continue
      c=$(git -C "$repo" rev-list --count "refs/heads/$b" --not --remotes HEAD 2>/dev/null || echo 0)
      if (( c > 0 )); then info "  $b ($c)"; fi
    done < <(git -C "$repo" for-each-ref --format='%(refname:short)' refs/heads)
  fi
  if (( s > 0 )); then
    warn "$label: $s stash(es), which are never pushed"
  fi
  if (( n > 0 || s > 0 )); then
    LOCAL_ONLY=$((LOCAL_ONLY + 1))
  fi
  return 0
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run)   DRY_RUN=1; shift ;;
    --projects)  if [[ -z "${2:-}" ]]; then
                   err "--projects needs a directory"; echo >&2; usage >&2; exit 2
                 fi
                 PROJECTS_DIR="$2"; PROJECTS_OVERRIDDEN=1; shift 2 ;;
    --no-mrk)    SKIP_MRK=1; shift ;;
    -h|--help)   usage; exit 0 ;;
    *)           err "Unknown option: $1"; echo >&2; usage >&2; exit 2 ;;
  esac
done

# process_repo PATH LABEL [PULL_FIRST]
process_repo() {
  local repo="${1%/}" label="$2" pull_first="${3:-0}"
  printf '\n%s\n' "$label" >&2

  if ! git -C "$repo" remote | grep -q .; then
    logskip "$label" "no remote configured"
    return 0
  fi
  # Before anything is staged: `git add -u` in a repository stopped mid-merge
  # marks the conflicted files resolved with their markers in, and the commit
  # below then concludes the merge. It also names a mid-rebase repository
  # correctly, where the upstream test would only say "no upstream".
  local busy
  if busy=$(git_in_progress "$repo"); then
    err "$label: $busy — left untouched; resolve it, then run pushall again"
    FAILED=$((FAILED + 1))
    return 0
  fi
  if ! git -C "$repo" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    logskip "$label" "no upstream tracking branch"
    return 0
  fi

  report_local_only "$repo" "$label"

  local dirty=0
  if ! git -C "$repo" diff --quiet || ! git -C "$repo" diff --cached --quiet; then
    dirty=1
  fi

  if (( dirty )); then
    # HEAD against the working tree is what `git add -u` is about to stage,
    # so the dry run scans the same files the real run does.
    local target=HEAD
    if (( ! DRY_RUN )); then
      git -C "$repo" add -u
      target=--cached
    fi

    local -a scan=() all=()
    if ! commit_paths scan "$repo" "$target"; then
      err "$label: could not list the changed files — not committing"
      if (( ! DRY_RUN )); then
        warn "$label: changes left staged for review (git -C '$repo' reset to unstage)"
      fi
      FAILED=$((FAILED + 1))
      return 0
    fi
    # The count is git's own (renames as one, deletions included); the scan
    # list above leaves deletions out, since they carry no content.
    mapfile -d '' -t all < <(git -C "$repo" diff "$target" --name-only -z --)

    if (( ${#scan[@]} > 0 )); then
      if ! require_clean_secrets "${scan[@]}"; then
        err "$label: secret scan not cleared — skipping this repo"
        if (( ! DRY_RUN )); then
          warn "$label: changes left staged for review (git -C '$repo' reset to unstage)"
        fi
        FAILED=$((FAILED + 1))
        return 0
      fi
    fi

    if (( DRY_RUN )); then
      info "would commit ${#all[@]} file(s)"
    else
      if git -C "$repo" commit -m "snapshot $(date '+%Y-%m-%d %H:%M')" >/dev/null 2>&1; then
        ok "committed ${#all[@]} file(s)"
      else
        err "commit failed"
        FAILED=$((FAILED + 1))
        return 0
      fi
    fi
  fi

  if (( pull_first )); then
    if (( DRY_RUN )); then
      info "would pull"
    elif git -C "$repo" pull >/dev/null 2>&1; then
      ok "pulled"
    else
      err "pull failed"
      FAILED=$((FAILED + 1))
      return 0
    fi
  fi

  # Nothing to push when the branch is already level with its upstream
  local ahead
  ahead="$(git -C "$repo" rev-list --count '@{u}..HEAD' 2>/dev/null || echo 0)"
  if (( ahead == 0 )) && (( ! dirty )); then
    logskip "$label" "up to date"
    return 0
  fi

  if (( DRY_RUN )); then
    info "would push"
  elif git -C "$repo" push >/dev/null 2>&1; then
    ok "pushed"
  else
    err "push failed"
    FAILED=$((FAILED + 1))
  fi
}

if (( DRY_RUN )); then
  log "Dry run — nothing will be committed or pushed"
fi

if [[ ! -d "$PROJECTS_DIR" ]]; then
  err "Projects directory not found: $PROJECTS_DIR"
  exit 1
fi

for repo in "$PROJECTS_DIR"/*/; do
  # A folder with no .git at all is noted rather than passed over in silence:
  # nothing in mrk carries it to a new machine. A .git *file* is a linked
  # worktree, whose repository lives elsewhere; that one stays quiet.
  if [[ ! -e "$repo/.git" ]]; then
    NOT_REPOS+=("$(basename "$repo")")
    continue
  fi
  [[ -d "$repo/.git" ]] || continue
  process_repo "$repo" "$(basename "$repo")"
done

# The mrk sweep is implicit, so it must not fire when the caller has aimed
# this at a specific directory — otherwise `--projects /tmp/x` still commits
# and pushes mrk, which is not what the flag says it does.
if (( SKIP_MRK )); then
  logskip "mrk" "--no-mrk"
elif (( PROJECTS_OVERRIDDEN )); then
  logskip "mrk" "--projects given; sweeping only $PROJECTS_DIR"
elif [[ -d "$MRK_DIR/.git" ]]; then
  process_repo "$MRK_DIR" "mrk (installed copy)" 1
fi

printf '\n' >&2
if (( ${#NOT_REPOS[@]} > 0 )); then
  info "Not git repositories, so pushall and restore-repos never carry them: $(printf '%s, ' "${NOT_REPOS[@]}" | sed 's/, $//')"
fi
if (( LOCAL_ONLY > 0 )); then
  warn "$LOCAL_ONLY repo(s) hold commits or stashes that exist only on this machine — see above"
fi
if (( FAILED > 0 )); then
  err "Done — $FAILED repo(s) failed or were skipped"
  exit 1
fi
ok "Done"
