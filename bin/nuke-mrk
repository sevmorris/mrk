#!/usr/bin/env bash
# shellcheck disable=SC2059  # the colour codes are in the format strings, on purpose
set -euo pipefail

# nuke-mrk — Remove all mrk artifacts for a fresh test install
# Moves ~/mrk and ~/.mrk to Trash; removes ~/bin and dotfile symlinks.
# Optionally runs the defaults, hardening and services rollback scripts first.
# Does NOT uninstall Homebrew packages.

if [[ -t 1 ]]; then
  _B='\033[1m' _D='\033[2m' _R='\033[0m'
  _RED='\033[31m' _GRN='\033[32m' _YLW='\033[33m' _BLU='\033[34m' _CYN='\033[36m'
else
  _B='' _D='' _R='' _RED='' _GRN='' _YLW='' _BLU='' _CYN=''
fi

log()  { printf "${_CYN}[nuke]${_R} %s\n" "$*"; }
ok()   { printf "${_GRN}  ✓${_R} %s\n" "$*"; }
warn() { printf "${_YLW}  ⚠${_R} %s\n" "$*"; }
dim()  { printf "${_D}  · %s${_R}\n" "$*"; }

trash_item() {
  local path="$1" name dest
  name=$(basename "$path")
  dest="$HOME/.Trash/$name"
  [[ -e "$dest" || -L "$dest" ]] && dest="$HOME/.Trash/${name}-$(date +%s)"
  mv "$path" "$dest"
}

# local_only REPO — print, indented, what REPO holds that exists on no remote,
# and return 1 when it holds nothing. The repository is about to go to the
# Trash, and the fresh clone this script ends by suggesting cannot contain any
# of it. Until 2026-09-11 nothing looked: an unpushed commit and an uncommitted
# edit went into the Trash with "✔ Nuked." and no word said.
local_only() {
  local repo="$1" n out=""
  [[ -d "$repo/.git" ]] || return 1
  n=$(git -C "$repo" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
  (( n > 0 )) && out+="      $n uncommitted change(s)\n"
  n=$(git -C "$repo" rev-list --count --branches --not --remotes 2>/dev/null || echo 0)
  if (( n > 0 )); then
    out+="      $n commit(s) on no remote:\n"
    while IFS= read -r line; do
      out+="        $line\n"
    done < <(git -C "$repo" log --oneline --branches --not --remotes 2>/dev/null | head -5)
  fi
  n=$(git -C "$repo" stash list 2>/dev/null | wc -l | tr -d ' ')
  (( n > 0 )) && out+="      $n stash(es)\n"
  [[ -n "$out" ]] || return 1
  printf '%b' "$out"
}

MRK_DIR="$HOME/mrk"
STATE_DIR="$HOME/.mrk"
BIN_DIR="$HOME/bin"

# nuke-mrk is self-contained by design — it has to keep working while it is
# deleting the repository around itself — so the guard is inline rather than
# sourced from scripts/lib.sh. Until 2026-09-10 the flag was discarded and
# `nuke-mrk --help` printed the wipe warning and sat on its [y/N]. The gate
# held, but of every command here this is the one that should answer a question
# with an answer rather than with a prompt.
usage() {
  cat <<'EOF'
nuke-mrk — remove every mrk artifact, for a clean test install

Usage:
  nuke-mrk [--help | -h]

nuke-mrk takes no options other than --help. It moves ~/mrk and ~/.mrk to the
Trash, removes the ~/bin, dotfile and ~/Projects/CLAUDE.md symlinks that point
into them, the two Claude Code skill links and the session hook post-install
added, and unloads and deletes the mrk LaunchAgents. It offers to run the
defaults, hardening and services rollback scripts first, and asks separately
before the defaults one deletes the whole preferences of the apps post-install
imported. Declined, the scripts are kept in ~/.mrk. It does NOT uninstall Homebrew
packages or undo the macOS defaults on its own, and it asks for confirmation
before it starts. Before deleting anything it lists any uncommitted change,
unpushed commit or stash in ~/mrk or ~/.mrk/preferences, and stops unless you
say otherwise.

To remove only the symlinks and keep the repository, use mrk-uninstall.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  ?*)        usage >&2; printf '\nunknown argument: %s\n' "$1" >&2; exit 2 ;;
esac

printf "\n${_B}${_RED}  ☢  nuke-mrk${_R}\n\n"
printf "  This will move to Trash and remove:\n"
printf "  ${_RED}•${_R} ${_B}$MRK_DIR${_R} ${_D}(cloned repo → Trash)${_R}\n"
printf "  ${_RED}•${_R} ${_B}$STATE_DIR${_R} ${_D}(state/backups/rollback → Trash)${_R}\n"
printf "  ${_RED}•${_R} Symlinks in ${_B}$BIN_DIR${_R} ${_D}pointing to mrk${_R}\n"
printf "  ${_RED}•${_R} Dotfile symlinks in ${_B}$HOME${_R} ${_D}pointing to mrk${_R}\n"
printf "  ${_RED}•${_R} mrk ${_B}LaunchAgents${_R} ${_D}(cache-clearing jobs)${_R}\n"
echo ""
printf "  ${_YLW}Does NOT${_R} uninstall Homebrew packages or undo macOS defaults.\n"
echo ""
printf "${_B}Continue? [y/N]:${_R} "
read -r answer
if [[ ! "$answer" =~ ^[Yy]$ ]]; then
  echo "Aborted."
  exit 0
fi

# ── Pre-nuke snapshot ─────────────────────────────────────────────────────────
echo ""
printf "  ${_B}Pre-nuke snapshot${_R}\n\n"
printf "  Sync the Brewfile and snapshot app preferences before wiping. Both are\n"
printf "  pushed, so the fresh install gets them.\n"
echo ""
printf "${_B}Run make sync + snapshot-prefs now? [Y/n]:${_R} "
read -r do_snapshot
if [[ ! "$do_snapshot" =~ ^[Nn]$ ]]; then
  if [[ -f "$MRK_DIR/Makefile" ]]; then
    echo ""
    log "Running make sync..."
    head_before=$(git -C "$MRK_DIR" rev-parse HEAD 2>/dev/null || true)
    if make -C "$MRK_DIR" sync ARGS=-c; then
      ok "Brewfile synced and committed"
      # sync commits and does not push, and until 2026-09-11 that commit went
      # to the Trash with the repository: the pre-nuke sync never reached the
      # fresh clone it existed for. Push it — but only when it is the one
      # commit waiting and touches only the Brewfile, so this never publishes
      # other work of yours. Anything else is left to the check below.
      if [[ -n "$head_before" && "$(git -C "$MRK_DIR" rev-parse HEAD)" != "$head_before" ]] &&
         [[ "$(git -C "$MRK_DIR" rev-parse HEAD~1 2>/dev/null)" == "$(git -C "$MRK_DIR" rev-parse '@{u}' 2>/dev/null)" ]] &&
         [[ "$(git -C "$MRK_DIR" diff --name-only HEAD~1 HEAD)" == "Brewfile" ]]; then
        if git -C "$MRK_DIR" push --quiet; then
          ok "Brewfile commit pushed"
        else
          warn "could not push the Brewfile commit — it is only in $MRK_DIR"
        fi
      fi
    else
      warn "make sync exited with errors"
    fi
    echo ""
    log "Running make snapshot-prefs..."
    if make -C "$MRK_DIR" snapshot-prefs; then
      ok "Preferences snapshotted"
    else
      warn "make snapshot-prefs exited with errors"
    fi
  else
    warn "Makefile not found at $MRK_DIR — skipping"
  fi
else
  dim "Skipping pre-nuke snapshot"
fi

# Keys are a separate offer, and default to no. nuke-mrk does not touch ~/.ssh
# or ~/.gnupg, so this is not protection against nuke-mrk — it is for the case
# where the nuke is a rehearsal for wiping the machine. It also prompts for a
# passphrase and writes a file, which is not something to do on a bare Enter.
echo ""
printf "  ${_B}Key material${_R}\n\n"
printf "  nuke-mrk leaves ~/.ssh and ~/.gnupg alone. If you are about to wipe\n"
printf "  the machine, bundle them now — mrk-prefs never carries private keys.\n"
echo ""
printf "${_B}Bundle ~/.ssh + ~/.gnupg to an encrypted archive? [y/N]:${_R} "
read -r do_keys
if [[ "$do_keys" =~ ^[Yy]$ ]]; then
  if [[ -f "$MRK_DIR/Makefile" ]]; then
    echo ""
    if make -C "$MRK_DIR" snapshot-keys; then
      ok "Keys bundled"
    else
      echo ""
      printf "  ${_RED}${_B}NO KEY ARCHIVE WAS WRITTEN.${_R}\n"
      printf "  ${_YLW}You asked for one, and snapshot-keys failed. Do not treat this\n"
      printf "  machine as backed up.${_R}\n\n"
      printf "  Fix the error above, then run:  ${_B}make -C %s snapshot-keys${_R}\n" "$MRK_DIR"
      echo ""
      printf "${_B}Continue with the nuke anyway? [y/N]:${_R} "
      read -r keys_failed_continue
      if [[ ! "$keys_failed_continue" =~ ^[Yy]$ ]]; then
        echo "Aborted — nothing has been deleted."
        exit 1
      fi
    fi
  else
    warn "Makefile not found at $MRK_DIR — skipping"
  fi
else
  dim "Skipping key bundle"
fi

# ── Work that exists only here ────────────────────────────────────────────────
# Last check before anything is deleted, and after the snapshot, so it sees
# what the snapshot left behind as well — a sync commit that could not be
# pushed, or exports snapshot-prefs staged and then stopped on at its secret
# scan.
held=""
tilde="~"   # from a variable: bash 3.2 and 5 disagree on a literal ~ or \~ here
for repo in "$MRK_DIR" "$STATE_DIR/preferences"; do
  if what=$(local_only "$repo"); then
    held+="    ${repo/#$HOME/$tilde}\n$what"
  fi
done
if [[ -n "$held" ]]; then
  echo ""
  printf "  ${_YLW}${_B}These exist only on this machine.${_R}\n"
  printf "  They would go to the Trash with the repository, and a fresh clone\n"
  printf "  would not have them:\n\n"
  printf '%b' "$held"
  echo ""
  printf "  Save them first: ${_B}mrk-push${_R} commits and pushes ~/mrk, and\n"
  printf "  ${_B}snapshot-prefs${_R} does the same for ~/.mrk/preferences.\n"
  echo ""
  printf "${_B}Continue with the nuke anyway? [y/N]:${_R} "
  read -r held_continue
  if [[ ! "$held_continue" =~ ^[Yy]$ ]]; then
    echo "Aborted — nothing has been deleted."
    exit 1
  fi
fi

echo ""
# Remove the ~/bin symlinks that point into mrk, and any left in ~/.local/bin by
# an installation old enough to have linked there (mrk-uninstall cleans both).
for bin_dir in "$BIN_DIR" "$HOME/.local/bin"; do
  [[ -d "$bin_dir" ]] || continue
  log "Removing mrk symlinks from $bin_dir..."
  while read -r link; do
    target=$(readlink "$link" 2>/dev/null || true)
    if [[ "$target" == "$MRK_DIR"/dotfiles/* || \
          "$target" == "$MRK_DIR"/bin/* || \
          "$target" == "$MRK_DIR"/scripts/* ]]; then
      rm -f "$link"
      ok "$(basename "$link")"
    fi
  done < <(find "$bin_dir" -maxdepth 1 -type l)
done

# Remove dotfile symlinks that point into mrk (both hidden and non-hidden)
log "Removing mrk dotfile symlinks from $HOME..."
for f in "$HOME"/.* "$HOME"/*; do
  [[ -L "$f" ]] || continue
  target=$(readlink "$f" 2>/dev/null || true)
  if [[ "$target" == "$MRK_DIR"/dotfiles/* || \
        "$target" == "$MRK_DIR"/bin/* || \
        "$target" == "$MRK_DIR"/scripts/* ]]; then
    rm -f "$f"
    ok "$(basename "$f")"
  fi
done

# Remove topgrade symlink if it points to mrk
topgrade_link="${XDG_CONFIG_HOME:-$HOME/.config}/topgrade.toml"
if [[ -L "$topgrade_link" ]]; then
  target=$(readlink "$topgrade_link" 2>/dev/null || true)
  if [[ "$target" == "$MRK_DIR"/* ]]; then
    rm -f "$topgrade_link"
    ok "topgrade.toml symlink"
  fi
fi

# Remove the ~/Projects/CLAUDE.md link post-install makes into assets/. It is
# neither in ~/bin nor at the top of $HOME, so until 2026-09-11 it survived the
# nuke pointing at a repository that had gone to the Trash.
claude_link="$HOME/Projects/CLAUDE.md"
if [[ -L "$claude_link" ]]; then
  target=$(readlink "$claude_link" 2>/dev/null || true)
  if [[ "$target" == "$MRK_DIR"/* ]]; then
    rm -f "$claude_link"
    ok "Projects/CLAUDE.md symlink"
  fi
fi

# The two skill links and the SessionStart hook post-install adds for Claude
# Code. Until 2026-09-28 the nuke left all three: the links pointed into a
# repository in the Trash, and the hook ran a script that no longer existed at
# the start of every Claude Code session (audit 19, W-20).
for link in "$HOME/Projects/.claude/skills" "$HOME/.claude/skills/dependency-updates"; do
  if [[ -L "$link" ]]; then
    target=$(readlink "$link" 2>/dev/null || true)
    if [[ "$target" == "$MRK_DIR"/* ]]; then
      rm -f "$link"
      ok "${link#"$HOME"/} symlink"
    fi
  fi
done
# settings.json is Claude Code's file, so only the one entry post-install added
# goes, matched on its exact command, and the rest is left as it was. Written
# back with cat, not mv, so a symlinked settings.json stays a symlink.
claude_settings="$HOME/.claude/settings.json"
# shellcheck disable=SC2016  # the literal text post-install wrote, $HOME and all
deps_hook='bash "$HOME/.claude/skills/dependency-updates/scripts/check.sh" --session'
# The presence test asks jq, as post-install does when it adds the hook: in the
# file its quotes are escaped, so a grep for the command as written never
# matches. Only when jq cannot read the file does a grep for the script's path
# stand in, to say the hook must go by hand rather than leave it without a word.
if [[ -f "$claude_settings" ]] && grep -qF 'dependency-updates/scripts/check.sh' "$claude_settings"; then
  if ! command -v jq >/dev/null 2>&1 || ! jq empty "$claude_settings" >/dev/null 2>&1; then
    warn "could not read $claude_settings to take out the dependency-updates hook — remove it by hand"
  elif jq -e --arg c "$deps_hook" '[.hooks.SessionStart[]?.hooks[]?.command] | index($c)' "$claude_settings" >/dev/null 2>&1; then
    settings_tmp=$(mktemp "${TMPDIR:-/tmp}/mrk-settings.XXXXXX")
    if jq --arg c "$deps_hook" '
         .hooks.SessionStart |= (map(if (.hooks | type) == "array" then .hooks |= map(select(.command != $c)) else . end)
                                 | map(select((.hooks | type) != "array" or (.hooks | length) > 0)))
         | if (.hooks.SessionStart | length) == 0 then del(.hooks.SessionStart) else . end
         | if (.hooks | length) == 0 then del(.hooks) else . end' "$claude_settings" > "$settings_tmp" &&
       cat "$settings_tmp" > "$claude_settings"; then
      ok "dependency-updates hook in ~/.claude/settings.json"
    else
      warn "could not take the dependency-updates hook out of $claude_settings — remove it by hand"
    fi
    rm -f "$settings_tmp"
  fi
fi

# Remove the pre-mrk topgrade config backup created by post-install
topgrade_bak="$HOME/.config/topgrade.toml.bak"
if [[ -f "$topgrade_bak" ]]; then
  trash_item "$topgrade_bak"
  ok "topgrade.toml.bak (→ Trash)"
fi

# Remove the managed browser policy files a previous post-install installed.
#
# The feature is gone — those JSON files are the Linux policy mechanism and
# Chrome on macOS never read them — but this cleanup deliberately stays. The
# files are sitting on any machine that ran post-install before 2026-09-10, and
# deleting the cleanup along with the feature would strand them there for good.
for f in "$HOME/Library/Application Support/Google/Chrome/policies/managed/mrk-policy.json" \
         "$HOME/Library/Application Support/BraveSoftware/Brave-Browser/policies/managed/mrk-policy.json"; do
  if [[ -f "$f" ]]; then
    rm -f "$f"
    ok "$(basename "$(dirname "$(dirname "$(dirname "$f")")")") mrk-policy.json"
  fi
done

# Remove the LaunchAgents installed by post-install. They must be unloaded as
# well as deleted: launchd keeps a job registered until it is booted out, so a
# plist that is merely removed keeps firing on schedule against the ~/bin
# symlinks this script has just deleted.
for label in com.user.clear_app_caches com.user.clear_derived_data; do
  agent="$HOME/Library/LaunchAgents/$label.plist"
  if [[ -f "$agent" ]]; then
    launchctl unload "$agent" >/dev/null 2>&1 || true
    rm -f "$agent"
    ok "$label (unloaded and removed)"
  fi
done

# Login items are deliberately NOT removed.
#
# post-install registers eight, and removing them here was tried and reverted on
# 2026-09-10. The end state is identical either way — the reinstall re-adds them
# — so the only thing a removal buys is that the fresh-install test exercises
# add_login_item's registration branch instead of its "already exists" branch.
# That is narrow, and it is not free:
#
#   - add_login_item creates with `hidden:false` hardcoded. Any item you had set
#     to launch hidden comes back visible.
#   - it creates `at end`, so the order becomes post-install's, not yours.
#
# And the category is wrong. This script does not uninstall Homebrew packages,
# so every app these items point at survives the nuke: the login item is a
# preference about an app that is staying, not an mrk artifact being cleaned up.
# That puts it with the macOS defaults, which are offered as a rollback and
# default to no — not with the symlinks and LaunchAgents above.
#
# To exercise the registration branch, remove one item by hand and re-run
# post-install. That does not need a nuke.

# Offer to run rollback scripts before trashing state dir
DEFAULTS_ROLLBACK="$STATE_DIR/defaults-rollback.sh"
HARDENING_ROLLBACK="$STATE_DIR/hardening-rollback.sh"
# trim-services writes this one. Until 2026-09-27 it was neither offered nor
# kept, and went to the Trash with ~/.mrk while launchd kept the disables. That
# happened on this Mac on 2026-09-24 (audit 19, W-8).
SERVICES_ROLLBACK="$STATE_DIR/services-rollback.sh"
has_rollbacks=0
[[ -f "$DEFAULTS_ROLLBACK" || -f "$HARDENING_ROLLBACK" || -f "$SERVICES_ROLLBACK" ]] && has_rollbacks=1

# The lines of the defaults undo that delete a whole app's preferences, one per
# plist post-install imported: MRK_WHOLE_DOMAIN_UNDO in scripts/lib.sh, copied
# because this script sources nothing. Run now, each takes every setting made
# in that app since, so they are asked about on their own (audit 19, W-13).
WHOLE_DOMAIN_UNDO='^defaults delete [^ ]+ >/dev/null 2>&1 \|\| true$'
app_domains=""
if [[ -f "$DEFAULTS_ROLLBACK" ]]; then
  app_domains=$({ grep -E "$WHOLE_DOMAIN_UNDO" "$DEFAULTS_ROLLBACK" || true; } | awk '{print $3}')
fi
n_apps=0
[[ -n "$app_domains" ]] && n_apps=$(printf '%s\n' "$app_domains" | wc -l | tr -d ' ')

# undo_part FILE settings|apps — run FILE's per-key lines, or only its
# whole-domain deletes, from a copy
undo_part() {
  local tmp rc=0
  tmp=$(mktemp "${TMPDIR:-/tmp}/mrk-undo.XXXXXX") || return 1
  if [[ "$2" == apps ]]; then
    { printf '#!/usr/bin/env bash\n'; grep -E "$WHOLE_DOMAIN_UNDO" "$1" || true; } > "$tmp"
  else
    { grep -vE "$WHOLE_DOMAIN_UNDO" "$1" || true; } > "$tmp"
  fi
  bash "$tmp" || rc=$?
  rm -f "$tmp"
  return "$rc"
}

if (( has_rollbacks )); then
  echo ""
  printf "  Rollback scripts found in ${_B}$STATE_DIR${_R}:\n"
  if [[ -f "$DEFAULTS_ROLLBACK" ]]; then
    if (( n_apps > 0 )); then
      printf "  ${_YLW}•${_R} defaults-rollback.sh — the macOS settings, and the preferences of %s app(s) post-install imported\n" "$n_apps"
    else
      printf "  ${_YLW}•${_R} defaults-rollback.sh\n"
    fi
  fi
  [[ -f "$HARDENING_ROLLBACK" ]] && printf "  ${_YLW}•${_R} hardening-rollback.sh\n"
  [[ -f "$SERVICES_ROLLBACK" ]]  && printf "  ${_YLW}•${_R} services-rollback.sh\n"
  echo ""
  printf "${_B}Run rollback scripts to undo macOS defaults, hardening and services? [y/N]:${_R} "
  read -r run_rollbacks
  run_apps=""
  if [[ "$run_rollbacks" =~ ^[Yy]$ ]] && (( n_apps > 0 )); then
    echo ""
    printf "  The defaults rollback also deletes the whole preferences of these %s app(s):\n" "$n_apps"
    printf '%s\n' "$app_domains" | sed 's/^/    /'
    printf "  Everything set in them since post-install imported them goes too.\n"
    printf "${_B}Delete those apps' preferences as well? [y/N]:${_R} "
    read -r run_apps
  fi
  if [[ "$run_rollbacks" =~ ^[Yy]$ ]]; then
    if [[ -f "$DEFAULTS_ROLLBACK" ]]; then
      log "Running defaults rollback..."
      if undo_part "$DEFAULTS_ROLLBACK" settings; then
        ok "Defaults restored"
      else
        warn "defaults-rollback.sh exited with errors"
      fi
      if [[ "$run_apps" =~ ^[Yy]$ ]]; then
        if undo_part "$DEFAULTS_ROLLBACK" apps; then
          ok "Deleted the preferences of $n_apps app(s)"
        else
          warn "deleting those apps' preferences exited with errors"
        fi
      elif (( n_apps > 0 )); then
        dim "Kept the preferences of $n_apps app(s)"
      fi
    fi
    if [[ -f "$HARDENING_ROLLBACK" ]]; then
      log "Running hardening rollback..."
      if bash "$HARDENING_ROLLBACK"; then
        ok "Hardening undone"
      else
        warn "hardening-rollback.sh exited with errors"
      fi
    fi
    if [[ -f "$SERVICES_ROLLBACK" ]]; then
      log "Running services rollback..."
      if bash "$SERVICES_ROLLBACK"; then
        ok "Services re-enabled"
      else
        warn "services-rollback.sh exited with errors"
      fi
    fi
  else
    dim "Skipping rollback scripts"
  fi
fi

# Remove state directory — except the undo scripts, when they were not run.
#
# Declined, they are the one record of what this Mac held before mrk, and
# every setting they would undo is still in force. Trashed with the rest of
# ~/.mrk, they left a reinstall to write new ones on an already-configured Mac,
# recording mrk's own values as the originals: that is how this machine lost
# its hardening undo script outright, and every original in its defaults one,
# at the reinstall of 2026-09-10. plist-backups/ goes with them, because the
# defaults undo script imports from it. A reinstall keeps what it finds:
# init_rollback does not truncate, and each key's first-run line wins.
keep_undo=()
if (( has_rollbacks )) && [[ ! "${run_rollbacks:-}" =~ ^[Yy]$ ]]; then
  for f in defaults-rollback.sh hardening-rollback.sh services-rollback.sh; do
    if [[ -e "$STATE_DIR/$f" ]]; then keep_undo+=("$f"); fi
  done
  if [[ -e "$STATE_DIR/defaults-rollback.sh" && -d "$STATE_DIR/plist-backups" ]]; then
    keep_undo+=(plist-backups)
  fi
fi
if [[ -d "$STATE_DIR" ]]; then
  undo_stash=""
  if (( ${#keep_undo[@]} > 0 )); then
    undo_stash=$(mktemp -d "${TMPDIR:-/tmp}/mrk-undo.XXXXXX")
    for f in "${keep_undo[@]}"; do mv "$STATE_DIR/$f" "$undo_stash/"; done
  fi
  log "Moving $STATE_DIR to Trash..."
  trash_item "$STATE_DIR"
  ok "$STATE_DIR"
  if [[ -n "$undo_stash" ]]; then
    mkdir -p "$STATE_DIR"
    for f in "${keep_undo[@]}"; do mv "$undo_stash/$f" "$STATE_DIR/"; done
    rmdir "$undo_stash" 2>/dev/null || true
    ok "Kept the undo scripts in $STATE_DIR — the settings they undo are still applied"
  fi
else
  dim "$STATE_DIR (not found)"
fi

# Remove the update-check cache (written by check-updates)
CACHE_DIR="$HOME/.cache/mrk"
if [[ -d "$CACHE_DIR" ]]; then
  trash_item "$CACHE_DIR"
  ok "$CACHE_DIR"
fi

# Remove cloned repo
if [[ -d "$MRK_DIR" ]]; then
  log "Moving $MRK_DIR to Trash..."
  trash_item "$MRK_DIR"
  ok "$MRK_DIR"
else
  dim "$MRK_DIR (not found)"
fi

# Offer to remove Barkeep (installed by mrk post-install)
if [[ -d "/Applications/Barkeep.app" ]]; then
  echo ""
  printf "${_B}Remove Barkeep.app from /Applications? [y/N]:${_R} "
  read -r remove_barkeep
  if [[ "$remove_barkeep" =~ ^[Yy]$ ]]; then
    log "Removing Barkeep.app..."
    if brew list --cask barkeep &>/dev/null; then
      if brew uninstall --cask barkeep 2>/dev/null; then
        ok "Uninstalled via brew"
      else
        trash_item "/Applications/Barkeep.app"
        ok "Moved /Applications/Barkeep.app to Trash"
      fi
    else
      trash_item "/Applications/Barkeep.app"
      ok "Moved /Applications/Barkeep.app to Trash"
    fi
  else
    dim "Keeping Barkeep.app"
  fi
fi

# Offer to remove KeyVault (installed by mrk post-install).
# KeyVault has no Homebrew cask, so the app is trashed directly.
if [[ -d "/Applications/KeyVault.app" ]]; then
  echo ""
  printf "  ${_YLW}nuke-mrk never touches your secrets.${_R}\n"
  printf "  ${_D}KeyVault's API keys and notes stay in the login Keychain. Your SSH\n"
  printf "  and GPG keys stay in ~/.ssh and ~/.gnupg — KeyVault only indexes those,\n"
  printf "  so trashing the app leaves all three where they are.${_R}\n"
  echo ""
  printf "${_B}Remove KeyVault.app from /Applications? [y/N]:${_R} "
  read -r remove_keyvault
  if [[ "$remove_keyvault" =~ ^[Yy]$ ]]; then
    log "Removing KeyVault.app..."
    trash_item "/Applications/KeyVault.app"
    ok "Moved /Applications/KeyVault.app to Trash"
  else
    dim "Keeping KeyVault.app"
  fi
fi

# Offer to remove oh-my-zsh (installed by make setup's shell phase)
if [[ -d "$HOME/.oh-my-zsh" ]]; then
  echo ""
  printf "${_B}Remove oh-my-zsh (~/.oh-my-zsh)? [y/N]:${_R} "
  read -r remove_omz
  if [[ "$remove_omz" =~ ^[Yy]$ ]]; then
    trash_item "$HOME/.oh-my-zsh"
    ok "$HOME/.oh-my-zsh (→ Trash)"
  else
    dim "Keeping $HOME/.oh-my-zsh"
  fi
fi

# Offer to remove the openjdk symlink created by post-install.
# System path — removed explicitly via sudo, never by a general rm block.
JDK_LINK="/Library/Java/JavaVirtualMachines/openjdk.jdk"
if [[ -L "$JDK_LINK" ]]; then
  echo ""
  printf "${_B}Remove openjdk symlink $JDK_LINK? (requires sudo) [y/N]:${_R} "
  read -r remove_jdk
  if [[ "$remove_jdk" =~ ^[Yy]$ ]]; then
    if sudo rm -f "$JDK_LINK"; then
      ok "openjdk.jdk symlink"
    else
      warn "failed to remove $JDK_LINK"
    fi
  else
    dim "Keeping $JDK_LINK"
  fi
fi

# Clean up log files
for f in "$HOME/mrk-install.log" "$HOME/mrk-install.log.old"; do
  if [[ -f "$f" ]]; then
    trash_item "$f"
    ok "$(basename "$f")"
  fi
done

echo ""
printf "${_GRN}${_B}  ✔  Nuked.${_R}\n"
echo ""
printf "  ${_D}Fresh install:${_R}\n"
echo ""
printf "  ${_CYN}git clone https://github.com/sevmorris/mrk.git ~/mrk${_R}\n"
printf "  ${_CYN}make -C ~/mrk all${_R}\n"
echo ""
printf "  ${_D}Then reload your shell:${_R}\n"
echo ""
printf "  ${_CYN}exec zsh${_R}\n"
echo ""
