#!/usr/bin/env bash

# mrk-push — commit, push, and prune old GitHub Pages deployments
# Usage: mrk-push "commit message"
#        mrk-push            (prompts for message)

# Re-exec with Homebrew bash if running under bash < 4 (macOS ships bash 3.2).
# This script uses mapfile, which bash 3.2 does not have; without the guard it
# died with "mapfile: command not found" partway through, after staging.
if (( BASH_VERSINFO[0] < 4 )); then
  for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_brew_bash" ]] && exec "$_brew_bash" "$0" "$@"
  done
  echo "error: bash 4+ required (system bash is ${BASH_VERSION}; install via 'brew install bash')" >&2
  exit 1
fi

set -euo pipefail

# Resolve this script's real path (works when invoked via ~/bin symlink)
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd "$(dirname "$_src")" && pwd)"

if ! command -v gh >/dev/null 2>&1; then
  echo "error: gh CLI not found. Install with: brew install gh" >&2
  exit 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "error: Not inside a git repository." >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
source "$REPO_ROOT/scripts/lib.sh"

push_log() { log "push: $*"; }

# Commit message
msg="${1:-}"
if [[ -z "$msg" ]]; then
  printf "Commit message: "
  read -r msg < /dev/tty
fi
if [[ -z "$msg" ]]; then
  err "Commit message required."
  exit 1
fi

# Detect GitHub repo (owner/name) from remote
remote_url=$(git remote get-url origin 2>/dev/null || true)
if [[ -z "$remote_url" ]]; then
  err "No 'origin' remote found."
  exit 1
fi
repo=$(echo "$remote_url" \
  | sed 's|git@github.com:||; s|https://github.com/||; s|\.git$||')
if [[ -z "$repo" || "$repo" == "$remote_url" ]]; then
  err "Could not parse GitHub repo from remote: $remote_url"
  exit 1
fi
if [[ ! "$repo" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$ ]]; then
  err "Parsed repo '$repo' does not match expected owner/name format"
  exit 1
fi

echo ""
push_log "Repo: $repo"
echo ""

# ── Commit ────────────────────────────────────────────────────────────────────
push_log "Staging changes..."
# Tracked updates + known repo paths only — never `git add -A`
git add -u
for path in Brewfile Makefile README.md dotfiles scripts bin tools docs assets; do
  [[ -e "$REPO_ROOT/$path" ]] && git add "$REPO_ROOT/$path" 2>/dev/null || true
done

if git diff --cached --quiet; then
  warn "Nothing to commit."
else
  mapfile -t staged_files < <(git diff --cached --name-only --diff-filter=AM)
  if (( ${#staged_files[@]} > 0 )); then
    require_clean_secrets "${staged_files[@]}" || exit 1
  fi
  git commit -m "$msg"
  ok "Committed: $msg"
fi

# ── Push ──────────────────────────────────────────────────────────────────────
push_log "Pushing..."
git push
ok "Pushed to origin."

# ── Prune deployments ─────────────────────────────────────────────────────────
echo ""

# Delegated to bin/prune-deployments rather than kept as a second copy here.
#
# The copy this replaced deleted everything except ids[0], the newest
# deployment. That is wrong precisely when this runs: the push above has just
# created a deployment, so ids[0] is usually the new queued or in-progress one
# while the deployment actually serving the site is the older, successful one
# this then deleted — taking the published page offline until the new build
# finished, or indefinitely if it failed. prune-deployments already protects the
# most recent successful deployment, and --keep 1 preserves the old intent.
pruner="$SCRIPT_DIR/prune-deployments"
if [[ ! -x "$pruner" ]]; then
  warn "prune-deployments not found at $pruner — skipping deployment pruning."
  echo ""
  exit 0
fi

"$pruner" --repo "$repo" --keep 1 || warn "Deployment pruning reported errors."

echo ""
ok "Done."
echo ""
