#!/usr/bin/env bash

# mrk-push — commit, push, and prune old GitHub Pages deployments
# Usage: mrk-push "commit message"
#        mrk-push            (prompts for message)

# Re-exec with Homebrew bash if running under bash < 4 (macOS ships bash 3.2).
# This script uses mapfile, which bash 3.2 does not have; without the guard it
# died with "mapfile: command not found" partway through, after staging.
if (( BASH_VERSINFO[0] < 4 )); then
  for _brew_bash in /opt/homebrew/bin/bash /usr/local/bin/bash; do
    [[ -x "$_brew_bash" ]] && exec "$_brew_bash" "$0" "$@"
  done
  echo "error: bash 4+ required (system bash is ${BASH_VERSION}; install via 'brew install bash')" >&2
  exit 1
fi

set -euo pipefail

# Resolve this script's real path (works when invoked via ~/bin symlink)
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
SCRIPT_DIR="$(cd "$(dirname "$_src")" && pwd)"

if ! command -v gh >/dev/null 2>&1; then
  echo "error: gh CLI not found. Install with: brew install gh" >&2
  exit 1
fi

if ! git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "error: Not inside a git repository." >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel)"
# shellcheck source=/dev/null
source "$REPO_ROOT/scripts/lib.sh"

push_log() { log "push: $*"; }

usage() {
  cat <<'EOF'
mrk-push — commit, push, and prune old GitHub Pages deployments

Usage:
  mrk-push "commit message"
  mrk-push                    Prompt for the message
  mrk-push --dry-run          Report what would happen; change nothing
  mrk-push -- "-starts with a dash"

Options:
  -n, --dry-run   Report what would be staged, committed, pushed and pruned,
                  and change nothing. The secret scan still runs, so this
                  doubles as an audit of what is about to leave the machine.
  -h, --help      Show this help

Only tracked changes are staged; untracked files are never committed. The
commit is gated behind the mrk secret scan, and old Pages deployments are
pruned afterwards, always protecting the one currently serving the site.
EOF
}

# Options must be parsed, not taken as the message. Until this existed the
# script read `msg="${1:-}"` straight off the command line with no option
# handling at all, so every flag became a commit message: `mrk-push --help`
# committed the working tree and pushed it with "--help" as the subject, which
# is exactly what happened on 2026-09-09 and needed an amend and a force-push
# to undo. `--` still lets a message legitimately start with a dash.
DRY_RUN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    -n|--dry-run) DRY_RUN=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --)        shift; break ;;
    -*)        err "Unknown option: $1"; echo >&2; usage >&2; exit 2 ;;
    *)         break ;;
  esac
done

# Commit message.
#
# The `*)` arm above breaks out of option parsing on the first non-dash
# argument, which leaves every remaining word in "$@". Taking only $1 meant an
# unquoted message silently truncated to its first word — `mrk-push fix the
# login bug` committed "fix" and discarded the rest, with nothing said. Refuse
# instead, and show the line that would have worked.
if (( $# > 1 )); then
  err "Too many arguments — the commit message must be quoted"
  printf '\n  mrk-push "%s"\n\n' "$*" >&2
  usage >&2
  exit 2
fi
msg="${1:-}"
# A dry run commits nothing, so do not stop to ask for a subject line.
if [[ -z "$msg" ]] && (( DRY_RUN )); then
  msg="(dry run — no commit)"
fi
if [[ -z "$msg" ]]; then
  printf "Commit message: "
  read -r msg < /dev/tty
fi
if [[ -z "$msg" ]]; then
  err "Commit message required."
  exit 1
fi

# Detect GitHub repo (owner/name) from remote
remote_url=$(git remote get-url origin 2>/dev/null || true)
if [[ -z "$remote_url" ]]; then
  err "No 'origin' remote found."
  exit 1
fi
repo=$(echo "$remote_url" \
  | sed 's|git@github.com:||; s|https://github.com/||; s|\.git$||')
if [[ -z "$repo" || "$repo" == "$remote_url" ]]; then
  err "Could not parse GitHub repo from remote: $remote_url"
  exit 1
fi
if [[ ! "$repo" =~ ^[a-zA-Z0-9._-]+/[a-zA-Z0-9._-]+$ ]]; then
  err "Parsed repo '$repo' does not match expected owner/name format"
  exit 1
fi

echo ""
push_log "Repo: $repo"
echo ""

# ── Commit ────────────────────────────────────────────────────────────────────
# Before anything is staged. `git add -u` in a repository stopped mid-merge
# marks the conflicted files resolved, markers and all, and the commit below
# would then conclude the merge with them in.
if busy=$(git_in_progress "$REPO_ROOT"); then
  err "$busy in $REPO_ROOT — resolve it first. Nothing was staged, committed or pushed."
  exit 1
fi

push_log "Staging changes..."
# Tracked updates + known repo paths only — never `git add -A`
PATHS=(Brewfile Makefile README.md dotfiles scripts bin tools docs assets)

# Two separate questions. staged_files answers "what does the secret scan
# read": the absolute path of every file whose content the commit carries.
# `nothing` answers "is there a commit at all". They used to be one list, so a
# commit that only deletes or renames — no content to scan — was reported as
# "Nothing to commit.", pushed without it, and left staged with the message
# discarded. And the list held root-relative paths the scanner then opened from
# the current directory, so run from docs/ it read no file at all and passed.
staged_files=()
nothing=0
if (( DRY_RUN )); then
  # `git add --dry-run` is git's own answer to "what would this stage", which
  # beats reconstructing it from `git status`: it applies the same pathspec and
  # gitignore rules the real add would, including untracked files inside the
  # listed directories. Output is `add 'path'` or `remove 'path'`, one per
  # line, relative to the top level whatever the current directory.
  mapfile -t would_stage < <(
    git add -u --dry-run
    for path in "${PATHS[@]}"; do
      [[ -e "$REPO_ROOT/$path" ]] && git add --dry-run "$REPO_ROOT/$path" 2>/dev/null || true
    done
  )
  # It does not mention what is already staged, which is committed all the
  # same: a `git mv`, or a file added by hand.
  if ! commit_paths staged_files "$REPO_ROOT" --cached; then
    err "Could not list the staged files."
    exit 1
  fi
  declare -A seen=()
  for f in ${staged_files[@]+"${staged_files[@]}"}; do seen["$f"]=1; done
  for line in ${would_stage[@]+"${would_stage[@]}"}; do
    [[ "$line" =~ ^add\ \'(.*)\'$ ]] || continue
    f="$REPO_ROOT/${BASH_REMATCH[1]}"
    [[ -n "${seen[$f]:-}" ]] && continue
    seen["$f"]=1
    staged_files+=("$f")
  done
  if (( ${#would_stage[@]} == 0 )) && git diff --cached --quiet; then nothing=1; fi
else
  git add -u
  for path in "${PATHS[@]}"; do
    [[ -e "$REPO_ROOT/$path" ]] && git add "$REPO_ROOT/$path" 2>/dev/null || true
  done
  if ! commit_paths staged_files "$REPO_ROOT" --cached; then
    err "Could not list the staged files — nothing was committed."
    exit 1
  fi
  if git diff --cached --quiet; then nothing=1; fi
fi

if (( nothing )); then
  warn "Nothing to commit."
else
  # The scan runs in both modes on purpose: a dry run is the safe way to see
  # what a push would expose before it exposes it.
  if (( ${#staged_files[@]} > 0 )); then
    require_clean_secrets "${staged_files[@]}" || exit 1
  fi
  if (( DRY_RUN )); then
    dry "Would commit: $msg"
    for f in ${staged_files[@]+"${staged_files[@]}"}; do
      printf '      %s\n' "${f#"$REPO_ROOT"/}" >&2
    done
  else
    git commit -m "$msg"
    ok "Committed: $msg"
  fi
fi

# ── Push ──────────────────────────────────────────────────────────────────────
push_log "Pushing..."
if (( DRY_RUN )); then
  dry "Would push to origin."
else
  git push
  ok "Pushed to origin."
fi

# ── Prune deployments ─────────────────────────────────────────────────────────
echo ""

# Delegated to bin/prune-deployments rather than kept as a second copy here.
#
# The copy this replaced deleted everything except ids[0], the newest
# deployment. That is wrong precisely when this runs: the push above has just
# created a deployment, so ids[0] is usually the new queued or in-progress one
# while the deployment actually serving the site is the older, successful one
# this then deleted — taking the published page offline until the new build
# finished, or indefinitely if it failed. prune-deployments already protects the
# most recent successful deployment, and --keep 1 preserves the old intent.
pruner="$SCRIPT_DIR/prune-deployments"
if [[ ! -x "$pruner" ]]; then
  warn "prune-deployments not found at $pruner — skipping deployment pruning."
  echo ""
  exit 0
fi

if (( DRY_RUN )); then
  "$pruner" --repo "$repo" --keep 1 --dry-run || warn "Deployment pruning reported errors."
else
  "$pruner" --repo "$repo" --keep 1 || warn "Deployment pruning reported errors."
fi

echo ""
ok "Done."
echo ""
