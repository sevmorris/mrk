#!/bin/bash

# Runs unattended from a LaunchAgent, so it sets -u: an unset or empty HOME
# would turn every path below into an absolute one outside the home directory.
# -e is deliberately NOT set — these are best-effort removals, and one cache
# that will not delete should not stop the rest from being cleared.
set -uo pipefail

# These two clear-* scripts run unattended from a LaunchAgent and deliberately
# depend on nothing but themselves, so this is the one place the shared
# mrk_help_guard in scripts/lib.sh is spelled out inline rather than sourced —
# resolving the ~/bin symlink to reach the library would add a repo dependency
# to an unattended job in order to save four lines. The behaviour is identical:
# help on -h/--help, refuse anything else. Both halves matter. With no parser
# at all the flag was simply discarded, so `clear-app-caches --help` cleared
# the caches instead of describing what it clears.
usage() {
  cat <<'EOF'
clear-app-caches — delete cached data for the browsers and Electron apps

Usage:
  clear-app-caches

Options:
  -h, --help      Show this help

clear-app-caches takes no options other than --help. It removes the cache
directories of Helium, Slack, Discord, VS Code, Spotify and Chrome, for every
browser profile. Nothing is prompted and nothing is kept — the caches rebuild
on next launch. Profile data, and Spotify's offline downloads, are not caches
and are left alone. The com.user.clear_app_caches LaunchAgent runs it on a
schedule.
EOF
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
  ?*)        usage >&2; printf '\nunknown argument: %s\n' "$1" >&2; exit 2 ;;
esac

if [[ -z "${HOME:-}" || ! -d "$HOME" ]]; then
  echo "error: HOME is unset or not a directory — refusing to remove anything" >&2
  exit 1
fi

# Helium. Chromium on macOS keeps each profile's HTTP cache and code cache under
# ~/Library/Caches — the one line below takes every profile's — and its GPU
# caches inside each profile folder. Measured 2026-09-10: seven of the eight
# paths this used to name (a Default/Cache and Code Cache under Application
# Support, four browser-level shader caches, Crashpad) did not exist, so only
# the Library/Caches line had ever removed anything, and the per-profile GPU
# caches never went.
rm -rf "$HOME/Library/Caches/net.imput.helium"
for _profile in "$HOME/Library/Application Support/net.imput.helium/"*/; do
  rm -rf "${_profile}GPUCache" "${_profile}DawnGraphiteCache" "${_profile}DawnWebGPUCache"
done

# Slack
rm -rf "$HOME/Library/Application Support/Slack/Cache"
rm -rf "$HOME/Library/Application Support/Slack/Code Cache"
rm -rf "$HOME/Library/Application Support/Slack/Service Worker/CacheStorage"
rm -rf "$HOME/Library/Caches/com.tinyspeck.slackmacgap"

# Discord
rm -rf "$HOME/Library/Application Support/discord/Cache"
rm -rf "$HOME/Library/Application Support/discord/Code Cache"
rm -rf "$HOME/Library/Caches/com.hnc.Discord"

# VS Code
rm -rf "$HOME/Library/Application Support/Code/Cache"
rm -rf "$HOME/Library/Application Support/Code/Code Cache"
rm -rf "$HOME/Library/Application Support/Code/CachedData"
rm -rf "$HOME/Library/Caches/com.microsoft.VSCode"

# Spotify. Only its Library/Caches folder. Application Support/Spotify/
# PersistentCache used to go too, but Spotify's default offline-storage
# location is PersistentCache/Storage: that line would have deleted every
# downloaded playlist once a day, and downloads do not "rebuild on next launch"
# the way the caches this script promises to clear do.
rm -rf "$HOME/Library/Caches/com.spotify.client"

# Google Chrome — every profile, not just Default. Chrome names profiles
# "Default", "Profile 1", "Profile 4"…, and on this Mac Default was empty while
# Profiles 1, 4 and 10 held 2.3 GB of cache this job had never touched
# (measured 2026-09-10). "Media Cache" is gone from Chromium and was dropped.
for _profile in "$HOME/Library/Caches/Google/Chrome/"*/; do
  rm -rf "${_profile}Cache" "${_profile}Code Cache"
done
