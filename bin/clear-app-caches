#!/bin/bash

# Helium
rm -rf "$HOME/Library/Application Support/net.imput.helium/Default/Cache"
rm -rf "$HOME/Library/Application Support/net.imput.helium/Default/Code Cache"
rm -rf "$HOME/Library/Application Support/net.imput.helium/ShaderCache"
rm -rf "$HOME/Library/Application Support/net.imput.helium/GrShaderCache"
rm -rf "$HOME/Library/Application Support/net.imput.helium/GraphiteDawnCache"
rm -rf "$HOME/Library/Application Support/net.imput.helium/GPUPersistentCache"
rm -rf "$HOME/Library/Application Support/net.imput.helium/Crashpad"
rm -rf "$HOME/Library/Caches/net.imput.helium"

# Slack
rm -rf "$HOME/Library/Application Support/Slack/Cache"
rm -rf "$HOME/Library/Application Support/Slack/Code Cache"
rm -rf "$HOME/Library/Application Support/Slack/Service Worker/CacheStorage"
rm -rf "$HOME/Library/Caches/com.tinyspeck.slackmacgap"

# Discord
rm -rf "$HOME/Library/Application Support/discord/Cache"
rm -rf "$HOME/Library/Application Support/discord/Code Cache"
rm -rf "$HOME/Library/Caches/com.hnc.Discord"

# VS Code
rm -rf "$HOME/Library/Application Support/Code/Cache"
rm -rf "$HOME/Library/Application Support/Code/Code Cache"
rm -rf "$HOME/Library/Application Support/Code/CachedData"
rm -rf "$HOME/Library/Caches/com.microsoft.VSCode"

# Spotify
rm -rf "$HOME/Library/Application Support/Spotify/PersistentCache"
rm -rf "$HOME/Library/Caches/com.spotify.client"

# Google Chrome
rm -rf "$HOME/Library/Caches/Google/Chrome/Default/Cache"
rm -rf "$HOME/Library/Caches/Google/Chrome/Default/Code Cache"
rm -rf "$HOME/Library/Caches/Google/Chrome/Default/Media Cache"
