#!/usr/bin/env bash
set -euo pipefail

# Personal snapshot tool — export current machine prefs into mrk
# Updates: ~/mrk/assets/preferences/

# Resolve this script's real path (works when invoked via ~/bin symlink)
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  _dir="$(cd "$(dirname "$_src")" && pwd)"
  _src="$(readlink "$_src")"
  [[ "$_src" != /* ]] && _src="$_dir/$_src"
done
REPO_ROOT="$(cd "$(dirname "$_src")/.." && pwd)"
PREFS_DIR="$REPO_ROOT/assets/preferences"

log()  { printf "[snapshot] %s\n" "$*"; }
warn() { printf "[snapshot] Warning: %s\n" "$*" >&2; }

OPT_BREWFILE=0

usage() {
  cat <<EOF
Usage: snapshot [--brewfile] [--help]

Export current machine preferences into mrk (${REPO_ROOT}).

Options:
  --brewfile    Also dump Homebrew Brewfile (off by default; destructive)
  --help        Show this help
EOF
}

for arg in "$@"; do
  case "$arg" in
    --brewfile) OPT_BREWFILE=1 ;;
    --help|-h)  usage; exit 0 ;;
    *) warn "Unknown argument: $arg"; usage >&2; exit 2 ;;
  esac
done

###############################################################################
# Plist exports                                                               #
###############################################################################

export_plist() {
  local app_path="$1" bundle_id="$2" dest_file="$3" name="$4"
  local existing="$HOME/Library/Preferences/${bundle_id}.plist"
  local sandboxed="$HOME/Library/Containers/${bundle_id}/Data/Library/Preferences/${bundle_id}.plist"

  if [[ ! -d "$app_path" ]]; then
    log "Skipping $name (not installed)"
    return 0
  fi
  if [[ ! -f "$existing" && ! -f "$sandboxed" ]]; then
    log "Skipping $name (no preferences found)"
    return 0
  fi
  # The file outside the container first, by path. Given the bare bundle id,
  # defaults reads the container's copy whenever it holds one — including a
  # copy left behind by a sandboxed build the app has since dropped — so the
  # preference order this function used to compute never reached the export.
  local src="$bundle_id"
  [[ -f "$existing" ]] && src="${existing%.plist}"
  defaults export "$src" "$dest_file"
  plutil -convert xml1 "$dest_file"
  log "Exported $name → assets/preferences/$(basename "$dest_file")"
}

export_plist "/Applications/BetterSnapTool.app" "com.hegenberg.BetterSnapTool" \
  "$PREFS_DIR/BetterSnapTool.plist" "BetterSnapTool"

export_plist "/Applications/Ice.app" "com.jordanbaird.Ice" \
  "$PREFS_DIR/Ice.plist" "Ice"

export_plist "/Applications/iTerm.app" "com.googlecode.iterm2" \
  "$PREFS_DIR/iTerm2.plist" "iTerm2"

export_plist "/Applications/AlDente.app" "com.apphousekitchen.aldente-pro" \
  "$PREFS_DIR/AlDente.plist" "AlDente"

export_plist "/Applications/Amphetamine.app" "com.if.Amphetamine" \
  "$PREFS_DIR/Amphetamine.plist" "Amphetamine"

export_plist "/Applications/Descript.app" "com.descript.beachcube" \
  "$PREFS_DIR/Descript.plist" "Descript"

export_plist "/Applications/Fission.app" "com.rogueamoeba.Fission" \
  "$PREFS_DIR/Fission.plist" "Fission"

export_plist "/Applications/HandBrake.app" "fr.handbrake.HandBrake" \
  "$PREFS_DIR/HandBrake.plist" "HandBrake"

export_plist "/Applications/Helium.app" "net.imput.helium" \
  "$PREFS_DIR/Helium.plist" "Helium"

export_plist "/Applications/ScreenFlow.app" "net.telestream.screenflow10" \
  "$PREFS_DIR/ScreenFlow.plist" "ScreenFlow"

###############################################################################
# Brewfile (opt-in)                                                           #
###############################################################################

if (( OPT_BREWFILE )); then
  warn "Brewfile dump will OVERWRITE the existing Brewfile."
  warn "All manual sections, comments, and greedy: true annotations will be lost."
  printf "[snapshot] Proceed with Brewfile dump? [y/N]: "
  read -r answer </dev/tty
  if [[ "$answer" =~ ^[Yy]$ ]]; then
    if [[ -f "$REPO_ROOT/Brewfile" ]]; then
      cp "$REPO_ROOT/Brewfile" "$REPO_ROOT/Brewfile.bak"
      log "Backed up Brewfile → Brewfile.bak"
    fi
    brew bundle dump --force --file="$REPO_ROOT/Brewfile"
    # A dump on a Mac with mas installed writes `mas` entries back into the
    # Brewfile. mrk stopped tracking App Store apps on 2026-09-11
    # (docs/app-store-apps.md), and ci-check fails on such a line, so strip them.
    if grep -q '^mas[[:space:]]' "$REPO_ROOT/Brewfile"; then
      n=$(grep -c '^mas[[:space:]]' "$REPO_ROOT/Brewfile")
      stripped=$(mrk_mktemp)
      grep -v '^mas[[:space:]]' "$REPO_ROOT/Brewfile" > "$stripped" &&
        mv "$stripped" "$REPO_ROOT/Brewfile"
      warn "Dropped $n Mac App Store entr(ies) the dump added — mrk does not install them (docs/app-store-apps.md)"
    fi
    log "Brewfile updated"
  else
    log "Skipped Brewfile dump"
  fi
fi

# Local export only — assets/preferences/*.plist is gitignored, so there is
# deliberately no git detect/commit step here.
