[user]
	name = sevmorris
	email = 15384535+sevmorris@users.noreply.github.com
[credential]
	helper = osxkeychain
[alias]
	graph = log --oneline --graph --decorate
	ls = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate
	ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
	lds = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
	conflicts = diff --name-only --diff-filter=U
	local-branches = !git for-each-ref --format='%(if)%(upstream)%(then)%(else)%(refname:short)%(end)' refs/heads | sed '/^$/d'
	recent-branches = !git branch --color=always --sort=-committerdate | head
	authors = !git log --format='%aN <%aE>' | grep -v 'users.noreply.github.com' | sort -u --ignore-case	
# auto, not always: colour in a terminal and in git's pager, none in a pipe.
# Until 2026-10-04 this was always, for ui and five commands, so every pipe of
# git output carried escape codes, and local-branches, which parsed
# `git branch -vv` through cut and awk, listed branches that had an upstream.
# Audit 21, Y-1.
[color]
    ui = auto

[color "interactive"]
    error = red bold

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow
    frag = magenta
    old = red
    new = green
    whitespace = white reverse

[color "status"]
    added = yellow
    changed = green
    untracked = cyan
    branch = magenta

[core]
    excludesfile = ~/.gitignore_global
    pager = less -FRSX
    whitespace = fix,-indent-with-non-tab,trailing-space,cr-at-eol

[url "git@github.com:"]
    insteadof = github:
