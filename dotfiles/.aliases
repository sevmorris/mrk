# Load aliases only in interactive shells
[[ $- != *i* ]] && return

# ==============================================================================
#  General & System Aliases
# ==============================================================================

# Use GNU ls when coreutils gnubin is on PATH (via .zprofile), else macOS ls.
if ls --version 2>/dev/null | grep -q GNU; then
  alias ls='ls --color=auto'
  alias la='ls -lha --color=auto'
elif command -v gls &>/dev/null; then
  alias ls='gls --color=auto'
  alias la='gls -lha --color=auto'
else
  alias ls='ls -G'
  alias la='ls -lhaG'
fi

# --linenumbers is a GNU nano option. The nano macOS ships at /usr/bin/nano is
# UW PICO 5.09, whose option list has no such flag; given it, PICO does not
# error, it just treats the argument as something else. Unguarded, this alias
# was live in exactly the window where it could not work: .aliases is linked by
# `make setup` (phase 1) and GNU nano arrives with `make brew` (phase 2).
#
# Guarded the way the ls aliases eleven lines above already are — every other
# tool-dependent alias in this file was guarded, and this was the one that
# was not.
if nano --version 2>/dev/null | grep -q 'GNU nano'; then
  alias nano='nano --linenumbers'    # Always show line numbers in nano.
fi

# Optional smarter cat: use bat if available, else fallback to real cat.
# Set NO_SMART_CAT=1 to disable this behavior.
# Uses an alias instead of a function to avoid masking the cat builtin.
if [[ -z "${NO_SMART_CAT:-}" ]]; then
  if command -v bat >/dev/null 2>&1; then
    alias cat='bat -pp'
  fi
fi

command -v networkQuality >/dev/null 2>&1 && alias netcheck='networkQuality'
alias s='pmset displaysleepnow'      # Put the display to sleep immediately.

# Activate nearest Python virtualenv named .venv (searches upward)
v() {
  local d="$PWD"
  while [[ "$d" != "/" ]]; do
    if [[ -f "$d/.venv/bin/activate" ]]; then
      # shellcheck disable=SC1091
      if ! source "$d/.venv/bin/activate"; then
        echo "Failed to activate virtualenv at $d/.venv" >&2
        return 1
      fi
      return
    fi
    d="${d:h}"
  done
  echo "No .venv found in current or parent directories."
  return 1
}

# Only define if ZFS is present
command -v zfs >/dev/null 2>&1 && alias zmount='sudo zfs mount -a'

# ==============================================================================
#  Productivity & Fun Aliases
# ==============================================================================

alias shrug="printf '¯\\_(ツ)_/¯' | pbcopy"
command -v pwgen >/dev/null 2>&1 && alias pw='pwgen -s -1 19 | pbcopy' # Generate a password → clipboard.
command -v ascii-image-converter >/dev/null 2>&1 && alias art='ascii-image-converter'
alias decrypt='gpg --decrypt ' # Trailing space enables filename completion.

# ==============================================================================
#  File & Directory Management
# ==============================================================================

# Use 'se' (showempties) or 'ce' (cleanempties) functions defined below

# clean-ds moved to bin/clean-ds (linted, schedulable, supports --dry-run).

# ==============================================================================
#  Homebrew & Development Aliases / Functions
# ==============================================================================

if command -v brew >/dev/null 2>&1; then
  alias brewses='brew uses --installed'
  # Dump Brewfile to home directory
  alias dump='brew bundle dump --force --file=~/Brewfile'
fi

# Safer Homebrew permission fixer
fixbrewperms() {
  local prefix
  prefix="$(brew --prefix 2>/dev/null)" || { echo "Homebrew not found."; return 1; }
  echo "Fixing Homebrew permissions at $prefix..."
  sudo chown -R "$(whoami)":admin "$prefix"
  sudo chmod -R g+rwx "$prefix"
  brew doctor
}

if command -v topgrade >/dev/null 2>&1; then
  # Lightweight update: just run topgrade, no app closing or reboot prompt.
  # `update --full` is accepted as a spelling of `update-full`. Any other
  # arguments are passed through to topgrade instead of being silently dropped.
  update() {
    if [[ "${1:-}" == "--full" ]]; then
      shift
      update-full "$@"
      return
    fi
    topgrade "$@"
  }

  # update-full moved to bin/update-full (linted; refuses to run without a TTY).
fi

# ==============================================================================
#  Utility Functions
# ==============================================================================

# Reload the shell completely for a clean state.
c() {
  echo "Reloading shell..."
  clear && exec zsh
}

# pushit removed: it was the only helper that ran `git add .` (staging
# untracked files) with no secret scan. Use pushall, or plain git.


# --- Empty Directory Utilities ---
#
# cleanempties (ce) moves to the Trash every folder under a path that holds
# nothing but macOS cruft and other such folders; showempties (se) lists
# exactly what it would move. Everything is decided in one pass before
# anything moves.
#
# The version before 2026-09-11 (a) moved every .DS_Store, ._*, .localized,
# .gitkeep and Icon file in the whole tree to the Trash before its [y/N], so
# answering no undid nothing, and a deleted .gitkeep is a change pushall
# commits; (b) walked into .git: after `git gc` leaves refs/heads and
# refs/tags empty, it trashed them, then the emptied refs/, and git no longer
# recognised the repository — a fresh `git init` lost objects/ as well;
# (c) never finished on an empty folder the Trash refused — it discarded the
# failure and looped until nothing empty remained, 627 attempts in ten seconds
# in testing; and (d) trashed the ._ sidecar of files that still exist, which
# on a non-APFS volume is where their tags and resource fork live. Cruft now
# goes only with the folder it sits in, and only when that folder has nothing
# else.

__resolve_trash() {
  local tbin
  tbin="$(command -v trash || true)"
  [[ -z "$tbin" && -x /opt/homebrew/opt/trash/bin/trash ]] && tbin=/opt/homebrew/opt/trash/bin/trash
  [[ -z "$tbin" && -x /usr/local/opt/trash/bin/trash    ]] && tbin=/usr/local/opt/trash/bin/trash
  if [[ -z "$tbin" ]]; then
    echo "'trash' not found. Install with: brew install trash" >&2
    return 1
  fi
  echo "$tbin"
}

# __prunable TARGET — set $reply to the outermost folders under TARGET that
# hold nothing but cruft files and other such folders. Never TARGET itself.
# Never inside a .git directory, a bundle (apps, plug-ins, Logic and Final Cut
# projects, Photos and Music libraries, document packages — each keeps empty
# folders on purpose) or another volume. .gitkeep is not cruft: it is there to
# keep its folder. A folder that cannot be read counts as holding something.
__prunable() {
  emulate -L zsh
  local target=$1 d e keep i
  local -a dirs
  local -A prune
  reply=()
  # Pre-order, so walking the list backwards decides every folder after all of
  # its subfolders. Not a -depth search: macOS find ignores -prune under -depth.
  dirs=( ${(0)"$(find "$target" -xdev -mindepth 1 -type d \( -name .git \
      -o -name '*.app' -o -name '*.appex' -o -name '*.bundle' -o -name '*.framework' \
      -o -name '*.plugin' -o -name '*.kext' -o -name '*.xpc' -o -name '*.dSYM' \
      -o -name '*.component' -o -name '*.vst' -o -name '*.vst3' -o -name '*.aaxplugin' \
      -o -name '*.xcodeproj' -o -name '*.xcworkspace' -o -name '*.logicx' -o -name '*.band' \
      -o -name '*.fcpbundle' -o -name '*.photoslibrary' -o -name '*.musiclibrary' \
      -o -name '*.tvlibrary' -o -name '*.imovielibrary' -o -name '*.rtfd' \
      -o -name '*.pages' -o -name '*.numbers' -o -name '*.key' \) -prune \
      -o -type d -print0 2>/dev/null)"} )
  for (( i = ${#dirs}; i > 0; i-- )); do
    d=${dirs[i]}
    keep=0
    if [[ ! -r $d || ! -x $d ]]; then
      keep=1
    else
      for e in $d/*(DN); do
        if [[ -d $e && ! -L $e ]]; then
          (( ${+prune[$e]} )) || { keep=1; break; }
        elif [[ -f $e && ! -L $e ]] && [[ ${e:t} == (.DS_Store|.localized|Icon$'\r'|._*) ]]; then
          :
        else
          keep=1; break
        fi
      done
    fi
    (( keep )) || prune[$d]=1
  done
  for d in $dirs; do
    (( ${+prune[$d]} )) || continue
    (( ${+prune[${d:h}]} )) && continue   # its parent goes, and takes it along
    reply+=("$d")
  done
}

# Preview: exactly what cleanempties would move to the Trash. Nothing moves.
showempties() {
  emulate -L zsh
  local target=${1:-.}
  local -a reply
  __prunable "$target"
  if (( ! ${#reply} )); then
    print -r -- "Nothing under $target holds only empty folders and macOS cruft."
    return 0
  fi
  print -r -- "${#reply} folder(s) under $target hold only empty folders and macOS cruft:"
  print -rl -- $reply
}

# Clean. Use: `ce [path]`, or `ce -f [path]` to skip the question.
cleanempties() {
  emulate -L zsh
  local force="" target=${1:-.}
  if [[ $1 == -f ]]; then force=1; target=${2:-.}; fi
  if [[ ! -d $target ]]; then
    print -ru2 -- "cleanempties: not a folder: $target"
    return 1
  fi
  local trash_bin; trash_bin=$(__resolve_trash) || return 1
  local -a reply left
  local d ans
  __prunable "$target"
  if (( ! ${#reply} )); then
    print -r -- "Nothing under $target holds only empty folders and macOS cruft."
    return 0
  fi
  print -r -- "These hold only empty folders and macOS cruft (.DS_Store, ._*, .localized, Icon):"
  print -rl -- $reply
  if [[ -z $force ]]; then
    read -r "ans?Move these ${#reply} folder(s) to the Trash? [y/N] "
    [[ $ans == [Yy] ]] || { print -r -- "Cancelled. Nothing was moved."; return 0; }
  fi
  "$trash_bin" $reply 2>/dev/null
  # Checked afterwards rather than trusted: trash reports one status for the lot.
  for d in $reply; do [[ -e $d || -L $d ]] && left+=("$d"); done
  if (( ${#left} )); then
    print -ru2 -- "The Trash refused ${#left} of ${#reply}; they are still in place:"
    print -rlu2 -- $left
    return 1
  fi
  print -r -- "Moved ${#reply} folder(s) to the Trash."
}

# Short aliases
alias se='showempties'
alias ce='cleanempties'

# decloud moved to bin/decloud — a git wrapper has to work in non-interactive
# shells too, and this file returns early for those.
